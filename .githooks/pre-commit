#!/bin/sh
# Raises the patch version in src/Optimizer.App/Optimizer.App.csproj on every commit (0.3.0 -> 0.3.1).
# Enable once per clone:  git config core.hooksPath .githooks
# A version changed by hand in the same commit (for example 0.4.0) is kept.
# Skip for one commit (for example with --amend, where the amended commit already raised it):
#   SKIP_VERSION_BUMP=1 git commit --amend ...
# git runs this hook only for commits made through "git commit" (also a merge commit and a merge conflict resolved by
# hand); a merge commit is raised above both sides. git revert, git cherry-pick and git rebase (also --continue after a
# conflict) skip it and can keep or lower the version: pre-push stops such a push, and CI checks every commit pushed
# to main.
[ -n "$SKIP_VERSION_BUMP" ] && exit 0

csproj=src/Optimizer.App/Optimizer.App.csproj
current=$(sed -n 's|.*<Version>\([0-9]*\.[0-9]*\.[0-9]*\)</Version>.*|\1|p' "$csproj" | head -n 1)
if [ -z "$current" ]; then
    echo "pre-commit: no <Version>x.y.z</Version> in $csproj" >&2
    exit 1
fi

version_of() { sed -n 's|.*<Version>\([0-9]*\.[0-9]*\.[0-9]*\)</Version>.*|\1|p' | head -n 1; }
highest() { printf '%s\n' "$@" | sed '/^$/d' | sort -V | tail -n 1; }
above() { [ "$1" != "$2" ] && [ "$(highest "$1" "$2")" = "$1" ]; }

head=$(git show "HEAD:$csproj" 2>/dev/null | version_of)
# During a merge the other side may have raised the version too: the merge commit must be above both.
merge=""
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    merge=$(git show "MERGE_HEAD:$csproj" 2>/dev/null | version_of)
fi
floor=$(highest "$head" "$merge")

if [ -z "$merge" ] && git diff --cached -U0 -- "$csproj" | grep -q '^+.*<Version>'; then
    # A version set in this commit must still be above the last commit's (a lower one comes back from a partial commit
    # that staged an old csproj).
    staged=$(git show ":$csproj" | version_of)
    if [ -z "$head" ] || above "$staged" "$head"; then exit 0; fi
    echo "pre-commit: the staged version $staged is not above $head. Raise it or unstage the csproj." >&2
    exit 1
fi

# The hook stages the csproj: unstaged edits in it would end up in this commit without being chosen.
if ! git diff --quiet -- "$csproj"; then
    echo "pre-commit: $csproj has unstaged changes. Stage or stash them first." >&2
    exit 1
fi

# A merge whose result is already above both sides (a version raised by hand while resolving) is kept.
if [ -n "$merge" ]; then
    staged=$(git show ":$csproj" | version_of)
    if above "$staged" "$floor"; then exit 0; fi
fi

base=$(highest "$current" "$floor")
major=${base%%.*}
rest=${base#*.}
minor=${rest%%.*}
patch=${rest#*.}
next="$major.$minor.$((patch + 1))"

sed -i "s|<Version>$current</Version>|<Version>$next</Version>|" "$csproj"
git add "$csproj"
echo "pre-commit: version $current -> $next"
