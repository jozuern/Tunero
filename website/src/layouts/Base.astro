---
import '../styles/site.css';
import icon from '../assets/tunero-icon.svg';
import type { Copy } from '../i18n/types';
import { repo, download, version, support } from '../lib/data';

interface Props {
  t: Copy;
  title?: string;
  description?: string;
  /** Path of this page in the other language, for the language link and hreflang. */
  alternate: string;
  /** False for the 404 page: no canonical address or language versions, and search engines leave it out. */
  indexed?: boolean;
}

const { t, title = t.meta.title, description = t.meta.description, alternate, indexed = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const other = new URL(alternate, Astro.site);
const english = t.lang === 'en' ? canonical : other;
const home = t.lang === 'en' ? '/' : '/de/';
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {indexed ? (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang={t.lang} href={canonical} />
        <link rel="alternate" hreflang={t.lang === 'en' ? 'de' : 'en'} href={other} />
        <link rel="alternate" hreflang="x-default" href={english} />
      </>
    ) : <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f3f3f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#202020" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:locale" content={t.lang === 'en' ? 'en_US' : 'de_DE'} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={home}>
          <img src={icon.src} alt="" width="28" height="28" />
          <span>Tunero</span>
        </a>
        <nav aria-label={t.nav.label}>
          <a class="wide" href={download}>{t.nav.download}</a>
          <a class="wide" href={repo}>{t.nav.source}</a>
          <a href={`${home}#faq`}>{t.nav.questions}</a>
          <a href={`${home}#support`}>{t.nav.support}</a>
          <a href={alternate} hreflang={t.lang === 'en' ? 'de' : 'en'} lang={t.lang === 'en' ? 'de' : 'en'}>{t.nav.other}</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p class="footer-brand"><img src={icon.src} alt="" width="20" height="20" />{t.footer.license(version)}</p>
        <nav aria-label={t.footer.label}>
          <a href={`${repo}/releases`}>{t.footer.links.releases}</a>
          <a href={`${repo}/blob/main/CHANGELOG.md`}>{t.footer.links.changelog}</a>
          <a href={repo}>{t.footer.links.source}</a>
          <a href={support.kofi}>{t.footer.links.kofi}</a>
          <a href={support.sponsors}>{t.footer.links.sponsors}</a>
          <a href={t.footer.privacyHref}>{t.footer.links.privacy}</a>
          <a href={t.footer.imprintHref}>{t.footer.links.imprint}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
