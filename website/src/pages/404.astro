---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/index.ts';

const en = t('en');
const de = t('de');
---

<Base lang="en" title={`${en.notFound.title}, Tunero`} description={en.meta.description} path="/404/" indexed={false}>
  <main id="main">
    <h1>{en.notFound.title}</h1>
    <p>{en.notFound.body} <a href="/">{en.notFound.home}</a></p>
    <p lang="de">{de.notFound.body} <a href="/de/">{de.notFound.home}</a></p>
  </main>
</Base>
