---
// A screenshot of the app as a Windows 11 window, always the dark one (owner, 2026-10-21: light mode is a live option
// of the app and the site, never of static content), in the page's language when it exists. Files are
// src/assets/screens/site-{name}-dark-{en|de}.png (rendered with --screenshot --theme Dark); a missing language falls
// back to the other one.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../lib/data';

interface Props {
  name: string;
  lang: Lang;
  alt: string;
  sizes: string;
  caption?: string;
  eager?: boolean;
}

const { name, lang, alt, sizes, caption, eager = false } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*.png', { eager: true });
const find = (l: string) => files[`../assets/screens/site-${name}-dark-${l}.png`]?.default;
const other: Lang = lang === 'en' ? 'de' : 'en';
const shot = find(lang) ?? find(other);
if (!shot) throw new Error(`No screenshot site-${name}-dark-*.png in src/assets/screens`);

// Never upscale: the largest variant is the screenshot's own width (1440 for --screenshot at the default size).
const widths = [...[640, 1000].filter((w) => w < shot.width), Math.min(1440, shot.width)];
const variants = async (src: ImageMetadata, format: 'avif' | 'webp') => {
  const images = await Promise.all(widths.map((width) => getImage({ src, width, format })));
  return images.map((img, i) => `${img.src} ${widths[i]}w`).join(', ');
};
const sources = [];
for (const format of ['avif', 'webp'] as const) sources.push({ srcset: await variants(shot, format), type: `image/${format}` });
const fallback = await getImage({ src: shot, width: Math.min(1440, shot.width), format: 'png' });
---

<figure class="shot">
  <picture>
    {sources.map((s) => <source srcset={s.srcset} type={s.type} sizes={sizes} />)}
    <img src={fallback.src} alt={alt} width={shot.width} height={shot.height} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} />
  </picture>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
