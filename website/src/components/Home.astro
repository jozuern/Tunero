---
import Shot from './Shot.astro';
import type { Copy } from '../i18n/types';
import { counts, version, sizeMb, explanation, registryChanges, checkTitles, topChecks, tweakImpacts, repo, download, packages, support } from '../lib/data';

interface Props { t: Copy }
const { t } = Astro.props;

// Every check the scan runs, by the title of its explanation page.
const checks = checkTitles(t.lang);

// The rating board. Only problems the scan finds reach 5, so the top row names those checks. Below it every tweak
// that can matter for games by name, once, in the row of its rating; a tweak that rates
// higher on some PCs in the row of its highest rating, with its rating elsewhere. Popular tweaks rated 0 on disputed evidence are named too; the
// rest of the 0 row is one square per tweak.
const impacts = tweakImpacts(t.lang);
type Entry = { title: string; tag?: string; note?: string };
const tagOf = (basis: string) => (basis === 'measured' ? t.impact.measured : basis === 'disputed' ? t.impact.disputed : undefined);
const top = topChecks(t.lang);
const levels = [4, 3, 2, 1].map((level) => {
  const entries: Entry[] = [
    ...impacts.filter((i) => i.impact === level && !i.higher).map((i) => ({ title: i.title, tag: tagOf(i.basis) })),
    ...impacts.filter((i) => i.higher?.impact === level).map((i) => ({ title: i.title, tag: t.impact.some(i.impact), note: i.higher!.reason })),
  ];
  return { level, entries };
});
// The board's title and text state facts the catalog decides, so the build fails when they stop being true.
if (impacts.some((i) => i.impact >= 5 || (i.higher?.impact ?? 0) >= 5))
  throw new Error('A tweak is rated 5: the board has no tweak row 5, and its title says that no tweak reaches 5');
const turbo = impacts.find((i) => i.id === 'power.turboRestore');
if (turbo?.impact !== 0 || turbo.higher?.impact !== 4)
  throw new Error('The board text says that Restore processor turbo rates 4 on some PCs and 0 everywhere else');
const zero = impacts.filter((i) => i.impact === 0 && !i.higher);
const zeroNamed = zero.filter((i) => i.basis === 'disputed');
const zeroRest = zero.filter((i) => i.basis !== 'disputed');
const matter = impacts.filter((i) => i.impact > 0 || i.higher).length;

// One tweak followed end to end: its explanation page straight from the app's catalog, with the registry values it
// writes where the app puts them, after the summary. The Tweaks screenshot shows the same tweak selected.
const specimen = 'input.mouseAccelOff';
const doc = explanation(specimen, t.lang);
const docSections = t.tweak.show.map((heading) => {
  const section = doc.sections.find((s) => s.heading === heading);
  if (!section) throw new Error(`The page ${specimen} (${t.lang}) has no section ${heading}`);
  return section;
});
const specimenImpact = impacts.find((i) => i.id === specimen)!.impact;
// Splits "text [1] text" so the references can link to the numbered sources.
// The space before a reference goes, so the number sits on the word.
const withRefs = (text: string) => text.split(/\s*\[(\d+)\]/).map((part, i) => ({ ref: i % 2 === 1, part }));
// A source as its host and, muted, the rest of the address.
const source = (url: string) => {
  const u = new URL(url);
  return { host: u.host.replace(/^www\./, ''), path: (u.pathname + u.search).replace(/\/$/, '') };
};

// A popular tweak whose own page says the evidence does not hold up, quoted under the sheet.
const disputedId = 'power.ultimatePlan';
if (impacts.find((i) => i.id === disputedId)?.basis !== 'disputed')
  throw new Error(`The site quotes ${disputedId} as a tweak with disputed evidence`);
const disputedDoc = explanation(disputedId, t.lang);
const disputedEvidence = disputedDoc.sections.findIndex((s) => s.heading === t.tweak.show[2]);
if (disputedEvidence < 0) throw new Error(`The page ${disputedId} (${t.lang}) has no section ${t.tweak.show[2]}`);
const disputedQuote = disputedDoc.sections[disputedEvidence].body;
const disputedHref = `${repo}/blob/main/src/Optimizer.Core/Catalog/Docs/${t.lang}/${disputedId}.md`;

// The hero claim: a hyphenated word such as "PC-Optimierer" stays on one line.
const titleParts = t.hero.title.split(/(\S+-\S+)/).map((part, i) => ({ keep: i % 2 === 1, part }));

// What the tweak writes; the Windows defaults are the Now column.
const mouse = registryChanges(specimen, { MouseSpeed: '1', MouseThreshold1: '6', MouseThreshold2: '10' });

const faqSmartScreen = t.faq.items[1].id;
const docsBase = `${repo}/blob/main/docs`;
const managers = [
  { name: 'winget', ...packages.winget },
  { name: 'Chocolatey', ...packages.choco },
  { name: 'Scoop', ...packages.scoop },
].filter((m) => m.live);
---

<section class="hero container" aria-labelledby="title">
  <h1 id="title">{titleParts.map((x) => (x.keep ? <span class="nowrap">{x.part}</span> : x.part))}</h1>
  <div class="hero-text">
    <p class="lead">{t.hero.lead}</p>
    <div class="get">
      <div class="actions">
        <a class="button" href={download}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 1.5a.75.75 0 0 1 .75.75v7.19l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 0 1 1.06-1.06l2.22 2.22V2.25A.75.75 0 0 1 8 1.5ZM2.75 13h10.5a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1 0-1.5Z" /></svg>
          {t.hero.download}
          {sizeMb && <span class="size">{sizeMb} MB</span>}
        </a>
        {packages.winget.live && (
          <span class="command">
            {t.hero.winget}
            <code><span id="winget">{packages.winget.commands[0]}</span><button class="copy" type="button" data-copy="winget" data-done={t.hero.copied} hidden>{t.hero.copy}</button></code>
          </span>
        )}
      </div>
      <p class="started" id="started" role="status" hidden>{t.hero.started} <a href={`#${faqSmartScreen}`}>{t.hero.startedLink}</a></p>
      <p class="fine">{t.hero.facts(version)} <a href={`${repo}/blob/main/CHANGELOG.md`}>{t.hero.changes}</a></p>
      <p class="fine">{t.hero.preview} <a href={`#${faqSmartScreen}`}>{t.hero.previewLink}</a></p>
    </div>
  </div>
  <Shot name="overview" lang={t.lang} alt={t.hero.shotAlt} caption={t.hero.shotCaption} sizes="(min-width: 1208px) 1160px, calc(100vw - 32px)" eager />
</section>

<section class="board" aria-labelledby="impact">
  <div class="container">
    <div class="intro">
      <h2 id="impact">{t.impact.title}</h2>
      <div>{t.impact.body(impacts.length, matter).map((p) => <p>{p}</p>)}</div>
    </div>
    <div class="ratings">
      <div class="rating top">
        <span class="level" aria-hidden="true">5</span>
        <div>
          <h3 class="sr">{t.impact.topRow(top.length)}</h3>
          <p class="top-note">{t.impact.top}</p>
          <ul class="names">
            {top.map((c) => <li>{c}</li>)}
          </ul>
        </div>
      </div>
      {levels.map((l) => (
        <div class="rating">
          <span class="level" aria-hidden="true">{l.level}</span>
          <div>
            <h3 class="sr">{t.impact.row(l.level, l.entries.length)}</h3>
            <ul class="names">
              {l.entries.map((e) => (
                <li title={e.note}>{e.title}{e.tag && <span class="tag">{e.tag}</span>}{e.note && <span class="sr">: {e.note}</span>}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
      <div class="rating zero">
        <span class="level" aria-hidden="true">0</span>
        <div>
          <h3 class="sr">{t.impact.row(0, zero.length)}</h3>
          <p class="zero-note">{t.impact.zeroNamed}</p>
          <ul class="names">
            {zeroNamed.map((i) => <li>{i.title}</li>)}
          </ul>
          <p class="zero-note">{t.impact.zeroRest(zeroRest.length)}</p>
          <div class="cells" aria-hidden="true">
            {zeroRest.map((i) => <i title={i.title}></i>)}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section container scan" aria-labelledby="scan">
  <div class="scan-text">
    <h2 id="scan">{t.scan.title}</h2>
    {t.scan.body(counts.checks).map((p) => <p>{p}</p>)}
  </div>
  <div>
    <h3 class="sr">{t.scan.list(checks.length)}</h3>
    <ol class="runon">
      {checks.map((c) => <li>{c}</li>)}
    </ol>
  </div>
</section>

<section class="section container" aria-labelledby="areas">
  <h2 id="areas">{t.areas.title}</h2>
  <p>{t.areas.intro}</p>
  <div class="rail">
    {t.areas.groups(counts).map((g) => (
      <div class="rail-group">
        {g.name && <h3>{g.name}</h3>}
        <dl>
          {g.items.map(([name, text]) => <div><dt>{name}</dt><dd>{text}</dd></div>)}
        </dl>
      </div>
    ))}
  </div>
</section>

<section class="section container" aria-labelledby="tweak">
  <h2 id="tweak">{t.tweak.title}</h2>
  <p>{t.tweak.intro}</p>
  <article class="doc" aria-labelledby="doc-title">
    <div class="doc-main">
      <p class="doc-label">{t.tweak.docLabel}</p>
      <h3 id="doc-title">{doc.title}</h3>
      <p class="doc-impact">{t.tweak.impact(specimenImpact)}</p>
      {docSections.map((s, i) => (
        <>
          <h4>{s.heading}</h4>
          <p>
            {withRefs(s.body).map((x) => (x.ref ? <sup><a href={`#src-${x.part}`}>{x.part}</a></sup> : x.part))}
          </p>
          {i === 0 && (
            <>
              <h4>{t.tweak.changes}</h4>
              <table class="diff">
                <caption>{t.tweak.caption}</caption>
                <thead>
                  <tr><th scope="colgroup" colspan="3" class="key">{mouse[0].key}</th></tr>
                  <tr>{t.tweak.columns.map((c) => <th scope="col">{c}</th>)}</tr>
                </thead>
                <tbody>
                  {mouse.map((r) => (
                    <tr><td>{r.name}</td><td class="now"><del>{r.from}</del></td><td class="new"><ins>{r.to}</ins></td></tr>
                  ))}
                </tbody>
              </table>
            </>
          )}
        </>
      ))}
    </div>
    <aside class="doc-notes">
      <h4>{t.tweak.sourcesLabel}</h4>
      <ol>{doc.sources.map((url, i) => <li id={`src-${i + 1}`}><a href={url}><span class="host">{source(url).host}</span>{source(url).path}</a></li>)}</ol>
    </aside>
  </article>
  <figure class="counter">
    <figcaption>{t.tweak.disputed.intro(disputedDoc.title)}</figcaption>
    <blockquote cite={disputedHref}><p>{disputedQuote}</p></blockquote>
    <p><a href={disputedHref}>{t.tweak.disputed.link}</a></p>
  </figure>
  <h3 class="small-head">{t.tweak.stepsTitle}</h3>
  <ol class="sequence across">
    {t.tweak.steps.map((s) => <li><b>{s.name}</b><span>{s.text}</span></li>)}
  </ol>
  <div class="tweak-after">
    {t.tweak.body.map((p) => <p>{p}</p>)}
  </div>
  <Shot name="tweaks" lang={t.lang} alt={t.tweak.shotAlt} caption={t.tweak.shotCaption} sizes="(min-width: 1208px) 1160px, calc(100vw - 32px)" />
</section>

<section class="section container" aria-labelledby="left">
  <h2 id="left">{t.left.title}</h2>
  <p>{t.left.intro}</p>
  <ul class="struck">
    {t.left.rows.map((r) => (
      <li>
        <s class={r.tweak.includes('=') ? 'mono' : undefined}>{r.tweak}</s>
        <p>{r.why}{r.source && <> <a href={r.source}>{t.left.sourceLink}</a></>}</p>
      </li>
    ))}
  </ul>
  <p><a href={`${docsBase}/not-included.md`}>{t.left.all}</a></p>
</section>

<div class="reference container">
  <section class="ref-row" aria-labelledby="privacy">
    <h2 id="privacy">{t.privacy.title}</h2>
    <div>
      {t.privacy.body.map((p) => <p>{p}</p>)}
      <p><a href={`${docsBase}/PRIVACY.md${t.lang === 'de' ? '#datenschutz' : ''}`}>{t.privacy.link}</a></p>
    </div>
  </section>

  <section class="ref-row" aria-labelledby="install">
    <h2 id="install">{t.install.title}</h2>
    <div>
      <ol class="sequence">
        <li>
          <b>{t.install.steps[0].name}</b><span>{t.install.steps[0].text}</span>
          <a class="button" href={download}>{t.hero.download}{sizeMb && <span class="size">{sizeMb} MB</span>}</a>
          <p class="started" role="status" hidden>{t.hero.started} <a href={`#${faqSmartScreen}`}>{t.hero.startedLink}</a></p>
        </li>
        <li>
          <b>{t.install.steps[1].name}</b><span>{t.install.steps[1].text}</span>
          <pre><code>Get-FileHash Tunero.exe</code></pre>
        </li>
        <li><b>{t.install.steps[2].name}</b><span>{t.install.steps[2].text}</span></li>
      </ol>
      {managers.length > 0 && (
        <>
          <h3 class="small-head">{t.install.managers}</h3>
          <dl class="install-list">
            {managers.map((m) => <div><dt>{m.name}</dt><dd>{m.commands.map((c) => <code>{c}</code>)}</dd></div>)}
          </dl>
        </>
      )}
      <p class="after-list"><a href={`${repo}/releases`}>{t.install.releases}</a></p>
    </div>
  </section>

  <section class="ref-row" aria-labelledby="support">
    <h2 id="support">{t.support.title}</h2>
    <div>
      {t.support.body.map((p) => <p>{p}</p>)}
      <p class="actions support-actions">
        <a class="button" href={support.kofi}>{t.support.kofi}</a>
        <a class="button standard" href={support.sponsors}>{t.support.sponsors}</a>
      </p>
      <p class="fine">{t.support.note}</p>
    </div>
  </section>

  <section class="ref-row" aria-labelledby="faq">
    <h2 id="faq">{t.faq.title}</h2>
    <dl class="faq">
      {t.faq.items.map((f) => <div><dt id={f.id}>{f.q}</dt><dd>{f.a}</dd></div>)}
    </dl>
  </section>
</div>

<script>
  // A click on a download link shows where to read about the SmartScreen warning, since nobody scrolls down to the
  // questions on their own: under the button that was clicked, or under the hero's for the header link.
  const started = document.getElementById('started')!;
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[href$="/Tunero.exe"]')) {
    link.addEventListener('click', () => {
      (link.closest('li, .get')?.querySelector<HTMLElement>('.started') ?? started).hidden = false;
    });
  }

  // Copy the winget command. The button stays hidden without script or clipboard access.
  for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
    if (!navigator.clipboard) continue;
    button.hidden = false;
    const label = button.textContent;
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(document.getElementById(button.dataset.copy!)!.textContent!);
      button.textContent = button.dataset.done!;
      setTimeout(() => (button.textContent = label), 2000);
    });
  }
</script>
