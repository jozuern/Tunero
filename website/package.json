{
  "name": "tunero-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && astro build",
    "preview": "astro preview",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "render:wallpaper": "node scripts/render-wallpaper.mjs"
  },
  "dependencies": {
    "@astrojs/svelte": "9.1.1",
    "astro": "7.4.2",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@fluentui/svg-icons": "1.1.344",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3"
  }
}
