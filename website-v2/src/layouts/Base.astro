---
import '../styles/tokens.css';
import { t, localPath, type Lang } from '../i18n/index.ts';
import { phoneQuery } from '../lib/phone.ts';
import { download, operator } from '../lib/repo.ts';
import { storageKeys as keys } from '../lib/storage-keys.ts';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** The English path of this page ("/", "/classic/"); the German one is /de in front. */
  path: string;
  /** False for the 404 page: no canonical address or language versions, and search engines leave it out. */
  indexed?: boolean;
  /** Where "Skip to classic page" leads; the classic page itself skips to its own content. */
  skipTo?: string;
  /** The German path when it is not /de in front of the English one (v1's /de/datenschutz/ and /de/impressum/). */
  germanPath?: string;
  /**
   * Where phones go instead of this page: the demo PC is not offered on phones. Search engines learn it from a
   * rel=alternate link for the same media query (Google's setup for a separate mobile page).
   */
  phoneTo?: string;
  /**
   * On the phone version of another page (the classic page of the home page): that page's English path. Its address is
   * the canonical one, so search engines index the home page, with this page's text, as one page.
   */
  phoneOf?: string;
  /** On the pages about the app (home and classic): its facts for search engines, as schema.org SoftwareApplication. */
  software?: { version: string };
}

const { lang, title, description, path, indexed = true, skipTo, germanPath, phoneTo, phoneOf, software } = Astro.props;
const copy = t(lang);
const english = new URL(path, Astro.site);
const german = new URL(germanPath ?? localPath('de', path), Astro.site);
const canonical = phoneOf ? new URL(localPath(lang, phoneOf), Astro.site) : lang === 'de' ? german : english;
// Only facts the site states anyway: no ratings or reviews. "<" is escaped so the JSON cannot end the script element.
const structured = software && JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Tunero',
  description,
  url: canonical.href,
  inLanguage: lang,
  operatingSystem: 'Windows 11',
  applicationCategory: 'UtilitiesApplication',
  softwareVersion: software.version,
  downloadUrl: download,
  image: new URL('/og.png', Astro.site).href,
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  author: { '@type': 'Person', name: operator.name },
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {phoneTo && (
      <script is:inline define:vars={{ phoneTo, phoneQuery }}>
        // Phones get the classic page before anything paints; the hash (a search result's #faq) goes along.
        if (matchMedia(phoneQuery).matches) location.replace(phoneTo + location.hash);
      </script>
    )}
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline define:vars={{ keys }}>
      // The theme before first paint: the visitor's choice in Settings, else the system's.
      (() => {
        let theme = null;
        try { theme = localStorage.getItem(keys.theme); } catch {}
        if (theme !== 'light' && theme !== 'dark') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        // Animation: on unless the visitor turned it off in the demo's Settings (desktop/motion.ts).
        let motion = null;
        try { motion = localStorage.getItem(keys.motion); } catch {}
        const reduce = motion === 'off';
        document.documentElement.dataset.motion = reduce ? 'reduce' : 'full';
      })();
    </script>
    {indexed ? (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="en" href={english} />
        <link rel="alternate" hreflang="de" href={german} />
        <link rel="alternate" hreflang="x-default" href={english} />
        {phoneTo && <link rel="alternate" media={phoneQuery} href={new URL(phoneTo, Astro.site)} />}
      </>
    ) : <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f3f3f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#202020" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'de_DE'} />
    <meta name="twitter:card" content="summary_large_image" />
    {structured && <script type="application/ld+json" set:html={structured} />}
  </head>
  <body>
    <a class="skip" href={skipTo ?? localPath(lang, '/classic/')}>{skipTo ? copy.skipContent : copy.skip}</a>
    <slot />
  </body>
</html>
