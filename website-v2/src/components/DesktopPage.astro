---
// The home page in either language: the demo desktop, with the facts it needs read at build time.
import Base from '../layouts/Base.astro';
import Desktop from '../desktop/Desktop.svelte';
import { t, localPath, type Lang } from '../i18n/index.ts';
import desktopEn from '../i18n/desktop-en.ts';
import desktopDe from '../i18n/desktop-de.ts';
import { buildDemo } from '../lib/demo.ts';
import { appString, changelog, counts, download, repo } from '../lib/repo.ts';
import { appKeys, type AppStrings } from '../desktop/app/appKeys.ts';
import { latestRelease } from '../lib/release.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang);
const release = await latestRelease();
const app = Object.fromEntries(appKeys.map((key) => [key, appString(key, lang)])) as AppStrings;
const extras = {
  trust: { intro: copy.trust.intro, items: copy.trust.items },
  changelog: { entries: changelog(3), href: `${repo}/blob/main/CHANGELOG.md` },
  links: {
    download,
    faq: `${localPath(lang, '/classic/')}#faq`,
    privacy: lang === 'de' ? '/de/datenschutz/' : '/privacy/',
  },
};
const facts = {
  checkCount: counts.checks,
  tweakCount: counts.tweaks,
  version: release.version,
  download,
  classicHref: localPath(lang, '/classic/'),
  otherHref: localPath(lang === 'en' ? 'de' : 'en', '/'),
};
---

<Base lang={lang} title={copy.meta.title} description={copy.meta.description} path="/">
  <main>
    <h1 class="visually-hidden">{copy.meta.title}</h1>
    <script is:inline>
      // Before the desktop paints: on the first visit of a session, keep it hidden for the boot (Boot.svelte ends it).
      (() => {
        let seen = false;
        try { seen = JSON.parse(sessionStorage.getItem('tunero-demo') || '{}').bootSeen === true; } catch {}
        if (!seen && document.documentElement.dataset.motion !== 'reduce') document.documentElement.dataset.boot = 'pending';
      })();
    </script>
    <Desktop client:load demo={buildDemo(lang)} copy={lang === 'de' ? desktopDe : desktopEn} lang={lang} facts={facts} app={app} {...extras} />
  </main>
</Base>
