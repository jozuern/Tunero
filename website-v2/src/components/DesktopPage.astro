---
// The home page in either language: the demo desktop. Its island imports what it shows (lib/desktop-data.ts) from a
// cached module; the page passes only what changes with each build (the facts).
import Base from '../layouts/Base.astro';
import DesktopEn from '../desktop/DesktopEn.svelte';
import DesktopDe from '../desktop/DesktopDe.svelte';
import { t, localPath, type Lang } from '../i18n/index.ts';
import { counts, download } from '../lib/repo.ts';
import { latestRelease } from '../lib/release.ts';
import { storageKeys } from '../lib/storage-keys.ts';
import type { Facts } from '../desktop/Desktop.svelte';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang);
const release = await latestRelease();
const facts: Facts = {
  checkCount: counts.checks,
  tweakCount: counts.tweaks,
  version: release.version,
  download,
  classicHref: localPath(lang, '/classic/'),
  otherHref: localPath(lang === 'en' ? 'de' : 'en', '/'),
};
---

<Base lang={lang} title={copy.meta.title} description={copy.meta.description} path="/" phoneTo={localPath(lang, '/classic/')} software={{ version: release.version }}>
  <main>
    <h1 class="visually-hidden">{copy.meta.title}</h1>
    <noscript>
      <p class="noscript">{copy.noscript} <a href={localPath(lang, '/classic/')}>{copy.skip}</a></p>
    </noscript>
    <script is:inline define:vars={{ demoKey: storageKeys.demo }}>
      // Before the desktop paints: on the first visit of a session, keep it hidden for the boot (Boot.svelte ends it).
      // On a later one with changes or a window saved, keep what shows them hidden until the desktop has restored them
      // (tokens.css), so the visitor does not see the untouched PC of the page's HTML first.
      (() => {
        let saved = {};
        try { saved = JSON.parse(sessionStorage.getItem(demoKey) || '{}') || {}; } catch {}
        if (saved.bootSeen !== true && document.documentElement.dataset.motion !== 'reduce') document.documentElement.dataset.boot = 'pending';
        else if ((Array.isArray(saved.applied) && saved.applied.length > 0) || saved.window) document.documentElement.dataset.restoring = '';
      })();
    </script>
    {lang === 'de' ? <DesktopDe client:load facts={facts} /> : <DesktopEn client:load facts={facts} />}
  </main>
</Base>
