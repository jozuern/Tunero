---
// The privacy policy of the website (the app's own is docs/PRIVACY.md), ported from v1.
import Page from './Page.astro';
import RichText from './RichText.astro';
import { t, type Lang } from '../../i18n/index.ts';
import { operator } from '../../lib/repo.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang);
const text = copy.privacy;
---

<Page lang={lang} title={text.metaTitle} description={text.description} path="/privacy/" germanPath="/de/datenschutz/">
  <article class="legal">
    <h1>{text.title}</h1>
    <p><RichText parts={text.intro} /></p>

    <h2>{text.controller}</h2>
    <address>
      {operator.name}, {operator.street}, {operator.city}, {operator.country[lang]}<br />
      {text.email}: <a href={`mailto:${operator.email}`}>{operator.email}</a>
    </address>

    {text.sections(operator.email).map((section) => (
      <>
        <h2>{section.heading}</h2>
        {section.paragraphs.map((paragraph) => <p><RichText parts={paragraph} /></p>)}
      </>
    ))}
  </article>
</Page>
