      "scope": "user",
      "actions": [
        {
          "type": "registry",
          "hive": "user",
          "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
          "name": "AppsUseLightTheme",
          "kind": "dword",
          "value": 0,
          "notify": "settings"
        },
        {
          "type": "registry",
          "hive": "user",
          "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
