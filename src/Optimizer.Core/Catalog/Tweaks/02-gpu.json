{
  "tweaks": [
    {
      "id": "gpu.hags",
      "undocumented": true,
      "proof": [
        "winaero.com (Turn On or Off Hardware Accelerated GPU Scheduling): HwSchMode 2 turns the Settings switch on and 1 turns it off",
        "itechtics.com (Hardware-accelerated GPU scheduling): HwSchMode 2 turns it on after a restart and 1 turns it off again"
      ],
      "category": "Graphics",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "impactOverrides": [
        {
          "when": {
            "fact": "gpu.supportsFrameGeneration",
            "eq": true
          },
          "gaming": 3,
          "effect": [
            "fps"
          ],
          "reasonKey": "impact.hagsFrameGen"
        }
      ],
      "risk": "safe",
      "restart": true,
      "verify": "afterRestart",
      "appliesTo": {
        "when": {
          "fact": "gpu.supportsHags",
          "eq": true
        }
      },
      "actions": [
        {
          "type": "registry",
          "hive": "machine",
          "path": "SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers",
          "name": "HwSchMode",
          "kind": "dword",
          "value": 2
        }
      ],
      "recommendWhen": {
        "fact": "gpu.supportsFrameGeneration",
        "eq": true
      },
      "sources": [
        "https://devblogs.microsoft.com/directx/hardware-accelerated-gpu-scheduling/",
        "https://github.com/NVIDIA-RTX/Streamline/blob/main/docs/ProgrammingGuideDLSS_G.md",
        "https://www.intel.com/content/www/us/en/support/articles/000056788/graphics.html",
        "https://winaero.com/turn-on-or-off-hardware-accelerated-gpu-scheduling-in-windows-10/",
        "https://itechtics.com/hardware-accelerated-gpu/"
      ],
      "recommendReasonKey": "rec.frameGeneration"
    },
    {
      "id": "gpu.windowedOptimizations",
      "undocumented": true,
      "proof": [
        "elevenforum.com tutorial 4943: SwapEffectUpgradeEnable=1 in DirectXUserGlobalSettings turns \"Optimizations for windowed games\" on, shown with screenshots",
        "thewindowsclub.com (Enable Optimizations for windowed games): the same value turns the feature on after a restart"
      ],
      "category": "Graphics",
      "impact": {
        "gaming": 1,
        "basis": "situational",
        "effect": [
          "latency"
        ]
      },
      "risk": "safe",
      "scope": "user",
      "appliesTo": {
        "when": {
          "fact": "gpu.hasDiscrete",
          "eq": true
        }
      },
      "actions": [
        {
          "type": "registryToken",
          "hive": "user",
          "path": "Software\\Microsoft\\DirectX\\UserGpuPreferences",
          "name": "DirectXUserGlobalSettings",
          "token": "SwapEffectUpgradeEnable",
          "value": "1"
        }
      ],
      "recommendWhen": {
        "all": [
          {
            "fact": "gpu.hasDiscrete",
            "eq": true
          },
          {
            "fact": "display.autoHdr",
            "eq": false
          }
        ]
      },
      "sources": [
        "https://devblogs.microsoft.com/directx/updates-in-graphics-and-gaming/",
        "https://support.microsoft.com/en-us/topic/3f006843-2c7e-4ed0-9a5e-f9389e535952",
        "https://www.elevenforum.com/t/turn-on-or-off-optimizations-for-windowed-games-in-windows-11.4943/",
        "https://www.thewindowsclub.com/enable-optimizations-for-windowed-games-in-windows"
      ],
      "recommendReasonKey": "rec.windowedFlip"
    },
    {
      "id": "gpu.gameMode",
      "undocumented": true,
      "proof": [ "docs/vm-test-results-2026-10-10.md in git 60c3a93^: a clean Windows 11 26H2 already holds both values, so they are the ones Windows itself uses for Game Mode on", "docs/vm-test-results-2026-10-11.md in git 60c3a93^: with Game Mode turned off in Settings, Settings showed Game Mode On after apply and Off again after undo" ],
      "category": "Graphics",
      "impact": {
        "gaming": 1,
        "basis": "situational",
        "effect": [
          "stutter"
        ]
      },
      "impactOverrides": [
        { "when": { "fact": "cpu.x3dMultiCcd", "eq": true }, "gaming": 3, "effect": [ "fps", "lows" ], "reasonKey": "impact.x3dGameMode" }
      ],
      "risk": "safe",
      "scope": "user",
      "actions": [
        {
          "type": "registry",
          "hive": "user",
          "path": "Software\\Microsoft\\GameBar",
          "name": "AutoGameModeEnabled",
          "kind": "dword",
          "value": 1,
          "missingMeans": 1
        },
        {
          "type": "registry",
          "hive": "user",
          "path": "Software\\Microsoft\\GameBar",
          "name": "AllowAutoGameMode",
          "kind": "dword",
          "value": 1,
          "missingMeans": 1
        }
      ],
      "recommendWhen": {
        "fact": "os.build",
        "gte": 26100
      },
      "sources": [
        "https://news.xbox.com/en-us/2018/10/02/latest-october-2018-windows-update-gaming-features-3/",
        "https://learn.microsoft.com/en-us/previous-versions/windows/desktop/gamemode/game-mode-portal"
      ],
      "recommendReasonKey": "rec.gameModeOff"
    },
    {
