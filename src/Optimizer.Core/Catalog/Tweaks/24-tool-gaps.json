    {
      "id": "system.bsodDetails",
      "undocumented": true,
      "proof": [
        "VM test 2026-10-11 (Windows 11 build 26300): a stop error forced through a Hyper-V NMI showed the four bug check parameters at the top left of the stop screen with the value, and no parameters after undo"
      ],
      "category": "System",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "safe",
      "restart": true,
      "actions": [
        {
          "type": "registry",
          "hive": "machine",
          "path": "SYSTEM\\CurrentControlSet\\Control\\CrashControl",
          "name": "DisplayParameters",
          "kind": "dword",
          "value": 1
        }
      ],
      "sources": [
        "https://winaero.com/show-bsod-details-instead-of-the-sad-smiley-in-windows-10/"
      ]
