    {
      "id": "gpu.gameBarControllerOff",
      "undocumented": true,
      "proof": [
        "VM test 2026-10-11 (Windows 11 build 26300): Settings > Gaming > Game Bar showed \"Allow your controller to open Game Bar\" Off after apply and On after undo"
      ],
      "category": "Input",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "safe",
      "scope": "user",
      "actions": [
        {
          "type": "registry",
          "hive": "user",
          "path": "Software\\Microsoft\\GameBar",
          "name": "UseNexusForGameBarEnabled",
          "kind": "dword",
          "value": 0,
          "notify": "settings"
        }
      ],
      "sources": [
        "https://github.com/Raphire/Win11Debloat/blob/master/Regfiles/Disable_Game_Bar_Integration.reg"
      ]
