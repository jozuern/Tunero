{
  "tweaks": [
    {
      "id": "gpu.gameDvrPolicyOff",
      "category": "Graphics",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "impactOverrides": [
        {
          "when": {
            "fact": "gamedvr.backgroundRecording",
            "eq": true
          },
          "gaming": 1,
          "effect": [
            "stutter"
          ],
          "reasonKey": "impact.backgroundRecording"
        }
      ],
      "risk": "safe",
      "appliesTo": {
        "when": {
          "not": {
            "fact": "os.edition",
            "in": [
              "Core",
              "CoreN",
              "CoreSingleLanguage",
              "CoreCountrySpecific"
            ]
          }
        }
      },
      "actions": [
        {
          "type": "registry",
          "hive": "machine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\GameDVR",
          "name": "AllowGameDVR",
          "kind": "dword",
          "value": 0
        }
      ],
      "recommendWhen": {
        "fact": "gamedvr.backgroundRecording",
        "eq": true
      },
      "sources": [
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-applicationmanagement"
      ],
      "recommendReasonKey": "rec.backgroundRecording"
    },
    {
