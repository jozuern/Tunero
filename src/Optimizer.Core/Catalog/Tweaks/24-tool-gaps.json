    {
      "id": "visual.wallpaperFullQuality",
      "undocumented": true,
      "proof": [
        "VM test 2026-10-11 (Windows 11 build 26300): after sign-in, a newly set quality 100 JPEG wallpaper was stored in TranscodedWallpaper with quantization tables of quality 100 (all 1); without the value and after sign-in, a new one was stored at about quality 85 (5,3,4)"
      ],
      "category": "Visual",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "safe",
      "scope": "user",
      "actions": [
        {
          "type": "registry",
          "hive": "user",
          "path": "Control Panel\\Desktop",
          "name": "JPEGImportQuality",
          "kind": "dword",
          "value": 100
        }
      ],
      "sources": [
        "https://winaero.com/how-to-disable-wallpaper-jpeg-quality-reduction-in-windows-10"
      ],
      "signOut": true
    },
    {
      "id": "personalize.settingsHomeHidden",
      "category": "Personalize",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "safe",
      "appliesTo": {
        "when": {
          "not": {
            "fact": "os.edition",
            "in": [
              "Core",
              "CoreN",
              "CoreSingleLanguage",
              "CoreCountrySpecific"
            ]
          }
        }
      },
      "actions": [
