    {
      "id": "office.clipboardHistoryOn",
      "category": "Productivity",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "safe",
      "scope": "user",
      "conflictsWith": [
        "privacy.clipboardHistoryOff"
      ],
      "actions": [
        {
          "type": "registry",
          "hive": "user",
          "path": "Software\\Microsoft\\Clipboard",
          "name": "EnableClipboardHistory",
          "kind": "dword",
          "value": 1,
          "missingMeans": 0
        }
      ],
      "sources": [
        "https://support.microsoft.com/en-us/windows/clipboard-in-windows-c436501e-985d-1c8d-97ea-fe46ddf338c6",
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-experience"
      ]
    },
    {
      "id": "office.launchToThisPc",
