      "proof": [ "docs/vm-test-results-2026-10-10.md in git 60c3a93^: Preview review: a new File Explorer window opened on \"This PC\" after apply and on \"Home\" again after undo" ],
      "category": "Productivity",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "safe",
      "scope": "user",
      "actions": [
        {
          "type": "registry",
          "hive": "user",
          "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "name": "LaunchTo",
          "kind": "dword",
          "value": 1
        }
      ],
      "sources": [
        "https://www.winhelponline.com/blog/open-file-explorer-downloads-folder-default-windows-10/"
      ]
    },
