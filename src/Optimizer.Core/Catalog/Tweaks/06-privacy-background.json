{
  "_comment": "Several entries are derived from Chris Titus Tech WinUtil (MIT); see docs/THIRD-PARTY-NOTICES.md.",
  "tweaks": [
    {
      "id": "privacy.telemetryOff",
      "category": "Privacy",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "moderate",
      "restart": true,
      "actions": [
        {
          "type": "registry",
          "hive": "machine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
          "name": "AllowTelemetry",
          "kind": "dword",
          "value": 0
        },
        {
          "type": "service",
          "name": "DiagTrack",
          "startType": "disabled"
        },
        {
          "type": "scheduledTask",
          "path": "\\Microsoft\\Windows\\Application Experience\\Microsoft Compatibility Appraiser",
          "enabled": false
        },
        {
          "type": "scheduledTask",
          "path": "\\Microsoft\\Windows\\Application Experience\\Microsoft Compatibility Appraiser Exp",
          "enabled": false
        },
        {
          "type": "scheduledTask",
          "path": "\\Microsoft\\Windows\\Application Experience\\ProgramDataUpdater",
          "enabled": false
        },
        {
          "type": "scheduledTask",
          "path": "\\Microsoft\\Windows\\Customer Experience Improvement Program\\Consolidator",
          "enabled": false
        },
        {
          "type": "scheduledTask",
          "path": "\\Microsoft\\Windows\\Customer Experience Improvement Program\\UsbCeip",
          "enabled": false
        },
        {
          "type": "scheduledTask",
          "path": "\\Microsoft\\Windows\\Autochk\\Proxy",
          "enabled": false
        },
        {
          "type": "scheduledTask",
          "path": "\\Microsoft\\Windows\\DiskDiagnostic\\Microsoft-Windows-DiskDiagnosticDataCollector",
          "enabled": false
        }
      ],
      "blockedWhen": [
        {
          "fact": "os.insider",
          "eq": true,
          "reasonKey": "block.insiderTelemetry"
        }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/privacy/configure-windows-diagnostic-data-in-your-organization",
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-system#allowtelemetry",
        "https://learn.microsoft.com/en-us/windows-insider/data-settings"
      ]
    },
    {
      "id": "privacy.activityHistoryOff",
      "category": "Privacy",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "safe",
      "actions": [
        {
          "type": "registry",
          "hive": "machine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\System",
          "name": "EnableActivityFeed",
          "kind": "dword",
          "value": 0
        },
        {
          "type": "registry",
          "hive": "machine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\System",
          "name": "PublishUserActivities",
          "kind": "dword",
          "value": 0
        },
        {
          "type": "registry",
          "hive": "machine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\System",
          "name": "UploadUserActivities",
          "kind": "dword",
          "value": 0
        }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-privacy",
        "https://support.microsoft.com/en-us/windows/windows-activity-history-and-your-privacy-2b279964-44ec-8c2f-e0c2-6779b07d2cbd"
      ]
    },
    {
      "id": "privacy.consumerFeaturesOff",
      "category": "Privacy",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "safe",
      "appliesTo": {
        "when": {
          "fact": "os.edition",
          "in": [
            "Enterprise",
            "EnterpriseS",
            "EnterpriseN",
            "Education",
            "EducationN",
            "IoTEnterprise",
            "IoTEnterpriseS"
          ]
        }
      },
      "actions": [
        {
          "type": "registry",
          "hive": "machine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent",
          "name": "DisableWindowsConsumerFeatures",
          "kind": "dword",
          "value": 1
        }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-experience",
        "https://learn.microsoft.com/en-us/windows/privacy/manage-connections-from-windows-operating-system-components-to-microsoft-services"
      ]
    },
    {
      "id": "privacy.locationOff",
      "category": "Privacy",
      "conflictsWith": [
        "privacy.locationServiceOff"
      ],
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "safe",
      "appliesTo": {
        "when": {
          "not": {
            "fact": "os.edition",
            "in": [
              "Core",
              "CoreN",
              "CoreSingleLanguage",
              "CoreCountrySpecific"
            ]
          }
        }
      },
      "actions": [
        {
          "type": "registry",
          "hive": "machine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\LocationAndSensors",
          "name": "DisableLocation",
          "kind": "dword",
          "value": 1
        }
      ],
      "sources": [
        "https://support.microsoft.com/en-us/windows/windows-location-service-and-privacy-3a8eee0a-5b0b-dc07-eede-2a5ca1c49088",
        "https://learn.microsoft.com/en-us/windows/privacy/manage-connections-from-windows-operating-system-components-to-microsoft-services",
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-admx-sensors"
      ]
    },
    {
      "id": "background.backgroundAppsOff",
      "category": "Background",
      "impact": {
        "gaming": 0,
        "basis": "disputed",
        "effect": [
          "fps"
        ]
      },
      "risk": "moderate",
      "actions": [
        {
          "type": "registry",
          "hive": "machine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\AppPrivacy",
          "name": "LetAppsRunInBackground",
          "kind": "dword",
          "value": 2
        }
      ],
      "sources": [
        "https://support.microsoft.com/en-us/windows/windows-background-apps-and-your-privacy-83f2de44-d2d9-2b29-4649-2afe0913360a",
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-privacy"
      ]
    },
    {
      "id": "background.aiOff",
      "category": "Background",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "moderate",
      "reversibility": "permanent",
      "actions": [
        {
          "type": "registry",
          "hive": "machine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI",
          "name": "DisableAIDataAnalysis",
          "kind": "dword",
          "value": 1
        }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-windowsai"
      ]
    },
    {
      "id": "background.widgetsOff",
      "category": "Background",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "safe",
      "appliesTo": {
        "when": {
          "fact": "ucpd.running",
          "eq": false
        }
      },
      "actions": [
        {
          "type": "registry",
          "hive": "machine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Dsh",
          "name": "AllowNewsAndInterests",
          "kind": "dword",
          "value": 0
        }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-newsandinterests"
      ]
    }
  ]
}
