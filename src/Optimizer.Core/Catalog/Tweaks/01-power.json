          "setting": "PROCTHROTTLEMAX",
          "ac": 100
        },
        {
          "type": "powerSetting",
          "subgroup": "SUB_PROCESSOR",
          "setting": "PERFBOOSTMODE",
          "ac": 2
        }
      ],
      "recommendWhen": {
        "fact": "finding.F6.turbo.problem",
        "eq": true
      },
      "fixes": [
        "F6.turbo"
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows-hardware/customize/power-settings/options-for-perf-state-engine-perfboostmode",
        "https://learn.microsoft.com/en-us/windows-hardware/customize/power-settings/options-for-perf-state-engine-maxperformance"
