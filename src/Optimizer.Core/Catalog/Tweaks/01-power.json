{
  "tweaks": [
    {
      "id": "power.balancedPlan",
      "category": "Power",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "impactOverrides": [
        {
          "when": {
            "fact": "power.personality",
            "eq": "powersaver"
          },
          "gaming": 2,
          "effect": [
            "fps",
            "lows"
          ],
          "reasonKey": "impact.fromPowerSaver"
        }
      ],
      "risk": "safe",
      "actions": [
        {
