<UserControl x:Class="Optimizer.App.Views.HardwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             xmlns:v="clr-namespace:Optimizer.App.Views"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <!-- One label/value row; rows after the first get a divider line. A fixed label column lines the values up down
             the page (a shared size group costs a measure pass over every row). -->
        <DataTemplate x:Key="HwRow">
            <Border x:Name="Row" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="264" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Label}"
                                  TextWrapping="Wrap" Margin="0,0,24,0" />
                    <StackPanel Grid.Column="1">
                        <ui:TextBlock FontTypography="Body" Text="{Binding Value}" TextWrapping="Wrap" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" Margin="0,2,0,0"
                                      Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}}" />
                        <!-- Used space: two borders instead of a ProgressBar, which costs a template per row -->
                        <Border Width="320" Height="4" CornerRadius="2" HorizontalAlignment="Left" Margin="0,6,0,2" Background="{DynamicResource ControlStrongFillColorDisabledBrush}"
                                Visibility="{Binding Fill, Converter={StaticResource NullToVisibility}}">
                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding Fill, FallbackValue=0}" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                    <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageRoot}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <!-- The same saved setting as Settings > Technical details: one switch for every page's IDs and raw values -->
                    <ui:ToggleSwitch Content="{l:Tr Hw_ShowDetails}" IsChecked="{Binding ShowTechnical}" Margin="0,0,16,0" />
                    <ui:Button Content="{l:Tr Hw_Copy}" Icon="{ui:SymbolIcon Copy20}" Command="{Binding CopyHardwareCommand}" />
                </StackPanel>
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Hw_Title}" />
                    <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Hw_Hint}" />
                </StackPanel>
            </DockPanel>

            <!-- Summary tiles: what is looked up most, like Settings > System > About -->
            <v:ItemList ItemsSource="{Binding HardwareTiles}" Margin="0,0,-8,8">
                <v:ItemList.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </v:ItemList.ItemsPanel>
                <v:ItemList.ItemTemplate>
                    <DataTemplate>
                        <!-- A tile, not a row: the same 16 px on every side (XamlRulesTests allow list) -->
                        <ui:Card Padding="16" Margin="0,0,8,8" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                            <DockPanel>
                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="{Binding Icon}" FontSize="20" VerticalAlignment="Top" Margin="0,2,12,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel>
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Caption}" />
                                    <!-- One line, the full name in the tooltip: tiles keep one height ("Intel(R) Core(TM) i7-9700K CPU @ 3.60GHz") -->
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Value}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" Margin="0,2,0,0" />
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" Margin="0,2,0,0"
                                                  Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </DockPanel>
                        </ui:Card>
                    </DataTemplate>
                </v:ItemList.ItemTemplate>
            </v:ItemList>

            <v:ItemList ItemsSource="{Binding HardwareSections}">
                <v:ItemList.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Padding="{StaticResource CardPadding}" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <v:ItemList ItemsSource="{Binding Items}" ItemTemplate="{StaticResource HwRow}" Margin="32,0,0,0" />
                                <!-- Technical rows: only with the switch on; the divider continues the list above. -->
                                <Grid Visibility="{Binding DataContext.ShowTechnical, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                    <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="32,0,0,0"
                                            Visibility="{Binding Technical.Count, Converter={StaticResource CountToVisibility}}">
                                        <v:ItemList ItemsSource="{Binding Technical}" ItemTemplate="{StaticResource HwRow}" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </v:ItemList.ItemTemplate>
            </v:ItemList>
        </StackPanel>
    </ScrollViewer>
</UserControl>
