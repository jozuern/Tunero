<UserControl x:Class="Optimizer.App.Views.CleanupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             xmlns:v="clr-namespace:Optimizer.App.Views"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- Title, total and the Clean button stay in place; the categories scroll below them -->
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="{l:Tr Common_Refresh}" Icon="{ui:SymbolIcon ArrowClockwise20}" Command="{Binding Cleanup.ReloadCommand}" ToolTip="F5" VerticalAlignment="Top" />
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Cleanup_Title}" />
                    <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Cleanup_Hint}" />
                </StackPanel>
            </DockPanel>
            <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="{Binding Cleanup.IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <!-- Total and the button above the list, so they stay in view without scrolling past every category -->
            <ui:Card Padding="16,12" Margin="0,0,0,8">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="{l:Tr Cleanup_Clean}" Icon="{ui:SymbolIcon Broom20}" Command="{Binding Cleanup.CleanCommand}"
                               IsEnabled="{Binding Cleanup.IsWorking, Converter={StaticResource InverseBool}}" />
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Cleanup.TotalText}" VerticalAlignment="Center" />
                </DockPanel>
            </ui:Card>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Style="{StaticResource EdgeScroll}">
        <StackPanel Style="{StaticResource EdgeContent}">

            <v:ItemList ItemsSource="{Binding Cleanup.Rows}">
                <v:ItemList.ItemTemplate>
                    <DataTemplate>
                        <ui:Card x:Name="Card" Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}">
                            <DockPanel>
                                <ui:TextBlock x:Name="Size" DockPanel.Dock="Right" FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SizeText}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                <CheckBox x:Name="Pick" IsChecked="{Binding Checked}" VerticalAlignment="Top" AutomationProperties.Name="{Binding Title}"
                                          Command="{Binding DataContext.Cleanup.SelectionChangedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <StackPanel>
                                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" />
                                        <!-- Exactly where it deletes: every folder, one per line ("and 2 more" with the rest in a
                                             tooltip could not be read without a mouse) -->
                                        <!-- The folders in the technical view (the outer element), and only when there is something in them (the trigger) -->
                                        <Border Visibility="{Binding DataContext.ShowTechnical, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock x:Name="Folders" Style="{StaticResource Mono}" Text="{Binding FoldersText}" Margin="0,4,0,0" />
                                        </Border>
                                        <ui:TextBlock x:Name="Note" Style="{StaticResource Caption}" Text="{Binding Warning}" Margin="0,4,0,0"
                                                      Visibility="{Binding Warning, Converter={StaticResource NullToVisibility}}" />
                                    </StackPanel>
                                </CheckBox>
                            </DockPanel>
                        </ui:Card>
                        <!-- Nothing to clean: the card is left out; the line under the list names these categories -->
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter TargetName="Card" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Pick" Property="IsEnabled" Value="False" />
                                <Setter TargetName="Folders" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Note" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Size" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </v:ItemList.ItemTemplate>
            </v:ItemList>

            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Cleanup.EmptyText}" Margin="0,4,0,0" TextWrapping="Wrap"
                          Visibility="{Binding Cleanup.EmptyText, Converter={StaticResource NullToVisibility}}" />
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Cleanup_More}" />
            <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Cleanup_ComponentTitle}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Cleanup_ComponentHint}" Margin="0,4,0,0" />
                        <!-- Microsoft gives its own StartComponentCleanup task an hour before it stops
                             (learn.microsoft.com/windows-hardware/manufacture/desktop/clean-up-the-winsxs-folder) -->
                        <ContentControl Style="{StaticResource DurationHint}" Content="{l:Tr Hint_TakesMinutesServicing}" Margin="0,8,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{l:Tr Cleanup_RunClean}" MinWidth="96" Command="{Binding Cleanup.ComponentCleanupCommand}" IsEnabled="{Binding Cleanup.IsWorking, Converter={StaticResource InverseBool}}" />
            </ui:CardControl>
            <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Cleanup_DoTitle}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Cleanup_DoHint}" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{l:Tr Cleanup_RunClean}" MinWidth="96" Command="{Binding Cleanup.DeliveryOptimizationCleanupCommand}" IsEnabled="{Binding Cleanup.IsWorking, Converter={StaticResource InverseBool}}" />
            </ui:CardControl>
            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Cleanup.ToolOutput}" Margin="0,8,0,0" Visibility="{Binding Cleanup.ToolOutput, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
