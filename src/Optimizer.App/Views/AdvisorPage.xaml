<UserControl x:Class="Optimizer.App.Views.AdvisorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             xmlns:v="clr-namespace:Optimizer.App.Views"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- The list scrolls on its own and builds only the cards in view. -->
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <DockPanel>
                <ui:ToggleSwitch DockPanel.Dock="Right" Content="{l:Tr Dash_ShowAll}" IsChecked="{Binding ShowPassed}" VerticalAlignment="Top" />
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Advisor_Title}" />
                    <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Advisor_Hint}" />
                </StackPanel>
            </DockPanel>
            <!-- What was checked and how it came out: the page says that much even when nothing needs a change -->
            <ui:Card Padding="16,12" Margin="0,0,0,8" Visibility="{Binding AdvisorSummaryTitle, Converter={StaticResource NullToVisibility}}">
                <DockPanel>
                    <!-- 24 + 14 px: the title starts where the titles of the cards below start -->
                    <Grid DockPanel.Dock="Left" Width="24" Margin="0,0,14,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Filled="True" FontSize="24" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                       Visibility="{Binding AdvisorAllGood, Converter={StaticResource BoolToVisibility}}" />
                        <ui:SymbolIcon Symbol="Warning24" Filled="True" FontSize="24" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding AdvisorAllGood, Converter={StaticResource InverseBoolToVisibility}}" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding AdvisorSummaryTitle}" TextWrapping="Wrap" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding AdvisorSummaryText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </ui:Card>
            <!-- Only without the summary card: with it, the card names the passed checks and the switch -->
            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Empty_List}" Visibility="{Binding AdvisorEmpty, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <v:ItemList Grid.Row="1" Style="{StaticResource VirtualCardList}" ItemsSource="{Binding AdvisorItems}" ItemTemplate="{StaticResource FindingRow}" />
    </Grid>
</UserControl>
