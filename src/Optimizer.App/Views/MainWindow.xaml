<ui:FluentWindow x:Class="Optimizer.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Optimizer.App.Services"
                 xmlns:v="clr-namespace:Optimizer.App.Views"
                 Title="Tunero"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="1440" Height="960" MinWidth="1040" MinHeight="720"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <!-- Group headings in the pane: small, semibold and in the secondary text color, so they read as labels of the
             items below and not as items themselves (as in Windows Settings). -->
        <Style x:Key="NavGroupHeader" TargetType="v:NavHeader" BasedOn="{StaticResource {x:Type ui:NavigationViewItemHeader}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="4,8,0,0" />
            <!-- A label, not a Tab stop; a screen reader reads its text, not the control's type name -->
            <Setter Property="Focusable" Value="False" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Tunero" ShowHelp="False">
            <!-- Search across the app (Ctrl+F) in the middle of the title bar, as in Windows 11 apps -->
            <ui:TitleBar.CenterContent>
                <ui:TextBox x:Name="SearchBox" Width="400" Margin="24,6,0,6" SizeChanged="SearchBox_SizeChanged" PlaceholderText="{l:Tr Search_Placeholder}" Icon="{ui:SymbolIcon Search20}" ClearButtonEnabled="True"
                            Text="{Binding GlobalSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}" PreviewKeyDown="SearchBox_PreviewKeyDown"
                            AutomationProperties.Name="{l:Tr Search_Placeholder}" ToolTip="Ctrl+F"
                            IsEnabled="{Binding SetupShown, Converter={StaticResource InverseBool}}" />
            </ui:TitleBar.CenterContent>
            <ui:TitleBar.Icon>
                <ui:ImageIcon x:Name="TitleIcon" Source="pack://application:,,,/Assets/icon-16.png" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:NavigationView x:Name="Nav" Grid.Column="0" PaneDisplayMode="Left" OpenPaneLength="248"
                               IsEnabled="{Binding SetupShown, Converter={StaticResource InverseBool}}"
                               IsBackButtonVisible="Collapsed" IsPaneToggleVisible="True" FrameMargin="0">
                <!-- Grouped like Windows Settings: what to change, what to remove, what to keep in shape and check. The headings show
                     only in the open pane and when the window is tall enough for them (FitPanes). Navigation goes by page type. -->
                <ui:NavigationView.MenuItems>
                    <!-- Badges say where something waits: problems on the overview, things to change by hand, the changes made -->
                    <v:NavItem Content="{l:Tr Nav_Dashboard}" TargetPageType="{x:Type v:OverviewPage}" Icon="{ui:SymbolIcon Home24}">
                        <v:NavItem.InfoBadge>
                            <ui:InfoBadge Severity="Caution" Value="{Binding OverviewBadge}" Visibility="{Binding OverviewBadge, Converter={StaticResource NullToVisibility}}" />
                        </v:NavItem.InfoBadge>
                    </v:NavItem>
                    <v:NavHeader x:Name="HeaderOptimize" Text="{l:Tr Nav_GroupOptimize}" Style="{StaticResource NavGroupHeader}" />
                    <v:NavItem Content="{l:Tr Nav_Tweaks}" TargetPageType="{x:Type v:TweaksPage}" Icon="{ui:SymbolIcon Wrench24}" />
                    <v:NavItem Content="{l:Tr Nav_Network}" TargetPageType="{x:Type v:NetworkPage}" Icon="{ui:SymbolIcon DesktopPulse24}" />
                    <v:NavItem Content="{l:Tr Nav_Startup}" TargetPageType="{x:Type v:StartupPage}" Icon="{ui:SymbolIcon Rocket24}" />
                    <v:NavItem Content="{l:Tr Nav_Services}" TargetPageType="{x:Type v:ServicesPage}" Icon="{ui:SymbolIcon AppsListDetail24}" />
                    <v:NavHeader x:Name="HeaderCleanUp" Text="{l:Tr Nav_GroupCleanUp}" Style="{StaticResource NavGroupHeader}" />
                    <v:NavItem Content="{l:Tr Nav_Debloat}" TargetPageType="{x:Type v:DebloatPage}" Icon="{ui:SymbolIcon Delete24}" />
                    <v:NavItem Content="{l:Tr Nav_Cleanup}" TargetPageType="{x:Type v:CleanupPage}" Icon="{ui:SymbolIcon Broom24}" />
                    <v:NavItem Content="{l:Tr Nav_Storage}" TargetPageType="{x:Type v:StoragePage}" Icon="{ui:SymbolIcon Storage24}" />
                    <v:NavHeader x:Name="HeaderMaintain" Text="{l:Tr Nav_GroupMaintain}" Style="{StaticResource NavGroupHeader}" />
                    <v:NavItem Content="{l:Tr Nav_Apps}" TargetPageType="{x:Type v:AppsPage}" Icon="{ui:SymbolIcon Apps24}" />
                    <v:NavItem Content="{l:Tr Nav_Tools}" TargetPageType="{x:Type v:ToolsPage}" Icon="{ui:SymbolIcon Toolbox24}" />
                    <v:NavItem Content="{l:Tr Nav_InstallMedia}" TargetPageType="{x:Type v:InstallMediaPage}" Icon="{ui:SymbolIcon UsbStick24}" />
                    <v:NavItem Content="{l:Tr Nav_Health}" TargetPageType="{x:Type v:HealthPage}" Icon="{ui:SymbolIcon HeartPulse24}" />
                    <v:NavItem Content="{l:Tr Nav_Advisor}" TargetPageType="{x:Type v:AdvisorPage}" Icon="{ui:SymbolIcon ClipboardTaskListLtr24}">
                        <v:NavItem.InfoBadge>
                            <ui:InfoBadge Severity="Caution" Value="{Binding AdvisorBadge}" Visibility="{Binding AdvisorBadge, Converter={StaticResource NullToVisibility}}" />
                        </v:NavItem.InfoBadge>
                    </v:NavItem>
                </ui:NavigationView.MenuItems>
                <ui:NavigationView.FooterMenuItems>
                    <!-- The way back from every change, always in view (never scrolled off the list). No count: a number that
                         never goes away reads as something to fix and would push towards undoing changes made on purpose. -->
                    <v:NavItem Content="{l:Tr Nav_Changes}" TargetPageType="{x:Type v:ChangesPage}" Icon="{ui:SymbolIcon History24}" />
                    <v:NavItem Content="{l:Tr Nav_Hardware}" TargetPageType="{x:Type v:HardwarePage}" Icon="{ui:SymbolIcon Desktop24}" />
                    <v:NavItem Content="{l:Tr Nav_Settings}" TargetPageType="{x:Type v:SettingsPage}" Icon="{ui:SymbolIcon Settings24}">
                        <!-- A new version is available: the update is under Settings > Updates -->
                        <v:NavItem.InfoBadge>
                            <ui:InfoBadge Severity="Attention" Value="{Binding SettingsBadge}" Visibility="{Binding SettingsBadge, Converter={StaticResource NullToVisibility}}" />
                        </v:NavItem.InfoBadge>
                    </v:NavItem>
                </ui:NavigationView.FooterMenuItems>
                <!-- While a change, a cleanup or a long tool runs: what runs, how far it is and Stop where that is safe, above
                     every page (nothing else can change the PC meanwhile). The header pushes the page down instead of covering
                     its title; its width follows the page content (at most 1000 px, page padding 24 left and 40 right). -->
                <ui:NavigationView.Header>
                    <Grid Margin="24,16,40,0" Visibility="{Binding Runner.Work.IsShown, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="1000" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Card Padding="16,12" DataContext="{Binding Runner.Work}">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Content="{l:Tr Common_Stop}" Icon="{ui:SymbolIcon Stop20}" Command="{Binding StopCommand}" VerticalAlignment="Center" Margin="16,0,0,0"
                                           Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" AutomationProperties.LiveSetting="Polite" />
                                        <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Count}" Margin="12,0,0,0"
                                                      Visibility="{Binding Count, Converter={StaticResource NullToVisibility}}" />
                                    </StackPanel>
                                    <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                                  Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}}" />
                                    <ProgressBar Margin="0,12,0,0" Minimum="0" Maximum="100" Value="{Binding Value, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}"
                                                 AutomationProperties.Name="{Binding Title}" />
                                    <!-- SFC, DISM, Update all: a moving bar for minutes looks stuck without this -->
                                    <ContentControl Style="{StaticResource DurationHint}" Margin="0,8,0,0" Content="{Binding DurationText}"
                                                    Visibility="{Binding DurationText, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </DockPanel>
                        </ui:Card>
                    </Grid>
                </ui:NavigationView.Header>
                <ui:NavigationView.PaneFooter>
                    <!-- Collapsed rail: the text is hidden (it would be cut off), only the progress rings stay. -->
                    <StackPanel Margin="16,8,16,12">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,4">
                            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" />
                            <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ScanStatus}" TextWrapping="Wrap" MaxWidth="180" Visibility="{Binding IsPaneOpen, ElementName=Nav, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding LastScanText}" Visibility="{Binding IsPaneOpen, ElementName=Nav, Converter={StaticResource BoolToVisibility}}" />
                        <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Version, StringFormat='Tunero {0}'}" Visibility="{Binding IsPaneOpen, ElementName=Nav, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ui:NavigationView.PaneFooter>
            </ui:NavigationView>

            <!-- Search results under the search box: what it is, a line about it, and the page it is on -->
            <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                   IsOpen="{Binding SearchResultsOpen, Mode=TwoWay}" Width="480">
                <Border Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,0,0">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr Search_Empty}" Margin="12,8"
                                      Visibility="{Binding SearchEmpty, Converter={StaticResource BoolToVisibility}}" />
                        <ListBox x:Name="SearchList" ItemsSource="{Binding SearchResults}" MaxHeight="440" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewKeyDown="SearchList_PreviewKeyDown" MouseLeftButtonUp="SearchList_MouseLeftButtonUp"
                                 AutomationProperties.Name="{l:Tr Search_Results}"
                                 Visibility="{Binding SearchEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="4,4">
                                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="{Binding Icon}" FontSize="20" Margin="0,2,12,0" VerticalAlignment="Top"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <StackPanel>
                                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" TextWrapping="Wrap" />
                                            <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Snippet}"
                                                          TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" Margin="0,2,0,0" />
                                            <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="{Binding Where}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Result of the last action. The InfoBar draws the bar, the icon and the close button; the message and the link to
                 the Changes page lie over it (the WPF-UI InfoBar has no content slot). Errors and warnings stay until closed. -->
            <Grid Grid.Column="0" VerticalAlignment="Bottom" Margin="24" MaxWidth="900" HorizontalAlignment="Center"
                  Visibility="{Binding ResultOpen, Converter={StaticResource BoolToVisibility}}">
                <!-- The last column is the close button's: the message and the link or button never reach under it (a message
                     without a link used to run under the X, "99 %" and "Fehlgeschlagen: 0." were cut by it) -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <!-- The InfoBar's fill is see-through and the bar lies over the page: a solid layer under it keeps the page's text
                     from showing through the message. -->
                <Border Grid.ColumnSpan="3" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                <ui:InfoBar Grid.ColumnSpan="3" Title="" Message="" IsOpen="{Binding ResultOpen, Mode=TwoWay}" IsClosable="True" Severity="{Binding ResultSeverity}" />
                <TextBlock x:Name="ResultMessage" Text="{Binding ResultText}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center" Margin="46,12,16,12"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.LiveSetting="Assertive" />
                <ui:HyperlinkButton Grid.Column="1" Content="{l:Tr Result_ViewChanges}" Command="{Binding OpenChangesCommand}" VerticalAlignment="Center" Margin="0,0,8,0"
                                    Visibility="{Binding ResultShowsChanges, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Grid.Column="1" Content="{Binding ResultUpdateText}" Command="{Binding UpdateNowCommand}" Appearance="Primary" VerticalAlignment="Center" Margin="0,0,8,0"
                           Visibility="{Binding ResultShowsUpdate, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- Details pane: explanation of the selected item. Its left edge can be dragged to make it wider or narrower. -->
            <Border x:Name="DetailsPane" Grid.Column="1" Width="460" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    IsEnabled="{Binding SetupShown, Converter={StaticResource InverseBool}}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibility}}">
                <DockPanel Margin="24,16,8,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,16,8" DataContext="{Binding SelectedItem}">
                        <ui:Button DockPanel.Dock="Right" VerticalAlignment="Top" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss20}" ToolTip="Esc" AutomationProperties.Name="{l:Tr Common_Close}"
                                   Command="{Binding DataContext.CloseInspectorCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <!-- Title first, then the state, the action and the explanation (the document leaves out its own title) -->
                        <StackPanel Margin="0,4,8,0">
                            <ui:TextBlock FontTypography="Subtitle" Text="{Binding Title}" TextWrapping="Wrap" />
                            <v:ItemList ItemsSource="{Binding Badges}" ItemTemplate="{StaticResource BadgeTag}" Focusable="False" Margin="0,6,0,0"
                                          Visibility="{Binding Badges.Count, Converter={StaticResource CountToVisibility}}">
                                <v:ItemList.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </v:ItemList.ItemsPanel>
                            </v:ItemList>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ui:SymbolIcon Symbol="{Binding StatusSymbol}" Filled="True" FontSize="20" Margin="0,0,8,0"
                                               v:ThemeBrush.Key="{Binding StatusBrushKey}" />
                                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding StatusText}" VerticalAlignment="Center" />
                                <!-- The rows show the rating mark alone; here it stands next to its words, so the pane explains it -->
                                <v:RatingMark Value="{Binding Rating}" Disputed="{Binding IsDisputed}" KeepsPlace="False" Margin="16,0,0,0" ToolTip="{Binding ImpactTooltip}"
                                              AutomationProperties.Name="{Binding ImpactText}" />
                                <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ImpactText}" Margin="12,0,0,0" VerticalAlignment="Center"
                                              ToolTip="{Binding ImpactTooltip}" />
                            </StackPanel>
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Note}" TextWrapping="Wrap" Margin="0,8,0,0"
                                          Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                    <!-- A scan result kept on purpose (a game library on a hard disk) or a recommendation that does not fit this
                         PC (clipboard history next to another clipboard manager): ignored, or back again -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,16,8" DataContext="{Binding SelectedItem}">
                        <ui:Button Content="{Binding IgnoreText, FallbackValue={x:Null}}" Icon="{ui:SymbolIcon EyeOff20}" Appearance="Secondary"
                                   Visibility="{Binding OffersIgnore, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                                   Command="{Binding DataContext.IgnoreCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                        <ui:Button Content="{l:Tr Findings_StopIgnoring}" Icon="{ui:SymbolIcon Eye20}" Appearance="Secondary"
                                   Visibility="{Binding IsIgnored, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                                   Command="{Binding DataContext.StopIgnoringCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                    </WrapPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,4,16,16" DataContext="{Binding SelectedItem}"
                                Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}">
                        <ui:Button Appearance="Primary" Content="{Binding ActionText}" HorizontalAlignment="Left" MinWidth="120"
                                   IsEnabled="{Binding ActionEnabled}"
                                   Command="{Binding DataContext.RunActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                        <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding ActionNote}" TextWrapping="Wrap" Margin="0,8,0,0"
                                      Visibility="{Binding ActionNote, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                    <FlowDocumentScrollViewer x:Name="DetailsViewer" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"
                                              AutomationProperties.Name="{Binding SelectedItem.Title}" />
                </DockPanel>
            </Border>
            <Thumb Grid.Column="1" Width="6" HorizontalAlignment="Left" Cursor="SizeWE" DragDelta="DetailsResize_DragDelta"
                   Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibility}}">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!-- The first start's setup covers the navigation and the pages until it is answered -->
            <Border Grid.ColumnSpan="2" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    Visibility="{Binding SetupShown, Converter={StaticResource BoolToVisibility}}">
                <v:SetupView />
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
