<UserControl x:Class="Optimizer.App.Views.TweaksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             xmlns:v="clr-namespace:Optimizer.App.Views"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- Header and filters stay in place; the tweak list scrolls on its own and builds only the cards in view. -->
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Tweaks_Title}" />
            <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Tweaks_Hint}" />

            <ui:InfoBar Title="" Message="{l:Tr Banner_AdminToApply}" Severity="Warning" IsClosable="False"
                        IsOpen="{Binding IsElevated, Converter={StaticResource InverseBool}}" Margin="0,0,0,8" />

            <!-- One card for everything above the list. First row: search (it takes the rest) and what to show. Below a
                 divider: the counts and the two links on the left, the buttons on the right, both centered on one line. The
                 profile is a setting of the whole app, chosen on the overview: here it is named, with the way there. -->
            <ui:Card Padding="{StaticResource CardPadding}" Margin="0,0,0,8">
                <StackPanel>
                    <!-- Narrow (the details pane open): the filters go under the search box (code-behind) -->
                    <Grid x:Name="FilterRow" SizeChanged="FilterRow_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBox x:Name="SearchBox" PlaceholderText="{l:Tr Tweaks_Search}" AutomationProperties.Name="{l:Tr Tweaks_Search}" Icon="{ui:SymbolIcon Search20}" Text="{Binding TweakSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                    Margin="0,0,16,0" ClearButtonEnabled="True" />
                        <StackPanel x:Name="Filters" Grid.Column="1" Orientation="Horizontal">
                            <ui:TextBlock FontTypography="Body" Text="{l:Tr TweakView_Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding TweakViewOptions}" SelectedValuePath="View" SelectedValue="{Binding TweakViewMode}" DisplayMemberPath="Text"
                                      MinWidth="200" AutomationProperties.Name="{l:Tr TweakView_Label}" />
                            <!-- The rating the rows' marks show, for the active profile -->
                            <ComboBox ItemsSource="{Binding TweakImpactOptions}" SelectedValuePath="Min" SelectedValue="{Binding TweakImpactMin}" DisplayMemberPath="Text"
                                      MinWidth="160" Margin="8,0,0,0" AutomationProperties.Name="{l:Tr TweakImpact_Label}" ToolTip="{l:Tr TweakImpact_Tip}" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <!-- The buttons go under the counts when beside them the counts would wrap to more than two lines (code-behind) -->
                    <DockPanel x:Name="ListRow" SizeChanged="ListRow_SizeChanged">
                        <StackPanel x:Name="ListActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                                    SizeChanged="ListRow_SizeChanged">
                            <ui:Button Appearance="Primary" Content="{Binding RecommendedButtonText}" Command="{Binding ApplyRecommendedCommand}" Margin="0,0,8,0"
                                       Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVisibility}}" />
                            <!-- Select mode: a check box on every row, the actions for the picked rows below -->
                            <ToggleButton IsChecked="{Binding TweakSelectMode}" Margin="0,0,4,0" ToolTip="{l:Tr Tweaks_SelectTip}" AutomationProperties.Name="{l:Tr Tweaks_Select}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="MultiselectLtr20" Margin="0,0,8,0" />
                                    <TextBlock Text="{l:Tr Tweaks_Select}" />
                                </StackPanel>
                            </ToggleButton>
                            <ui:Button Appearance="Transparent" Content="{l:Tr Tweaks_OpenAll}" Icon="{ui:SymbolIcon ChevronDown20}" Command="{Binding OpenAllTweakGroupsCommand}" Margin="0,0,4,0" />
                            <ui:Button Appearance="Transparent" Content="{l:Tr Tweaks_CloseAll}" Icon="{ui:SymbolIcon ChevronUp20}" Command="{Binding CloseAllTweakGroupsCommand}" />
                        </StackPanel>
                        <ui:TextBlock x:Name="ListSummary" FontTypography="Body" Text="{Binding TweaksSummary}" TextWrapping="Wrap" VerticalAlignment="Center"
                                      SizeChanged="ListRow_SizeChanged" />
                    </DockPanel>
                    <!-- The links below, across the whole card: a link does not wrap, so next to the buttons a narrow window cut it off -->
                    <WrapPanel Margin="0,4,0,0">
                        <ui:HyperlinkButton Content="{Binding TweaksProfileLink}" Padding="0" Margin="0,0,16,0" ToolTip="{l:Tr Profile_Hint}"
                                            Command="{Binding OpenOverviewCommand}" />
                        <!-- Expert changes are hidden until Expert mode is on: a way there from this page -->
                        <ui:HyperlinkButton Content="{l:Tr Tweaks_ExpertLink}" Padding="0" Command="{Binding OpenSettingsCommand}"
                                            Visibility="{Binding ExpertMode, Converter={StaticResource InverseBoolToVisibility}}" />
                    </WrapPanel>
                    <!-- What the picked rows get: one confirmation each for turning on and for undoing -->
                    <StackPanel Visibility="{Binding TweakSelectMode, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource Divider}" />
                        <WrapPanel>
                            <ui:TextBlock FontTypography="Body" Text="{Binding TweaksPickedText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <ui:Button Appearance="Primary" Content="{Binding TurnOnPickedText}" Icon="{ui:SymbolIcon Play20}" Command="{Binding TurnOnPickedCommand}" Margin="0,0,8,0"
                                       ToolTip="{l:Tr Tweaks_PickedTurnOnTip}" Visibility="{Binding PickedOnCount, Converter={StaticResource CountToVisibility}}" />
                            <ui:Button Content="{Binding UndoPickedText}" Icon="{ui:SymbolIcon ArrowUndo20}" Command="{Binding UndoPickedCommand}" Margin="0,0,8,0"
                                       Visibility="{Binding PickedUndoCount, Converter={StaticResource CountToVisibility}}" />
                            <ui:Button Appearance="Transparent" Content="{l:Tr Tweaks_PickAll}" Icon="{ui:SymbolIcon SelectAllOn20}" Command="{Binding PickAllTweaksCommand}" Margin="0,0,4,0"
                                       ToolTip="{l:Tr Tweaks_PickAllTip}" />
                            <ui:Button Appearance="Transparent" Content="{l:Tr Tweaks_PickNone}" Icon="{ui:SymbolIcon SelectAllOff20}" Command="{Binding ClearTweakPicksCommand}"
                                       Visibility="{Binding HasPicks, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </ui:Card>
            <ui:TextBlock Style="{StaticResource EmptyState}" Text="{l:Tr Empty_List}" Visibility="{Binding Tweaks.Count, Converter={StaticResource EmptyToVisibility}}" />
        </StackPanel>
        <!-- One list for the group headings and the tweaks of the open groups, so only the cards in view are built. The
             tweaks are indented under their heading. -->
        <v:ItemList Grid.Row="1" Style="{StaticResource VirtualCardList}" ItemsSource="{Binding TweakRows}">
            <v:ItemList.ItemTemplateSelector>
                <v:TweakListTemplateSelector>
                    <v:TweakListTemplateSelector.Group>
                        <DataTemplate>
                            <v:ClickCard Style="{StaticResource {x:Type ui:CardControl}}" Focusable="True" Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}" AutomationProperties.Name="{Binding AutomationName}"
                                            Command="{Binding DataContext.ToggleTweakGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <ui:CardControl.Icon>
                                    <ui:SymbolIcon Symbol="{Binding Icon}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </ui:CardControl.Icon>
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" TextWrapping="Wrap" />
                                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Summary}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <!-- Turn on the safe tweaks of the group at once (one confirmation lists every change), then the chevron -->
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="{Binding ApplyAllText}" Margin="0,0,16,0" VerticalAlignment="Center" ToolTip="{l:Tr Tweaks_GroupApplyTip}"
                                               Visibility="{Binding CanApplyAll, Converter={StaticResource BoolToVisibility}}"
                                               Command="{Binding DataContext.ApplyTweakGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <ui:SymbolIcon Symbol="{Binding Chevron}" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </v:ClickCard>
                        </DataTemplate>
                    </v:TweakListTemplateSelector.Group>
                    <v:TweakListTemplateSelector.Tweak>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TweakRow}" Margin="24,0,0,0" />
                        </DataTemplate>
                    </v:TweakListTemplateSelector.Tweak>
                </v:TweakListTemplateSelector>
            </v:ItemList.ItemTemplateSelector>
        </v:ItemList>
    </Grid>
</UserControl>
