<UserControl x:Class="Optimizer.App.Views.ServicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:s="clr-namespace:Optimizer.App.Services"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             xmlns:v="clr-namespace:Optimizer.App.Views"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
            <ui:Button DockPanel.Dock="Right" Content="{l:Tr Common_Refresh}" Icon="{ui:SymbolIcon ArrowClockwise20}" Command="{Binding ServicesPage.ReloadCommand}" ToolTip="F5" VerticalAlignment="Top" />
            <StackPanel>
                <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Svc_Title}" />
                <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Svc_Hint}" />
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1" ItemContainerStyle="{StaticResource SelectorTab}" SelectedIndex="{Binding ServicesTab}">
            <TabItem Header="{l:Tr Svc_TabServices}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:Card Padding="{StaticResource CardPadding}" Margin="0,0,0,8">
                        <StackPanel>
                            <WrapPanel>
                                <ui:TextBox PlaceholderText="{l:Tr Svc_Search}" AutomationProperties.Name="{l:Tr Svc_Search}" Text="{Binding ServicesPage.Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" MinWidth="280" Margin="0,0,16,0"
                                            Icon="{ui:SymbolIcon Search20}" />
                                <ui:ToggleSwitch Content="{l:Tr Svc_ShowWindows}" IsChecked="{Binding ServicesPage.ShowWindowsServices}" />
                            </WrapPanel>
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Svc_Rules}" Margin="0,8,0,0" />
                            <ui:TextBlock Style="{StaticResource EmptyState}" Text="{l:Tr List_NoMatch}" Margin="0,8,0,0"
                                          Visibility="{Binding ServicesPage.RowsNoMatch, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding ServicesPage.IsLoading, Converter={StaticResource BoolToVisibility}}">
                                <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" />
                                <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Svc_Loading}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                    <v:ItemList Grid.Row="1" ItemsSource="{Binding ServicesPage.Rows}" Style="{StaticResource VirtualCardList}">
                        <v:ItemList.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" Width="200">
                                            <!-- One combo box on every row, so the column reads the same all the way down. A row with
                                                 nothing to choose has it disabled with a lock in front (the place is kept on every
                                                 row, so the boxes line up); the tooltip says why. -->
                                            <DockPanel ToolTip="{Binding LockTipShown}" ToolTipService.ShowOnDisabled="True" Background="Transparent">
                                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="LockClosed16" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,8,0"
                                                               VerticalAlignment="Center" Visibility="{Binding IsLocked, Converter={StaticResource BoolToHidden}}" />
                                                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" DisplayMemberPath="Text" AutomationProperties.Name="{Binding StartTypeLabel}"
                                                          AutomationProperties.HelpText="{Binding LockTipShown}">
                                                    <ComboBox.IsEnabled>
                                                        <MultiBinding Converter="{StaticResource AllTrue}">
                                                            <Binding Path="CanChoose" />
                                                            <Binding Path="CanChange" Source="{x:Static s:ChangeGate.Instance}" />
                                                        </MultiBinding>
                                                    </ComboBox.IsEnabled>
                                                </ComboBox>
                                            </DockPanel>
                                            <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding EditText}" TextWrapping="Wrap" Margin="24,4,0,0"
                                                          Visibility="{Binding EditText, Converter={StaticResource NullToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                            <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MetaText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Note}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                          Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}" />
                                            <!-- Windows' own description can run to five lines: two lines here, all of it in the tooltip -->
                                            <!-- Labeled: the service registers it itself, in the language of Windows, not of this app -->
                                            <Border Visibility="{Binding DataContext.ShowTechnical, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                            <ui:TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" ToolTip="{Binding Description}"
                                                          TextTrimming="CharacterEllipsis" LineStackingStrategy="BlockLineHeight" LineHeight="16" MaxHeight="32"
                                                          Visibility="{Binding Description, Converter={StaticResource NullToVisibility}}">
                                                <Run Text="{l:Tr Svc_FromWindows}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding Description, Mode=OneWay}" />
                                            </ui:TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                </ui:Card>
                            </DataTemplate>
                        </v:ItemList.ItemTemplate>
                    </v:ItemList>
                </Grid>
            </TabItem>
            <TabItem Header="{l:Tr Svc_TabTasks}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:Card Padding="{StaticResource CardPadding}" Margin="0,0,0,8">
                        <StackPanel>
                            <WrapPanel>
                                <ui:TextBox PlaceholderText="{l:Tr Task_Search}" AutomationProperties.Name="{l:Tr Task_Search}" Text="{Binding ServicesPage.TaskSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                            MinWidth="280" Margin="0,0,16,0" Icon="{ui:SymbolIcon Search20}" ClearButtonEnabled="True" />
                                <ui:ToggleSwitch Content="{l:Tr Task_ShowMicrosoft}" IsChecked="{Binding ServicesPage.ShowMicrosoftTasks}" />
                            </WrapPanel>
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Task_Hint}" Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding ServicesPage.IsLoading, Converter={StaticResource BoolToVisibility}}">
                                <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" />
                                <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Svc_Loading}" VerticalAlignment="Center" />
                            </StackPanel>
                            <ui:TextBlock Style="{StaticResource EmptyState}" Text="{l:Tr List_NoMatch}" Margin="0,8,0,0"
                                          Visibility="{Binding ServicesPage.TasksNoMatch, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </ui:Card>
                    <v:ItemList Grid.Row="1" ItemsSource="{Binding ServicesPage.Tasks}" Style="{StaticResource VirtualCardList}">
                        <v:ItemList.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                                    <DockPanel>
                                        <!-- As on the Startup page: a fixed column with the switch on its left, and where Windows'
                                             own task cannot be switched, the note why in its place instead of a grey switch -->
                                        <StackPanel DockPanel.Dock="Right" Width="148" Margin="16,0,0,0" VerticalAlignment="Center">
                                            <ui:ToggleSwitch AutomationProperties.Name="{Binding Name}" IsChecked="{Binding SwitchState, Mode=TwoWay}" HorizontalAlignment="Left"
                                                             OnContent="{Binding OnText}" OffContent="{Binding OffText}"
                                                             Visibility="{Binding CanToggle, Converter={StaticResource BoolToVisibility}}">
                                                <ui:ToggleSwitch.IsEnabled>
                                                    <MultiBinding Converter="{StaticResource AllTrue}">
                                                        <Binding Path="CanToggle" />
                                                        <Binding Path="CanChange" Source="{x:Static s:ChangeGate.Instance}" />
                                                    </MultiBinding>
                                                </ui:ToggleSwitch.IsEnabled>
                                            </ui:ToggleSwitch>
                                            <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ReadOnlyNote}" TextWrapping="Wrap"
                                                          ToolTip="{l:Tr Task_ReadOnlyTip}" Background="Transparent"
                                                          Visibility="{Binding ReadOnlyNote, Converter={StaticResource NullToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextWrapping="Wrap" />
                                            <!-- The trigger (at sign-in, at startup, on a schedule), not the path again -->
                                            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Location}" Margin="0,4,0,0" />
                                            <!-- The command with Technical details only, on one line with all of it in the tooltip -->
                                            <Border Visibility="{Binding DataContext.ShowTechnical, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Style="{StaticResource Mono}" Text="{Binding Command}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Command}" Visibility="{Binding Command, Converter={StaticResource NullToVisibility}}" />
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                </ui:Card>
                            </DataTemplate>
                        </v:ItemList.ItemTemplate>
                    </v:ItemList>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
