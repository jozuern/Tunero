<UserControl x:Class="Optimizer.App.Views.ChangesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:v="clr-namespace:Optimizer.App.Views"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageRoot}">
            <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Changes_Title}" />
            <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Changes_Hint}" />

            <!-- What can be undone first: it is why people come to this page -->
            <DockPanel Margin="0,0,0,8">
                <ui:Button DockPanel.Dock="Right" Content="{l:Tr Changes_UndoAll}" Icon="{ui:SymbolIcon ArrowUndo20}" Command="{Binding UndoAllCommand}"
                           Visibility="{Binding ChangesEmpty, Converter={StaticResource InverseBoolToVisibility}}" />
                <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Changes_Backups}" VerticalAlignment="Center" />
            </DockPanel>
            <ui:TextBlock Style="{StaticResource EmptyState}" Text="{l:Tr Changes_Empty}" Visibility="{Binding ChangesEmpty, Converter={StaticResource BoolToVisibility}}" />
            <v:ItemList ItemsSource="{Binding ChangeRecords}">
                <v:ItemList.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="{Binding Status, Converter={StaticResource StatusToSymbol}}" Filled="True" v:ThemeBrush.Status="{Binding Status}" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" TextWrapping="Wrap" />
                                    <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0">
                                        <Run Text="{Binding When, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding Details, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding StateText, Mode=OneWay}" />
                                    </ui:TextBlock>
                                    <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding ResetText}" TextWrapping="Wrap"
                                                  Margin="0,4,0,0" Visibility="{Binding ResetText, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="{l:Tr Drift_ApplyAgain}" Appearance="Primary" Icon="{ui:SymbolIcon ArrowRedo20}" Margin="0,0,8,0" AutomationProperties.Name="{Binding ReapplyLabel}"
                                           Visibility="{Binding IsReset, Converter={StaticResource BoolToVisibility}}"
                                           Command="{Binding DataContext.ReapplyRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding TweakId}" />
                                <ui:Button Content="{l:Tr Tweak_Undo}" Icon="{ui:SymbolIcon ArrowUndo20}" IsEnabled="{Binding CanUndo}" AutomationProperties.Name="{Binding UndoLabel}"
                                           Command="{Binding DataContext.UndoRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding TweakId}" />
                            </StackPanel>
                        </ui:CardControl>
                    </DataTemplate>
                </v:ItemList.ItemTemplate>
            </v:ItemList>

            <!-- Only once something ran: an empty log would only repeat the empty list above -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Changes_Log}" Visibility="{Binding ChangeLogEmpty, Converter={StaticResource InverseBoolToVisibility}}" />
            <ui:Card Padding="{StaticResource CardPadding}" Visibility="{Binding ChangeLogEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                <v:ItemList ItemsSource="{Binding ChangeLog}">
                    <v:ItemList.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Time}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <ui:TextBlock Grid.Column="1" FontTypography="Body" Text="{Binding Text}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </v:ItemList.ItemTemplate>
                </v:ItemList>
            </ui:Card>

            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Changes_Safety}" />
            <ui:CardControl Padding="{StaticResource CardPadding}">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="{Binding RestorePointIcon}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Changes_RestorePoints}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding RestorePointText}" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{l:Tr Changes_EnableRp}" Command="{Binding EnableRestorePointsCommand}" Visibility="{Binding CanEnableRestorePoints, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0" />
                    <ui:Button Content="{l:Tr Changes_OpenRestore}" Icon="{ui:SymbolIcon History20}" Command="{Binding OpenSystemRestoreCommand}" />
                </StackPanel>
            </ui:CardControl>

            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Changes_OtherPcs}" />
            <!-- A card with a second row: icon top left, the text beside it, the buttons top right, and the opt-in parts of
                 the export underneath, across the text and button columns. The 24 px icon and its 14 px gap match the
                 CardControls around it, so the titles line up. -->
            <ui:Card Padding="{StaticResource CardPadding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:SymbolIcon Grid.RowSpan="2" Symbol="ArrowSwap24" FontSize="24" VerticalAlignment="Top" Margin="0,0,14,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Grid.Column="1">
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Changes_Transfer}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Changes_TransferText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                        <ui:Button Content="{l:Tr Changes_Export}" Icon="{ui:SymbolIcon ArrowExportUp20}" Command="{Binding ExportChangesCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="{l:Tr Changes_Import}" Icon="{ui:SymbolIcon ArrowImport20}" Command="{Binding ImportChangesCommand}" />
                    </StackPanel>
                    <!-- Opt-in parts of the export, in the card of the Export button they change: they belong to this PC's
                         apps and programs, so they are left out unless chosen -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                        <ui:TextBlock FontTypography="Body" Text="{l:Tr Changes_ExportAlso}" />
                        <!-- The check box template insets its box: the negative margin lines the boxes up with the text above -->
                        <WrapPanel Margin="-10,4,0,0">
                            <CheckBox Content="{l:Tr Changes_ExportApps}" IsChecked="{Binding ExportApps}" Margin="0,0,24,0" />
                            <CheckBox Content="{l:Tr Changes_ExportServices}" IsChecked="{Binding ExportServices}" Margin="0,0,24,0" />
                            <CheckBox Content="{l:Tr Changes_ExportStartup}" IsChecked="{Binding ExportStartup}" />
                        </WrapPanel>
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Changes_ExportAlsoHint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </ui:Card>
            <!-- The per-user tweaks that are on, for accounts created later (NewUserDefaults) -->
            <ui:CardControl Padding="{StaticResource CardPadding}" Margin="0,4,0,0">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="PersonAdd24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr NewUsers_Title}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr NewUsers_Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{l:Tr NewUsers_Copy}" Command="{Binding CopyToNewAccountsCommand}" />
            </ui:CardControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
