<UserControl x:Class="Optimizer.App.Views.NetworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             xmlns:s="clr-namespace:Optimizer.App.Services"
             xmlns:v="clr-namespace:Optimizer.App.Views"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <!-- Lists of one kind (games, devices): one line per row, the section explains the rest. Click opens the details. -->
        <DataTemplate x:Key="CompactTweakRow">
            <v:ClickCard Margin="0,0,0,2" Padding="16,6" Style="{StaticResource SelectableCard}" AutomationProperties.Name="{Binding Title}"
                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <ui:CardControl.Header>
                    <!-- As on the Tweaks page: the icon only in front of a row that needs attention, no empty icon column -->
                    <WrapPanel>
                        <ui:SymbolIcon Symbol="{Binding StatusSymbol}" Filled="True" FontSize="16" v:ThemeBrush.Key="{Binding StatusBrushKey}" Margin="0,0,8,0"
                                       VerticalAlignment="Center" Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVisibility}}" />
                        <ui:TextBlock FontTypography="Body" Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding CompactMeta}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    </WrapPanel>
                </ui:CardControl.Header>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TweakSwitch}" />
            </v:ClickCard>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageRoot}" DataContext="{Binding}">
            <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Net_Title}" />
            <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Net_Hint}" />

            <!-- No NVIDIA card: the page's graphics part says why it is empty instead of leaving only DNS under the title -->
            <ui:CardControl Padding="{StaticResource CardPadding}" Visibility="{Binding Network.NoNvidia, Converter={StaticResource BoolToVisibility}}">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="DeveloperBoard24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Net_NoNvidiaTitle}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Net_NoNvidiaText}" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>

            <!-- NVIDIA driver settings (global) -->
            <StackPanel Visibility="{Binding Network.HasNvidia, Converter={StaticResource BoolToVisibility}}">
                <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Net_NvidiaGlobal}" Margin="0,0,0,8" />
                <v:ItemList ItemsSource="{Binding Network.GpuTweaks}" ItemTemplate="{StaticResource TweakRow}" />

            </StackPanel>

            <!-- NVIDIA profiles per game, next to the global NVIDIA settings -->
            <StackPanel Visibility="{Binding Network.HasNvidia, Converter={StaticResource BoolToVisibility}}">
                <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Net_GameProfiles}" />
                <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Net_GameProfilesHint}" Margin="0,0,0,4" />
                <!-- Impact and tags are the same for every game: said once here instead of on each row -->
                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Network.GameProfilesFacts}" Margin="0,0,0,8"
                              Visibility="{Binding Network.GameProfilesFacts, Converter={StaticResource NullToVisibility}}" />
                <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Net_NoGames}" Visibility="{Binding Network.GameProfilesEmpty, Converter={StaticResource BoolToVisibility}}" />
                <ui:TextBox PlaceholderText="{l:Tr Net_GameSearch}" Icon="{ui:SymbolIcon Search20}" ClearButtonEnabled="True" Margin="0,0,0,8" Width="320" HorizontalAlignment="Left"
                            Text="{Binding Network.GameSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}" AutomationProperties.Name="{l:Tr Net_GameSearch}"
                            Visibility="{Binding Network.GameSearchVisible, Converter={StaticResource BoolToVisibility}}" />
                <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Net_NoGameMatch}" Visibility="{Binding Network.GameSearchEmpty, Converter={StaticResource BoolToVisibility}}" />
                <v:ItemList ItemsSource="{Binding Network.GameProfilesShown}" ItemTemplate="{StaticResource CompactTweakRow}" />
                <ui:Button Content="{Binding Network.ShowAllGamesText}" Icon="{ui:SymbolIcon ChevronDown20}" Appearance="Transparent" Margin="0,4,0,0"
                           Command="{Binding Network.ExpandGamesCommand}" Visibility="{Binding Network.ShowAllGamesText, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>

            <!-- DNS: one choice, since only one set of servers can be in use -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Net_Dns}" />
            <ui:CardControl Padding="{StaticResource CardPadding}">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Router24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Net_DnsServers}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                            <Run Text="{l:Tr Net_DnsInUse}" /><Run Text=" " /><Run Text="{Binding Network.CurrentDns, Mode=OneWay}" />
                        </ui:TextBlock>
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Net_DnsCustom}" Margin="0,4,0,0"
                                      Visibility="{Binding Network.DnsIsCustom, Converter={StaticResource BoolToVisibility}}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Net_DnsHint}" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{l:Tr Common_Details}" Appearance="Transparent" Command="{Binding Network.ShowDnsDetailsCommand}" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Network.DnsChoices}" SelectedItem="{Binding Network.SelectedDns}" DisplayMemberPath="Name" MinWidth="220" ToolTip="{Binding Network.CurrentDnsDetail}"
                              AutomationProperties.Name="{l:Tr Net_DnsServers}" IsEnabled="{Binding CanChange, Source={x:Static s:ChangeGate.Instance}}" />
                </StackPanel>
            </ui:CardControl>

            <!-- Icon column as in the DNS card above, so both titles start at the same place -->
            <ui:Card Padding="16,12" Margin="0,8,0,0">
                <DockPanel>
                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Gauge24" FontSize="24" Width="24" Margin="0,0,14,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="{l:Tr Net_RunBenchmark}" Icon="{ui:SymbolIcon Gauge20}" Command="{Binding Network.RunDnsBenchmarkCommand}"
                                   IsEnabled="{Binding Network.IsWorking, Converter={StaticResource InverseBool}}" />
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Net_Benchmark}" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Net_BenchmarkHint}" Margin="0,4,16,0" />
                        </StackPanel>
                    </DockPanel>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Network.BenchmarkStatus}" Margin="0,8,0,0" Visibility="{Binding Network.BenchmarkStatus, Converter={StaticResource NullToVisibility}}" />
                    <ui:Button Content="{Binding Network.FastestText}" Icon="{ui:SymbolIcon Checkmark20}" Margin="0,8,0,0" Command="{Binding Network.UseFastestCommand}"
                               Visibility="{Binding Network.FastestText, Converter={StaticResource NullToVisibility}}" />
                    <!-- Server and numbers as wide as their widest value in the list (shared sizes), the name takes the rest
                         and is cut with its full text in the tooltip: fixed widths cut the last columns off with the details pane open -->
                    <v:ItemList ItemsSource="{Binding Network.DnsResults}" Margin="0,8,0,0" Grid.IsSharedSizeScope="True">
                        <v:ItemList.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="80" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="DnsServer" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="DnsMedian" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="DnsBest" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="DnsAnswered" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock FontTypography="Body" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,16,0" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Server}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <ui:TextBlock Grid.Column="2" FontTypography="BodyStrong" Text="{Binding Median}" Margin="0,0,16,0" />
                                    <ui:TextBlock Grid.Column="3" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Best}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <ui:TextBlock Grid.Column="4" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Answered}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </v:ItemList.ItemTemplate>
                    </v:ItemList>
                </StackPanel>
                </DockPanel>
            </ui:Card>

            <!-- Device interrupts (Expert) -->
            <StackPanel Visibility="{Binding Network.ShowDeviceTweaks, Converter={StaticResource BoolToVisibility}}">
                <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Net_Devices}" />
                <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Net_DevicesHint}" Margin="0,0,0,4" />
                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Network.DeviceFacts}" Margin="0,0,0,8"
                              Visibility="{Binding Network.DeviceFacts, Converter={StaticResource NullToVisibility}}" />
                <v:ItemList ItemsSource="{Binding Network.DeviceTweaks}" ItemTemplate="{StaticResource CompactTweakRow}" />
            </StackPanel>

            <!-- This page holds DNS and the graphics driver: the other network settings are tweaks, and the repairs (flush DNS,
                 reset Winsock) are tools. The ways there, at the end as in Windows Settings (a link does not wrap, so in the
                 DNS card a narrow window cut them off). -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Net_Related}" />
            <StackPanel HorizontalAlignment="Left">
                <ui:HyperlinkButton Content="{l:Tr Net_TweaksLink}" Command="{Binding OpenTweaksNetworkCommand}" Padding="0" />
                <ui:HyperlinkButton Content="{l:Tr Net_FixesLink}" Command="{Binding OpenToolsFixesCommand}" Padding="0" Margin="0,8,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
