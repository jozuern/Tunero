<UserControl x:Class="Optimizer.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageRoot}">
            <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Settings_Title}" />
            <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Settings_Hint}" />

            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Settings_Appearance}" Margin="0,0,0,8" />
            <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="LocalLanguage24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <ui:TextBlock FontTypography="Body" Text="{l:Tr Settings_Language}" />
                </ui:CardControl.Header>
                <!-- A drop-down as in Windows Settings; each language in its own name -->
                <ComboBox x:Name="LanguageBox" MinWidth="200" SelectionChanged="Language_Changed" AutomationProperties.Name="{l:Tr Settings_Language}">
                    <ComboBoxItem Content="{l:Tr Lang_En}" Tag="en" />
                    <ComboBoxItem Content="{l:Tr Lang_De}" Tag="de" />
                </ComboBox>
            </ui:CardControl>
            <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="DarkTheme24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <ui:TextBlock FontTypography="Body" Text="{l:Tr Settings_Theme}" />
                </ui:CardControl.Header>
                <ComboBox x:Name="ThemeBox" MinWidth="200" SelectionChanged="Theme_Changed" AutomationProperties.Name="{l:Tr Settings_Theme}">
                    <ComboBoxItem Content="{l:Tr Theme_System}" Tag="System" />
                    <ComboBoxItem Content="{l:Tr Theme_Light}" Tag="Light" />
                    <ComboBoxItem Content="{l:Tr Theme_Dark}" Tag="Dark" />
                </ComboBox>
            </ui:CardControl>
            <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Search24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="Body" Text="{l:Tr StartMenu_Setting}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding StartMenuHint}" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch OnContent="{l:Tr Feature_On}" OffContent="{l:Tr Feature_Off}" AutomationProperties.Name="{l:Tr StartMenu_Setting}" IsChecked="{Binding StartMenuEntry}" IsEnabled="{Binding CanAddToStartMenu}" />
            </ui:CardControl>

            <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Code24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="Body" Text="{l:Tr Settings_Technical}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Settings_TechnicalHint}" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch OnContent="{l:Tr Feature_On}" OffContent="{l:Tr Feature_Off}" AutomationProperties.Name="{l:Tr Settings_Technical}" IsChecked="{Binding ShowTechnical}" />
            </ui:CardControl>

            <!-- The section names what Expert mode is about; the card itself is called Expert mode -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Settings_SectionTweaks}" />
            <ui:CardControl Padding="{StaticResource CardPadding}">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="Body" Text="{l:Tr Settings_Expert}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Settings_ExpertHint}" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch OnContent="{l:Tr Feature_On}" OffContent="{l:Tr Feature_Off}" AutomationProperties.Name="{l:Tr Settings_Expert}" IsChecked="{Binding ExpertMode}" />
            </ui:CardControl>
            <!-- A downloaded, signed copy that was not installed: the first start's setup again (MainViewModel.Setup) -->
            <ui:CardControl Padding="{StaticResource CardPadding}" Margin="0,4,0,0" Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Folder24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="Body" Text="{l:Tr Settings_Install}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Settings_InstallHint}" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{l:Tr Settings_InstallButton}" Command="{Binding OpenSetupCommand}" />
            </ui:CardControl>
            <!-- Opt-in: a scheduled task applies the changes Windows reset again after sign-in (ReapplyTask) -->
            <ui:CardControl Padding="{StaticResource CardPadding}" Margin="0,4,0,0">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="ArrowRepeatAll24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="Body" Text="{l:Tr Settings_Reapply}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding ReapplyHint}" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch OnContent="{l:Tr Feature_On}" OffContent="{l:Tr Feature_Off}" AutomationProperties.Name="{l:Tr Settings_Reapply}" IsChecked="{Binding ReapplyOn}">
                    <ui:ToggleSwitch.IsEnabled>
                        <MultiBinding Converter="{StaticResource AllTrue}">
                            <Binding Path="ReapplyAvailable" />
                            <Binding Path="CanChange" />
                        </MultiBinding>
                    </ui:ToggleSwitch.IsEnabled>
                </ui:ToggleSwitch>
            </ui:CardControl>

            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="VirusTotal" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Vt_SettingsHint}" Margin="0,0,0,8" />
            <ui:Card Padding="16,12">
                <StackPanel>
                    <WrapPanel>
                        <ui:PasswordBox x:Name="VtKey" PasswordChanged="VtKey_PasswordChanged" PlaceholderText="{l:Tr Vt_KeyPlaceholder}" AutomationProperties.Name="{l:Tr Vt_KeyPlaceholder}" MinWidth="320" Margin="0,0,8,0" />
                        <!-- Waits for a key: with an empty box it would do nothing -->
                        <ui:Button x:Name="SaveKeyButton" Content="{l:Tr Common_Save}" Click="SaveKey_Click" IsEnabled="False" Margin="0,0,8,0" />
                        <ui:Button Content="{l:Tr Common_Remove}" Appearance="Transparent" Click="RemoveKey_Click" Margin="0,0,8,0" IsEnabled="{Binding VirusTotalConfigured}" />
                        <ui:Button Content="{l:Tr Vt_GetKey}" Icon="{ui:SymbolIcon Open20}" Appearance="Transparent"
                                   Command="{Binding OpenLinkCommand}" CommandParameter="https://docs.virustotal.com/docs/please-give-me-an-api-key" />
                    </WrapPanel>
                    <!-- The saved key is visible at a glance: a check mark and a line, not only a faint caption -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding VirusTotalConfigured, Converter={StaticResource BoolToVisibility}}">
                        <ui:SymbolIcon Symbol="CheckmarkCircle16" Filled="True" FontSize="16" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0" />
                        <ui:TextBlock FontTypography="Body" Text="{l:Tr Vt_Configured}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Settings_Diagnostics}" />
            <ui:Card Padding="16,12">
                <StackPanel>
                    <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr Settings_Logs}" />
                    <DockPanel Margin="0,4,0,8">
                        <ui:HyperlinkButton DockPanel.Dock="Right" Content="{l:Tr Settings_ShowInFolder}" Padding="0" Margin="16,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding ShowInExplorerCommand}" CommandParameter="{Binding LogFile}" />
                        <TextBlock Style="{StaticResource Mono}" Text="{Binding LogFile}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr Settings_Data}" />
                    <DockPanel Margin="0,4,0,0">
                        <ui:HyperlinkButton DockPanel.Dock="Right" Content="{l:Tr Settings_OpenFolder}" Padding="0" Margin="16,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding ShowInExplorerCommand}" CommandParameter="{Binding DataFolder}" />
                        <TextBlock Style="{StaticResource Mono}" Text="{Binding DataFolder}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Settings_ReportShort}" ToolTip="{l:Tr Settings_ReportHint}" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,8,0,0">
                        <ui:Button Content="{l:Tr Settings_Report}" Icon="{ui:SymbolIcon Open20}" Command="{Binding ReportProblemCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="{l:Tr Settings_CopyLog}" Appearance="Transparent" Command="{Binding CopyLogCommand}" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>

            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Settings_Updates}" />
            <!-- The switch and the manual check in one card -->
            <ui:Card Padding="{StaticResource CardPadding}">
                <StackPanel>
                    <DockPanel>
                        <ui:ToggleSwitch OnContent="{l:Tr Feature_On}" OffContent="{l:Tr Feature_Off}" DockPanel.Dock="Right" AutomationProperties.Name="{l:Tr Update_AtStart}" IsChecked="{Binding CheckForUpdates}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <ui:SymbolIcon Symbol="ArrowSync20" FontSize="24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="{l:Tr Update_AtStart}" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Update_Hint}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel Margin="40,12,0,0">
                        <ui:Button Content="{l:Tr Update_CheckNow}" Command="{Binding CheckUpdatesNowCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="{l:Tr Update_Install}" Icon="{ui:SymbolIcon ArrowDownload20}" Appearance="Primary" Command="{Binding UpdateNowCommand}" Margin="0,0,8,0"
                                   Visibility="{Binding CanUpdateInApp, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="{l:Tr Update_Open}" Icon="{ui:SymbolIcon Open20}" Command="{Binding OpenReleasePageCommand}" Margin="0,0,8,0"
                                   Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}" />
                        <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding UpdateStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>

            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Settings_Uninstall}" />
            <ui:CardControl Padding="{StaticResource CardPadding}">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Delete24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="Body" Text="{l:Tr Uninstall_Setting}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Uninstall_Hint}" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{l:Tr Uninstall_Button}" Command="{Binding UninstallCommand}" IsEnabled="{Binding CanUninstall}" />
            </ui:CardControl>

            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Settings_About}" />
            <ui:Card Padding="16,12">
                <StackPanel>
                    <ui:TextBlock FontTypography="Body" Text="{Binding AboutText}" TextWrapping="Wrap" />
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr About_License}" Margin="0,4,0,0" />
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr About_Shortcuts}" Margin="0,4,0,0" />
                    <WrapPanel Margin="0,12,0,0">
                        <ui:Button Content="{l:Tr About_Licenses}" Icon="{ui:SymbolIcon DocumentText20}" Click="Licenses_Click" Margin="0,0,8,0" />
                        <ui:Button Content="{l:Tr About_Privacy}" Icon="{ui:SymbolIcon ShieldCheckmark20}" Appearance="Transparent"
                                   Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/jozuern/Tunero/blob/main/docs/PRIVACY.md" Margin="0,0,8,0" />
                        <ui:Button Content="{l:Tr About_Source}" Icon="{ui:SymbolIcon Code20}" Appearance="Transparent"
                                   Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/jozuern/Tunero" Margin="0,0,8,0" />
                        <!-- Donations: one quiet link here, nowhere else in the app. -->
                        <ui:Button Content="{l:Tr About_Support}" Icon="{ui:SymbolIcon Heart20}" Appearance="Transparent"
                                   Command="{Binding OpenLinkCommand}" CommandParameter="https://ko-fi.com/jozuern" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
