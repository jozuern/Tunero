<UserControl x:Class="Optimizer.App.Views.InstallMediaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:v="clr-namespace:Optimizer.App.Views"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- Four steps from top to bottom: where Windows comes from, the edition, the changes, the build -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageRoot}">
            <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Media_Title}" />
            <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Media_Intro}" />

            <!-- 1. Source -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Media_SourceTitle}" Margin="0,0,0,8" />
            <ui:Card Padding="16,12" Margin="{StaticResource CardRowMargin}" IsEnabled="{Binding InstallMedia.CanEdit}">
                <StackPanel>
                    <!-- With 4 px padding the label starts 32 px in, where the hint and the options below line up -->
                    <RadioButton GroupName="MediaSource" Padding="4,0,0,0" Content="{l:Tr Media_UseDownload}" IsChecked="{Binding InstallMedia.UseDownload}" />
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_UseDownloadHint}" Margin="32,0,0,0" />
                    <StackPanel Margin="32,8,0,0" Visibility="{Binding InstallMedia.UseDownload, Converter={StaticResource BoolToVisibility}}">
                        <WrapPanel>
                            <ui:Button Content="{l:Tr Media_CheckCatalog}" Icon="{ui:SymbolIcon ArrowSync20}" Command="{Binding InstallMedia.CheckCatalogCommand}"
                                       IsEnabled="{Binding InstallMedia.IsCheckingCatalog, Converter={StaticResource InverseBool}}" Margin="0,0,12,0" />
                            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Visibility="{Binding InstallMedia.IsCheckingCatalog, Converter={StaticResource BoolToVisibility}}" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding InstallMedia.CatalogStep}" VerticalAlignment="Center"
                                          Visibility="{Binding InstallMedia.CatalogStep, Converter={StaticResource NullToVisibility}}" />
                        </WrapPanel>
                        <ui:InfoBar Title="" Message="{Binding InstallMedia.CatalogError}" Severity="Warning" IsClosable="False" Margin="0,8,0,0"
                                    IsOpen="{Binding InstallMedia.CatalogError, Converter={StaticResource NullToBool}}" />
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding InstallMedia.HasCatalog, Converter={StaticResource BoolToVisibility}}">
                            <ui:TextBlock FontTypography="Body" Text="{Binding InstallMedia.CatalogText}" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,8,0,0">
                                <ui:TextBlock FontTypography="Body" Text="{l:Tr Media_Language}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ComboBox ItemsSource="{Binding InstallMedia.Languages}" SelectedItem="{Binding InstallMedia.Language}" DisplayMemberPath="Text"
                                          MinWidth="240" AutomationProperties.Name="{l:Tr Media_Language}" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>

                    <RadioButton GroupName="MediaSource" Padding="4,0,0,0" Content="{l:Tr Media_UseIso}" IsChecked="{Binding InstallMedia.UseIso}" Margin="0,16,0,0" />
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_UseIsoHint}" Margin="32,0,0,0" />
                    <StackPanel Margin="32,8,0,0" Visibility="{Binding InstallMedia.UseIso, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Left" Content="{l:Tr Media_PickIso}" Icon="{ui:SymbolIcon FolderOpen20}" Command="{Binding InstallMedia.PickIsoCommand}" Margin="0,0,12,0" />
                            <ui:ProgressRing DockPanel.Dock="Right" IsIndeterminate="True" Width="16" Height="16" Margin="8,0,0,0" VerticalAlignment="Center"
                                             Visibility="{Binding InstallMedia.IsReadingIso, Converter={StaticResource BoolToVisibility}}" />
                            <ui:TextBlock FontTypography="Body" Text="{Binding InstallMedia.IsoPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstallMedia.IsoPath}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ui:TextBlock FontTypography="Body" Text="{Binding InstallMedia.IsoText}" TextWrapping="Wrap" Margin="0,12,0,0"
                                      Visibility="{Binding InstallMedia.IsoText, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                    <ui:InfoBar Title="" Message="{Binding InstallMedia.ArchitectureNote}" Severity="Informational" IsClosable="False" Margin="0,12,0,0"
                                IsOpen="{Binding InstallMedia.ArchitectureNote, Converter={StaticResource NullToBool}}" />
                </StackPanel>
            </ui:Card>

            <!-- 2. Edition -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Media_EditionTitle}" />
            <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}" IsEnabled="{Binding InstallMedia.CanEdit}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_Edition}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_EditionHint}" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox ItemsSource="{Binding InstallMedia.Editions}" SelectedItem="{Binding InstallMedia.Edition}" DisplayMemberPath="Text"
                          MinWidth="240" AutomationProperties.Name="{l:Tr Media_Edition}" />
            </ui:CardControl>

            <!-- 3. Changes: each a switch, its options folded below -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Media_ChangesTitle}" />
            <ui:CardExpander Margin="{StaticResource CardRowMargin}" HorizontalContentAlignment="Stretch" IsExpanded="{Binding InstallMedia.ExpandOptions, Mode=OneWay}" IsEnabled="{Binding InstallMedia.CanEdit}">
                <ui:CardExpander.Header>
                    <DockPanel Margin="0,4">
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding InstallMedia.RemoveApps}" AutomationProperties.Name="{l:Tr Media_RemoveAppsTitle}" Margin="16,0,12,0" />
                        <ui:TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding InstallMedia.AppsSummary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_RemoveAppsTitle}" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_RemoveAppsText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </ui:CardExpander.Header>
                <StackPanel IsEnabled="{Binding InstallMedia.RemoveApps}">
                    <!-- Where the list comes from: what a Microsoft image can hold, or what the own ISO's edition holds (read with DISM) -->
                    <DockPanel Margin="0,0,0,8">
                        <ui:ProgressRing DockPanel.Dock="Left" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                         Visibility="{Binding InstallMedia.IsReadingApps, Converter={StaticResource BoolToVisibility}}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding InstallMedia.AppsSourceText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <v:ItemList ItemsSource="{Binding InstallMedia.AppGroups}" IsEnabled="{Binding InstallMedia.IsReadingApps, Converter={StaticResource InverseBool}}">
                        <v:ItemList.ItemTemplate>
                            <DataTemplate>
                                <!-- One fold per group of the list; the preticked group starts open. The check box ticks the whole group. -->
                                <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,4" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}">
                                    <Expander.Header>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding AllChecked}" MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding AllCheckedLabel}" ToolTip="{Binding AllCheckedLabel}" />
                                            <ui:TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding Summary}" VerticalAlignment="Center" Margin="16,0,8,0" />
                                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Expander.Header>
                                    <v:ItemList ItemsSource="{Binding Rows}">
                                        <v:ItemList.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsChecked}" Margin="0,4" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Note}">
                                                    <StackPanel>
                                                        <ui:TextBlock FontTypography="Body" Text="{Binding Title}" />
                                                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Text}" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </v:ItemList.ItemTemplate>
                                    </v:ItemList>
                                </Expander>
                            </DataTemplate>
                        </v:ItemList.ItemTemplate>
                    </v:ItemList>
                </StackPanel>
            </ui:CardExpander>

            <ui:CardExpander Margin="{StaticResource CardRowMargin}" HorizontalContentAlignment="Stretch" IsExpanded="{Binding InstallMedia.ExpandOptions, Mode=OneWay}" IsEnabled="{Binding InstallMedia.CanEdit}">
                <ui:CardExpander.Header>
                    <DockPanel Margin="0,4">
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding InstallMedia.SkipSetup}" AutomationProperties.Name="{l:Tr Media_SkipSetupTitle}" Margin="16,0,12,0" />
                        <ui:TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding InstallMedia.SetupSummary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_SkipSetupTitle}" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_SkipSetupText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </ui:CardExpander.Header>
                <Grid IsEnabled="{Binding InstallMedia.SkipSetup}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="{l:Tr Media_AccountName}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding InstallMedia.AccountNameText, UpdateSourceTrigger=PropertyChanged}" MaxWidth="320" HorizontalAlignment="Left" MinWidth="240"
                                AutomationProperties.Name="{l:Tr Media_AccountName}" />
                    <ui:TextBlock Grid.Row="1" Grid.Column="1" FontTypography="Caption" Text="{Binding InstallMedia.AccountProblem}" TextWrapping="Wrap" Margin="0,4,0,0"
                                  Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="{Binding InstallMedia.AccountProblem, Converter={StaticResource NullToVisibility}}" />
                    <ui:TextBlock Grid.Row="2" FontTypography="Body" Text="{l:Tr Media_Region}" VerticalAlignment="Center" Margin="0,12,16,0" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding InstallMedia.Regions}" SelectedItem="{Binding InstallMedia.Region}" DisplayMemberPath="Text"
                              MinWidth="240" HorizontalAlignment="Left" Margin="0,12,0,0" AutomationProperties.Name="{l:Tr Media_Region}">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>
                    <ui:TextBlock Grid.Row="3" FontTypography="Body" Text="{l:Tr Media_Keyboard}" VerticalAlignment="Center" Margin="0,12,16,0" />
                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding InstallMedia.Keyboards}" SelectedItem="{Binding InstallMedia.Keyboard}" DisplayMemberPath="Text"
                              MinWidth="240" HorizontalAlignment="Left" Margin="0,12,0,0" AutomationProperties.Name="{l:Tr Media_Keyboard}">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>
                    <ui:TextBlock Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource Caption}" Text="{l:Tr Media_RegionNote}" Margin="0,12,0,0" />
                </Grid>
            </ui:CardExpander>

            <ui:CardExpander Margin="{StaticResource CardRowMargin}" HorizontalContentAlignment="Stretch" IsExpanded="{Binding InstallMedia.ExpandOptions, Mode=OneWay}" IsEnabled="{Binding InstallMedia.CanEdit}">
                <ui:CardExpander.Header>
                    <DockPanel Margin="0,4">
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding InstallMedia.ApplyProfile}" IsEnabled="{Binding InstallMedia.CanApplyProfile}"
                                         AutomationProperties.Name="{l:Tr Media_ProfileTitle}" Margin="16,0,12,0" />
                        <ui:TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding InstallMedia.ProfileSummary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_ProfileTitle}" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_ProfileText}" Margin="0,4,0,0" />
                            <ui:TextBlock FontTypography="Caption" Text="{Binding InstallMedia.ProfileNote}" TextWrapping="Wrap" Margin="0,4,0,0"
                                          Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="{Binding InstallMedia.ProfileNote, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                </ui:CardExpander.Header>
                <WrapPanel IsEnabled="{Binding InstallMedia.ApplyProfile}">
                    <ui:TextBlock FontTypography="Body" Text="{l:Tr Media_Profile}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <ComboBox ItemsSource="{Binding InstallMedia.Profiles}" SelectedItem="{Binding InstallMedia.Profile}" DisplayMemberPath="Text"
                              MinWidth="240" AutomationProperties.Name="{l:Tr Media_Profile}" />
                </WrapPanel>
            </ui:CardExpander>

            <!-- Apps the copied Tunero installs with winget at the first sign-in: needs the profile card's Tunero copy -->
            <ui:CardExpander Margin="{StaticResource CardRowMargin}" HorizontalContentAlignment="Stretch" IsExpanded="{Binding InstallMedia.ExpandOptions, Mode=OneWay}" IsEnabled="{Binding InstallMedia.CanEdit}">
                <ui:CardExpander.Header>
                    <DockPanel Margin="0,4">
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding InstallMedia.InstallApps}" IsEnabled="{Binding InstallMedia.CanInstallApps}"
                                         AutomationProperties.Name="{l:Tr Media_InstallTitle}" Margin="16,0,12,0" />
                        <ui:TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding InstallMedia.InstallSummary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_InstallTitle}" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_InstallText}" Margin="0,4,0,0" />
                            <ui:TextBlock FontTypography="Caption" Text="{Binding InstallMedia.InstallNote}" TextWrapping="Wrap" Margin="0,4,0,0"
                                          Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="{Binding InstallMedia.InstallNote, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                </ui:CardExpander.Header>
                <v:ItemList ItemsSource="{Binding InstallMedia.InstallGroups}">
                    <v:ItemList.IsEnabled>
                        <MultiBinding Converter="{StaticResource AllTrue}">
                            <Binding Path="InstallMedia.InstallApps" />
                            <Binding Path="InstallMedia.CanInstallApps" />
                        </MultiBinding>
                    </v:ItemList.IsEnabled>
                    <v:ItemList.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,4" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}">
                                <Expander.Header>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding AllChecked}" MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{Binding AllCheckedLabel}" ToolTip="{Binding AllCheckedLabel}" />
                                        <ui:TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding Summary}" VerticalAlignment="Center" Margin="16,0,8,0" />
                                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Expander.Header>
                                <v:ItemList ItemsSource="{Binding Rows}">
                                    <v:ItemList.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked}" Margin="0,4" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Note}">
                                                <StackPanel>
                                                    <ui:TextBlock FontTypography="Body" Text="{Binding Title}" />
                                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Text}" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </v:ItemList.ItemTemplate>
                                </v:ItemList>
                            </Expander>
                        </DataTemplate>
                    </v:ItemList.ItemTemplate>
                </v:ItemList>
            </ui:CardExpander>

            <!-- Expert: changes that need knowing what they do -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Media_ExpertTitle}" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_ExpertText}" Margin="0,0,0,8" />
            <ui:CardExpander Margin="{StaticResource CardRowMargin}" HorizontalContentAlignment="Stretch" IsExpanded="{Binding InstallMedia.ExpandOptions, Mode=OneWay}" IsEnabled="{Binding InstallMedia.CanEdit}">
                <ui:CardExpander.Header>
                    <DockPanel Margin="0,4">
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding InstallMedia.RemoveUnreviewed}" IsEnabled="{Binding InstallMedia.UseIso}"
                                         AutomationProperties.Name="{l:Tr Media_UnreviewedTitle}" Margin="16,0,12,0" />
                        <ui:TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding InstallMedia.UnreviewedSummary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Warning24" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_UnreviewedTitle}" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_UnreviewedText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </ui:CardExpander.Header>
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding InstallMedia.UnreviewedSourceText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <v:ItemList ItemsSource="{Binding InstallMedia.UnreviewedRows}" IsEnabled="{Binding InstallMedia.RemoveUnreviewed}">
                        <v:ItemList.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked}" Margin="0,4" AutomationProperties.Name="{Binding Title}">
                                    <StackPanel>
                                        <ui:TextBlock FontTypography="Body" Text="{Binding Title}" />
                                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Text}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </v:ItemList.ItemTemplate>
                    </v:ItemList>
                </StackPanel>
            </ui:CardExpander>

            <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}" IsEnabled="{Binding InstallMedia.CanEdit}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <WrapPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_UnsupportedTitle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border Style="{StaticResource TagBorder}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                                <TextBlock Text="{l:Tr Media_PreviewTag}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>
                        </WrapPanel>
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_UnsupportedText}" Margin="0,4,0,0" />
                        <WrapPanel Margin="0,4,0,0">
                            <ui:HyperlinkButton Content="{l:Tr Media_UnsupportedSourceSupport}" Padding="0" Margin="0,0,16,0" Command="{Binding OpenLinkCommand}"
                                                CommandParameter="https://support.microsoft.com/windows/installing-windows-11-on-devices-that-don-t-meet-minimum-system-requirements-0b2dc4a2-5933-4ad4-9c09-ef0a331518f1" />
                            <ui:HyperlinkButton Content="{l:Tr Media_UnsupportedSourceSpecs}" Padding="0" Command="{Binding OpenLinkCommand}"
                                                CommandParameter="https://www.microsoft.com/windows/windows-11-specifications" />
                        </WrapPanel>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding InstallMedia.AllowUnsupported}" AutomationProperties.Name="{l:Tr Media_UnsupportedTitle}" />
            </ui:CardControl>

            <!-- 4. Build -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Media_BuildTitle}" />
            <ui:Card Padding="16,12" Margin="{StaticResource CardRowMargin}">
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_Output}" />
                    <DockPanel Margin="0,8,0,0">
                        <ui:Button DockPanel.Dock="Right" Content="{l:Tr Media_PickOutput}" Icon="{ui:SymbolIcon Folder20}" Command="{Binding InstallMedia.PickOutputCommand}" IsEnabled="{Binding InstallMedia.CanEdit}" Margin="12,0,0,0" />
                        <ui:TextBlock FontTypography="Body" Text="{Binding InstallMedia.OutputPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstallMedia.OutputPath}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding InstallMedia.NeededText}" Margin="0,8,0,0"
                                  Visibility="{Binding InstallMedia.NeededText, Converter={StaticResource NullToVisibility}}" />
                    <!-- Room for a later choice of boot files; today the media keeps the source's own, which are Microsoft's only for the download -->
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_SecureBootNote}" Margin="0,4,0,0"
                                  Visibility="{Binding InstallMedia.UseDownload, Converter={StaticResource BoolToVisibility}}" />
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_UpgradeNote}" Margin="0,4,0,0" />
                    <WrapPanel Margin="0,16,0,0">
                        <ui:Button Appearance="Primary" Content="{l:Tr Media_BuildButton}" Icon="{ui:SymbolIcon Play20}" Command="{Binding InstallMedia.BuildCommand}" Margin="0,0,12,0" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding InstallMedia.BuildNote}" VerticalAlignment="Center"
                                      Visibility="{Binding InstallMedia.BuildNote, Converter={StaticResource NullToVisibility}}" />
                    </WrapPanel>
                    <ui:InfoBar Title="" Message="{Binding InstallMedia.ResultText}" Severity="{Binding InstallMedia.ResultSeverity}" IsClosable="False" Margin="0,16,0,0"
                                IsOpen="{Binding InstallMedia.HasResult}" />
                    <WrapPanel Margin="0,8,0,0">
                        <ui:Button Content="{l:Tr Media_OpenFolder}" Icon="{ui:SymbolIcon FolderOpen20}" Command="{Binding InstallMedia.OpenFolderCommand}" Margin="0,0,8,0"
                                   Visibility="{Binding InstallMedia.ResultIso, Converter={StaticResource NullToVisibility}}" />
                        <ui:Button Content="{l:Tr Media_OpenLog}" Icon="{ui:SymbolIcon DocumentText20}" Command="{Binding InstallMedia.OpenLogCommand}"
                                   Visibility="{Binding InstallMedia.ResultLogPath, Converter={StaticResource NullToVisibility}}" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
