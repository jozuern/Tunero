<UserControl x:Class="Optimizer.App.Views.InstallMediaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:v="clr-namespace:Optimizer.App.Views"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <!-- The 24 px symbol left of a card's title (docked left in the cards' DockPanel) -->
        <Style x:Key="MediaCardIcon" TargetType="ui:SymbolIcon">
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <!-- The page scrolls; the summary bar with Build stays below it. Four steps from top to bottom: where Windows comes from, the edition, the changes, the build -->
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageRoot}">
            <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Media_Title}" />
            <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Media_Intro}" />

            <!-- 1. Source -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Media_SourceTitle}" Margin="0,0,0,8" />
            <ui:Card Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}" IsEnabled="{Binding InstallMedia.CanEdit}">
                <DockPanel>
                <ui:SymbolIcon Style="{StaticResource MediaCardIcon}" Symbol="CloudArrowDown24" VerticalAlignment="Top" Margin="0,2,16,0" />
                <StackPanel>
                    <!-- With 4 px padding the label starts 32 px in, where the hint and the options below line up -->
                    <RadioButton GroupName="MediaSource" Padding="4,0,0,0" Content="{l:Tr Media_UseDownload}" IsChecked="{Binding InstallMedia.UseDownload}" />
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_UseDownloadHint}" Margin="32,0,0,0" />
                    <StackPanel Margin="32,8,0,0" Visibility="{Binding InstallMedia.UseDownload, Converter={StaticResource BoolToVisibility}}">
                        <WrapPanel>
                            <ui:Button Content="{l:Tr Media_CheckCatalog}" Icon="{ui:SymbolIcon ArrowSync20}" Command="{Binding InstallMedia.CheckCatalogCommand}"
                                       IsEnabled="{Binding InstallMedia.IsCheckingCatalog, Converter={StaticResource InverseBool}}" Margin="0,0,12,0" />
                            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Visibility="{Binding InstallMedia.IsCheckingCatalog, Converter={StaticResource BoolToVisibility}}" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding InstallMedia.CatalogStep}" VerticalAlignment="Center"
                                          Visibility="{Binding InstallMedia.CatalogStep, Converter={StaticResource NullToVisibility}}" />
                        </WrapPanel>
                        <ui:InfoBar Title="" Message="{Binding InstallMedia.CatalogError}" Severity="Warning" IsClosable="False" Margin="0,8,0,0"
                                    IsOpen="{Binding InstallMedia.CatalogError, Converter={StaticResource NullToBool}}" />
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding InstallMedia.HasCatalog, Converter={StaticResource BoolToVisibility}}">
                            <ui:TextBlock FontTypography="Body" Text="{Binding InstallMedia.CatalogText}" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,8,0,0">
                                <ui:TextBlock FontTypography="Body" Text="{l:Tr Media_Language}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ComboBox ItemsSource="{Binding InstallMedia.Languages}" SelectedItem="{Binding InstallMedia.Language}" DisplayMemberPath="Text"
                                          MinWidth="240" AutomationProperties.Name="{l:Tr Media_Language}" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>

                    <RadioButton GroupName="MediaSource" Padding="4,0,0,0" Content="{l:Tr Media_UseIso}" IsChecked="{Binding InstallMedia.UseIso}" Margin="0,16,0,0" />
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_UseIsoHint}" Margin="32,0,0,0" />
                    <StackPanel Margin="32,8,0,0" Visibility="{Binding InstallMedia.UseIso, Converter={StaticResource BoolToVisibility}}">
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_UseIsoDetail}" Margin="0,0,0,8" />
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Left" Content="{l:Tr Media_PickIso}" Icon="{ui:SymbolIcon FolderOpen20}" Command="{Binding InstallMedia.PickIsoCommand}" Margin="0,0,12,0" />
                            <ui:ProgressRing DockPanel.Dock="Right" IsIndeterminate="True" Width="16" Height="16" Margin="8,0,0,0" VerticalAlignment="Center"
                                             Visibility="{Binding InstallMedia.IsReadingIso, Converter={StaticResource BoolToVisibility}}" />
                            <ui:TextBlock FontTypography="Body" Text="{Binding InstallMedia.IsoPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstallMedia.IsoPath}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ui:TextBlock FontTypography="Body" Text="{Binding InstallMedia.IsoText}" TextWrapping="Wrap" Margin="0,12,0,0"
                                      Visibility="{Binding InstallMedia.IsoText, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                    <ui:InfoBar Title="" Message="{Binding InstallMedia.ArchitectureNote}" Severity="Informational" IsClosable="False" Margin="0,12,0,0"
                                IsOpen="{Binding InstallMedia.ArchitectureNote, Converter={StaticResource NullToBool}}" />
                </StackPanel>
                </DockPanel>
            </ui:Card>

            <!-- 2. Edition -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Media_EditionTitle}" />
            <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}" IsEnabled="{Binding InstallMedia.CanEdit}">
                <ui:CardControl.Header>
                    <DockPanel>
                        <ui:SymbolIcon Style="{StaticResource MediaCardIcon}" Symbol="Desktop24" />
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_Edition}" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_EditionHint}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </ui:CardControl.Header>
                <ComboBox ItemsSource="{Binding InstallMedia.Editions}" SelectedItem="{Binding InstallMedia.Edition}" DisplayMemberPath="Text"
                          MinWidth="240" AutomationProperties.Name="{l:Tr Media_Edition}" />
            </ui:CardControl>

            <!-- 3. Changes: each a switch, its options folded below. No On or Off next to these switches: the summary left of
                 each says what is on ("Apps to remove: 18") or Off (XamlRulesTests.SwitchesSayWhatTheyShow allow list). -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Media_ChangesTitle}" />
            <ui:CardExpander Margin="{StaticResource CardRowMargin}" HorizontalContentAlignment="Stretch" IsExpanded="{Binding InstallMedia.ExpandOptions, Mode=OneWay}" IsEnabled="{Binding InstallMedia.CanEdit}">
                <ui:CardExpander.Header>
                    <DockPanel Margin="0,4">
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding InstallMedia.RemoveApps}" AutomationProperties.Name="{l:Tr Media_RemoveAppsTitle}" Margin="16,0,12,0" />
                        <ui:TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding InstallMedia.AppsSummary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <ui:SymbolIcon Style="{StaticResource MediaCardIcon}" Symbol="Apps24" />
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_RemoveAppsTitle}" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_RemoveAppsText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </ui:CardExpander.Header>
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_RemoveAppsDetail}" Margin="0,0,0,8" />
                    <StackPanel IsEnabled="{Binding InstallMedia.RemoveApps}">
                        <!-- Where the list comes from: what a Microsoft image can hold, or what the own ISO's edition holds (read with DISM) -->
                        <DockPanel Margin="0,0,0,8">
                            <ui:ProgressRing DockPanel.Dock="Left" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Visibility="{Binding InstallMedia.IsReadingApps, Converter={StaticResource BoolToVisibility}}" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding InstallMedia.AppsSourceText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <v:ItemList ItemsSource="{Binding InstallMedia.AppGroups}" IsEnabled="{Binding InstallMedia.IsReadingApps, Converter={StaticResource InverseBool}}">
                            <v:ItemList.ItemTemplate>
                                <DataTemplate>
                                    <!-- One fold per group of the list; the preticked group starts open. The check box ticks the whole group. -->
                                    <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,4" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}">
                                        <Expander.Header>
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding AllChecked}" MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Center"
                                                          AutomationProperties.Name="{Binding AllCheckedLabel}" ToolTip="{Binding AllCheckedLabel}" />
                                                <ui:TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding Summary}" VerticalAlignment="Center" Margin="16,0,8,0" />
                                                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Expander.Header>
                                        <v:ItemList ItemsSource="{Binding Rows}">
                                            <v:ItemList.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsChecked}" Margin="0,4" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Note}">
                                                        <StackPanel>
                                                            <ui:TextBlock FontTypography="Body" Text="{Binding Title}" />
                                                            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Text}" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </v:ItemList.ItemTemplate>
                                        </v:ItemList>
                                    </Expander>
                                </DataTemplate>
                            </v:ItemList.ItemTemplate>
                        </v:ItemList>
                    </StackPanel>
                </StackPanel>
            </ui:CardExpander>

            <!-- Optional Windows parts (WordPad, speech data, Recall ...): off, none ticked -->
            <ui:CardExpander Margin="{StaticResource CardRowMargin}" HorizontalContentAlignment="Stretch" IsExpanded="{Binding InstallMedia.ExpandOptions, Mode=OneWay}" IsEnabled="{Binding InstallMedia.CanEdit}">
                <ui:CardExpander.Header>
                    <DockPanel Margin="0,4">
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding InstallMedia.RemoveParts}" AutomationProperties.Name="{l:Tr Media_PartsTitle}" Margin="16,0,12,0" />
                        <ui:TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding InstallMedia.PartsSummary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <ui:SymbolIcon Style="{StaticResource MediaCardIcon}" Symbol="PuzzlePiece24" />
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_PartsTitle}" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_PartsText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </ui:CardExpander.Header>
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_PartsDetail}" Margin="0,0,0,8" />
                    <v:ItemList ItemsSource="{Binding InstallMedia.PartRows}" IsEnabled="{Binding InstallMedia.RemoveParts}">
                        <v:ItemList.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked}" Margin="0,4" AutomationProperties.Name="{Binding Title}">
                                    <StackPanel>
                                        <ui:TextBlock FontTypography="Body" Text="{Binding Title}" />
                                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Text}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </v:ItemList.ItemTemplate>
                    </v:ItemList>
                </StackPanel>
            </ui:CardExpander>

            <ui:CardExpander Margin="{StaticResource CardRowMargin}" HorizontalContentAlignment="Stretch" IsExpanded="{Binding InstallMedia.ExpandOptions, Mode=OneWay}" IsEnabled="{Binding InstallMedia.CanEdit}">
                <ui:CardExpander.Header>
                    <DockPanel Margin="0,4">
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding InstallMedia.SkipSetup}" AutomationProperties.Name="{l:Tr Media_SkipSetupTitle}" Margin="16,0,12,0" />
                        <ui:TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding InstallMedia.SetupSummary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <ui:SymbolIcon Style="{StaticResource MediaCardIcon}" Symbol="Person24" />
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_SkipSetupTitle}" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_SkipSetupText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </ui:CardExpander.Header>
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_SkipSetupDetail}" Margin="0,0,0,12" />
                    <Grid IsEnabled="{Binding InstallMedia.SkipSetup}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="{l:Tr Media_AccountName}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding InstallMedia.AccountNameText, UpdateSourceTrigger=PropertyChanged}" MaxWidth="320" HorizontalAlignment="Left" MinWidth="240"
                                    AutomationProperties.Name="{l:Tr Media_AccountName}" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="1" FontTypography="Caption" Text="{Binding InstallMedia.AccountProblem}" TextWrapping="Wrap" Margin="0,4,0,0"
                                      Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="{Binding InstallMedia.AccountProblem, Converter={StaticResource NullToVisibility}}" />
                        <ui:TextBlock Grid.Row="2" FontTypography="Body" Text="{l:Tr Media_Region}" VerticalAlignment="Center" Margin="0,12,16,0" />
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding InstallMedia.Regions}" SelectedItem="{Binding InstallMedia.Region}" DisplayMemberPath="Text"
                                  MinWidth="240" HorizontalAlignment="Left" Margin="0,12,0,0" AutomationProperties.Name="{l:Tr Media_Region}">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                        <ui:TextBlock Grid.Row="3" FontTypography="Body" Text="{l:Tr Media_Keyboard}" VerticalAlignment="Center" Margin="0,12,16,0" />
                        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding InstallMedia.Keyboards}" SelectedItem="{Binding InstallMedia.Keyboard}" DisplayMemberPath="Text"
                                  MinWidth="240" HorizontalAlignment="Left" Margin="0,12,0,0" AutomationProperties.Name="{l:Tr Media_Keyboard}">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                        <ui:TextBlock Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource Caption}" Text="{l:Tr Media_RegionNote}" Margin="0,12,0,0" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <ui:CardExpander Margin="{StaticResource CardRowMargin}" HorizontalContentAlignment="Stretch" IsExpanded="{Binding InstallMedia.ExpandOptions, Mode=OneWay}" IsEnabled="{Binding InstallMedia.CanEdit}">
                <ui:CardExpander.Header>
                    <DockPanel Margin="0,4">
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding InstallMedia.ApplyProfile}" IsEnabled="{Binding InstallMedia.CanApplyProfile}"
                                         AutomationProperties.Name="{l:Tr Media_ProfileTitle}" Margin="16,0,12,0" />
                        <ui:TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding InstallMedia.ProfileSummary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <ui:SymbolIcon Style="{StaticResource MediaCardIcon}" Symbol="Sparkle24" />
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_ProfileTitle}" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_ProfileText}" Margin="0,4,0,0" />
                            <ui:TextBlock FontTypography="Caption" Text="{Binding InstallMedia.ProfileNote}" TextWrapping="Wrap" Margin="0,4,0,0"
                                          Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="{Binding InstallMedia.ProfileNote, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                </ui:CardExpander.Header>
                <WrapPanel IsEnabled="{Binding InstallMedia.ApplyProfile}">
                    <ui:TextBlock FontTypography="Body" Text="{l:Tr Media_Profile}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <ComboBox ItemsSource="{Binding InstallMedia.Profiles}" SelectedItem="{Binding InstallMedia.Profile}" DisplayMemberPath="Text"
                              MinWidth="240" AutomationProperties.Name="{l:Tr Media_Profile}" />
                </WrapPanel>
            </ui:CardExpander>

            <!-- Apps the copied Tunero installs with winget at the first sign-in: needs the profile card's Tunero copy -->
            <ui:CardExpander Margin="{StaticResource CardRowMargin}" HorizontalContentAlignment="Stretch" IsExpanded="{Binding InstallMedia.ExpandOptions, Mode=OneWay}" IsEnabled="{Binding InstallMedia.CanEdit}">
                <ui:CardExpander.Header>
                    <DockPanel Margin="0,4">
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding InstallMedia.InstallApps}" IsEnabled="{Binding InstallMedia.CanInstallApps}"
                                         AutomationProperties.Name="{l:Tr Media_InstallTitle}" Margin="16,0,12,0" />
                        <ui:TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding InstallMedia.InstallSummary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <ui:SymbolIcon Style="{StaticResource MediaCardIcon}" Symbol="Box24" />
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_InstallTitle}" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_InstallText}" Margin="0,4,0,0" />
                            <ui:TextBlock FontTypography="Caption" Text="{Binding InstallMedia.InstallNote}" TextWrapping="Wrap" Margin="0,4,0,0"
                                          Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="{Binding InstallMedia.InstallNote, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                </ui:CardExpander.Header>
                <v:ItemList ItemsSource="{Binding InstallMedia.InstallGroups}">
                    <v:ItemList.IsEnabled>
                        <MultiBinding Converter="{StaticResource AllTrue}">
                            <Binding Path="InstallMedia.InstallApps" />
                            <Binding Path="InstallMedia.CanInstallApps" />
                        </MultiBinding>
                    </v:ItemList.IsEnabled>
                    <v:ItemList.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,4" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}">
                                <Expander.Header>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding AllChecked}" MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{Binding AllCheckedLabel}" ToolTip="{Binding AllCheckedLabel}" />
                                        <ui:TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding Summary}" VerticalAlignment="Center" Margin="16,0,8,0" />
                                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Expander.Header>
                                <v:ItemList ItemsSource="{Binding Rows}">
                                    <v:ItemList.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked}" Margin="0,4" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Note}">
                                                <StackPanel>
                                                    <ui:TextBlock FontTypography="Body" Text="{Binding Title}" />
                                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Text}" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </v:ItemList.ItemTemplate>
                                </v:ItemList>
                            </Expander>
                        </DataTemplate>
                    </v:ItemList.ItemTemplate>
                </v:ItemList>
            </ui:CardExpander>

            <!-- How Windows is stored on the media: two choices, no switch -->
            <ui:Card Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}" IsEnabled="{Binding InstallMedia.CanEdit}">
                <DockPanel>
                <ui:SymbolIcon Style="{StaticResource MediaCardIcon}" Symbol="Archive24" VerticalAlignment="Top" Margin="0,2,16,0" />
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_CompressionTitle}" />
                    <!-- With 4 px padding the label starts 32 px in, where the hint below lines up (as in the source card) -->
                    <RadioButton GroupName="MediaCompression" Padding="4,0,0,0" Margin="0,8,0,0" Content="{l:Tr Media_CompressionFaster}" IsChecked="{Binding InstallMedia.FasterBuild}" />
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_CompressionFasterText}" Margin="32,0,0,0" />
                    <RadioButton GroupName="MediaCompression" Padding="4,0,0,0" Margin="0,12,0,0" Content="{l:Tr Media_CompressionSmaller}" IsChecked="{Binding InstallMedia.SmallerIso}" />
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_CompressionSmallerText}" Margin="32,0,0,0" />
                </StackPanel>
                </DockPanel>
            </ui:Card>

            <!-- Expert: changes that need knowing what they do -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Media_ExpertTitle}" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_ExpertText}" Margin="0,0,0,8" />
            <ui:CardExpander Margin="{StaticResource CardRowMargin}" HorizontalContentAlignment="Stretch" IsExpanded="{Binding InstallMedia.ExpandOptions, Mode=OneWay}" IsEnabled="{Binding InstallMedia.CanEdit}">
                <ui:CardExpander.Header>
                    <DockPanel Margin="0,4">
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding InstallMedia.RemoveUnreviewed}" IsEnabled="{Binding InstallMedia.UseIso}"
                                         AutomationProperties.Name="{l:Tr Media_UnreviewedTitle}" Margin="16,0,12,0" />
                        <ui:TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding InstallMedia.UnreviewedSummary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <ui:SymbolIcon Style="{StaticResource MediaCardIcon}" Symbol="Warning24" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_UnreviewedTitle}" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_UnreviewedText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </ui:CardExpander.Header>
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding InstallMedia.UnreviewedSourceText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <v:ItemList ItemsSource="{Binding InstallMedia.UnreviewedRows}" IsEnabled="{Binding InstallMedia.RemoveUnreviewed}">
                        <v:ItemList.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked}" Margin="0,4" AutomationProperties.Name="{Binding Title}">
                                    <StackPanel>
                                        <ui:TextBlock FontTypography="Body" Text="{Binding Title}" />
                                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Text}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </v:ItemList.ItemTemplate>
                    </v:ItemList>
                </StackPanel>
            </ui:CardExpander>

            <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}" IsEnabled="{Binding InstallMedia.CanEdit}">
                <ui:CardControl.Header>
                    <DockPanel>
                    <ui:SymbolIcon Style="{StaticResource MediaCardIcon}" Symbol="ShieldError24" />
                    <StackPanel>
                        <WrapPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_UnsupportedTitle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border Style="{StaticResource TagBorder}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                                <TextBlock Text="{l:Tr Media_PreviewTag}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>
                        </WrapPanel>
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_UnsupportedText}" Margin="0,4,0,0" />
                        <WrapPanel Margin="0,4,0,0">
                            <ui:HyperlinkButton Content="{l:Tr Media_UnsupportedSourceSupport}" Padding="0" Margin="0,0,16,0" Command="{Binding OpenLinkCommand}"
                                                CommandParameter="https://support.microsoft.com/windows/installing-windows-11-on-devices-that-don-t-meet-minimum-system-requirements-0b2dc4a2-5933-4ad4-9c09-ef0a331518f1" />
                            <ui:HyperlinkButton Content="{l:Tr Media_UnsupportedSourceSpecs}" Padding="0" Command="{Binding OpenLinkCommand}"
                                                CommandParameter="https://www.microsoft.com/windows/windows-11-specifications" />
                        </WrapPanel>
                    </StackPanel>
                    </DockPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch Style="{StaticResource SettingSwitch}" IsChecked="{Binding InstallMedia.AllowUnsupported}" AutomationProperties.Name="{l:Tr Media_UnsupportedTitle}" />
            </ui:CardControl>

            <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}" IsEnabled="{Binding InstallMedia.CanEdit}">
                <ui:CardControl.Header>
                    <DockPanel>
                    <ui:SymbolIcon Style="{StaticResource MediaCardIcon}" Symbol="LockOpen24" />
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_EncryptionTitle}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_EncryptionText}" Margin="0,4,0,0" />
                        <ui:HyperlinkButton Content="{l:Tr Media_EncryptionSource}" Padding="0" Margin="0,4,0,0" HorizontalAlignment="Left" Command="{Binding OpenLinkCommand}"
                                            CommandParameter="https://learn.microsoft.com/en-us/windows/security/operating-system-security/data-protection/bitlocker/" />
                    </StackPanel>
                    </DockPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch Style="{StaticResource SettingSwitch}" IsChecked="{Binding InstallMedia.PreventDeviceEncryption}" AutomationProperties.Name="{l:Tr Media_EncryptionTitle}" />
            </ui:CardControl>

            <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}" IsEnabled="{Binding InstallMedia.CanEdit}">
                <ui:CardControl.Header>
                    <DockPanel>
                    <ui:SymbolIcon Style="{StaticResource MediaCardIcon}" Symbol="Storage24" />
                    <StackPanel>
                        <WrapPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_ReservedTitle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border Style="{StaticResource TagBorder}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                                <TextBlock Text="{l:Tr Media_PreviewTag}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>
                        </WrapPanel>
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_ReservedText}" Margin="0,4,0,0" />
                    </StackPanel>
                    </DockPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch Style="{StaticResource SettingSwitch}" IsChecked="{Binding InstallMedia.NoReservedStorage}" AutomationProperties.Name="{l:Tr Media_ReservedTitle}" />
            </ui:CardControl>

            <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}" IsEnabled="{Binding InstallMedia.CanEdit}"
                            Visibility="{Binding InstallMedia.AllowUnsupported, Converter={StaticResource BoolToVisibility}}">
                <ui:CardControl.Header>
                    <DockPanel>
                    <ui:SymbolIcon Style="{StaticResource MediaCardIcon}" Symbol="ArrowUpload24" />
                    <StackPanel>
                        <WrapPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_UpgradesTitle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border Style="{StaticResource TagBorder}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                                <TextBlock Text="{l:Tr Media_PreviewTag}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>
                        </WrapPanel>
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_UpgradesText}" Margin="0,4,0,0" />
                    </StackPanel>
                    </DockPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch Style="{StaticResource SettingSwitch}" IsChecked="{Binding InstallMedia.AllowUnsupportedUpgrades}" AutomationProperties.Name="{l:Tr Media_UpgradesTitle}" />
            </ui:CardControl>

            <!-- 4. Build -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Media_BuildTitle}" />
            <!-- Every stage of the build with its state, from the first Build until the page closes (the banner stays for other pages) -->
            <ui:Card x:Name="StagesCard" Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}"
                     Visibility="{Binding InstallMedia.HasStages, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                <ui:SymbolIcon Style="{StaticResource MediaCardIcon}" Symbol="TextBulletListSquare24" VerticalAlignment="Top" Margin="0,2,16,0" />
                <StackPanel>
                    <DockPanel>
                        <ui:TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding InstallMedia.StagesText}" VerticalAlignment="Center"
                                      Visibility="{Binding InstallMedia.StagesText, Converter={StaticResource NullToVisibility}}" />
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_StagesTitle}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding InstallMedia.Stages}" Margin="0,8,0,0" IsTabStop="False" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- The state glyph: one of these five shows; the words are in AutomationProperties.Name and the note -->
                                    <Grid Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0" AutomationProperties.Name="{Binding StateText}">
                                        <ui:SymbolIcon Symbol="Circle20" FontSize="16" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16"
                                                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:SymbolIcon Symbol="CheckmarkCircle20" Filled="True" FontSize="16" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                       Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:SymbolIcon Symbol="ErrorCircle20" Filled="True" FontSize="16" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                       Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:SymbolIcon Symbol="Stop20" Filled="True" FontSize="16" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       Visibility="{Binding IsStopped, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <ui:TextBlock Grid.Column="1" FontTypography="Body" Text="{Binding Title}" TextWrapping="Wrap" />
                                    <ui:TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding DurationText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                                    <ui:TextBlock TextWrapping="Wrap" Text="{Binding Note}"
                                                  Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}">
                                        <ui:TextBlock.Style>
                                            <Style TargetType="ui:TextBlock" BasedOn="{StaticResource Caption}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:TextBlock.Style>
                                    </ui:TextBlock>
                                    <ProgressBar Minimum="0" Maximum="100" Height="4" Margin="0,4,0,0"
                                                 Value="{Binding Percent, Mode=OneWay}" Visibility="{Binding HasPercent, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </DockPanel>
            </ui:Card>

            <ui:Card x:Name="BuildCard" Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                <DockPanel>
                <ui:SymbolIcon Style="{StaticResource MediaCardIcon}" Symbol="DocumentSave24" VerticalAlignment="Top" Margin="0,2,16,0" />
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_Output}" />
                    <DockPanel Margin="0,8,0,0">
                        <ui:Button DockPanel.Dock="Right" Content="{l:Tr Media_PickOutput}" Icon="{ui:SymbolIcon Folder20}" Command="{Binding InstallMedia.PickOutputCommand}" IsEnabled="{Binding InstallMedia.CanEdit}" Margin="12,0,0,0" />
                        <ui:TextBlock FontTypography="Body" Text="{Binding InstallMedia.OutputPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstallMedia.OutputPath}" VerticalAlignment="Center" />
                    </DockPanel>
                    <!-- Room for a later choice of boot files; today the media keeps the source's own, which are Microsoft's only for the download -->
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_SecureBootNote}" Margin="0,4,0,0"
                                  Visibility="{Binding InstallMedia.UseDownload, Converter={StaticResource BoolToVisibility}}" />
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_UpgradeNote}" Margin="0,4,0,0" />
                    <!-- Measured in PCO-Test (docs/vm-test-plan.md, VM 4): the download alone took 21 minutes, unpacking the image 12 -->
                    <!-- While a build runs the window's banner shows its time -->
                    <ContentControl Style="{StaticResource DurationHint}" Content="{l:Tr Hint_TakesHalfHour}" Margin="0,8,0,0"
                                    Visibility="{Binding InstallMedia.IsBuilding, Converter={StaticResource InverseBoolToVisibility}}" />
                    <!-- A failure or a stop; a success has the finished card below -->
                    <ui:InfoBar Title="" Message="{Binding InstallMedia.ResultText}" Severity="{Binding InstallMedia.ResultSeverity}" IsClosable="False" Margin="0,16,0,0"
                                IsOpen="{Binding InstallMedia.ShowResultBar}" />
                    <!-- The failed build left a saved build: how much it keeps on which drive, so Resume or Discard is an informed choice -->
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding InstallMedia.SavedBuildText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                  Visibility="{Binding InstallMedia.SavedBuildText, Converter={StaticResource NullToVisibility}}" />
                    <!-- One row of buttons; Resume and Discard when the failed build left a saved build (the info bar below stays closed then) -->
                    <WrapPanel Margin="0,8,0,0" Visibility="{Binding InstallMedia.HasFailed, Converter={StaticResource BoolToVisibility}}">
                        <ui:Button Content="{l:Tr Media_ResumeButton}" Icon="{ui:SymbolIcon ArrowForward20}" Command="{Binding InstallMedia.ResumeCommand}" Margin="0,0,8,0"
                                   Visibility="{Binding InstallMedia.CanResumeAfterFailure, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="{l:Tr Media_DiscardButton}" Icon="{ui:SymbolIcon Delete20}" Command="{Binding InstallMedia.DiscardCommand}" Margin="0,0,8,0"
                                   Visibility="{Binding InstallMedia.CanResumeAfterFailure, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="{l:Tr Media_OpenLog}" Icon="{ui:SymbolIcon DocumentText20}" Command="{Binding InstallMedia.ShowLogCommand}" Margin="0,0,8,0"
                                   Visibility="{Binding InstallMedia.ResultLogPath, Converter={StaticResource NullToVisibility}}" />
                        <ui:Button Content="{l:Tr Media_ShowStage}" Icon="{ui:SymbolIcon TextBulletListSquare20}" Command="{Binding InstallMedia.ShowStageCommand}" Margin="0,0,8,0" />
                    </WrapPanel>
                    <!-- Why Resume did not start or Discard failed, when they were used from this card -->
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding InstallMedia.ResumeNote}" TextWrapping="Wrap" Margin="0,8,0,0"
                                  Visibility="{Binding InstallMedia.ResumeNoteOnFailureCard, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                </DockPanel>
            </ui:Card>

            <!-- The finished build: where the ISO is, its SHA-256 and what to do with it. 16 px on every side around the
                 48 px check mark and the subtitle, more room than a row (XamlRulesTests allow list). -->
            <ui:Card Padding="16" Margin="{StaticResource CardRowMargin}"
                     Visibility="{Binding InstallMedia.HasFinished, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="CheckmarkCircle48" Filled="True" FontSize="48" VerticalAlignment="Top" Margin="0,0,16,0"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle" Text="{l:Tr Media_FinishedTitle}" />
                    <TextBox Style="{StaticResource OutputBox}" Text="{Binding InstallMedia.ResultIso, Mode=OneWay}" FontFamily="{DynamicResource ContentControlThemeFontFamily}" FontSize="14"
                             AutomationProperties.Name="{l:Tr Media_Output}" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,8,0,0" />
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding InstallMedia.ResultSizeText}" Margin="0,2,0,0" />
                    <ui:TextBlock FontTypography="BodyStrong" Text="SHA-256" Margin="0,16,0,0" />
                    <DockPanel Margin="0,4,0,0">
                        <ui:Button DockPanel.Dock="Right" Content="{l:Tr Media_CopyHash}" Icon="{ui:SymbolIcon Copy20}" Command="{Binding InstallMedia.CopyHashCommand}"
                                   VerticalAlignment="Top" Margin="12,8,0,0" />
                        <TextBox Style="{StaticResource OutputBox}" Text="{Binding InstallMedia.ResultSha256, Mode=OneWay}" AutomationProperties.Name="SHA-256" />
                    </DockPanel>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Media_Sha256Hint}" Margin="0,4,0,0" />
                    <WrapPanel Margin="0,16,0,0">
                        <ui:Button Content="{l:Tr Media_OpenFolder}" Icon="{ui:SymbolIcon FolderOpen20}" Command="{Binding InstallMedia.OpenFolderCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="{l:Tr Media_OpenLog}" Icon="{ui:SymbolIcon DocumentText20}" Command="{Binding InstallMedia.ShowLogCommand}"
                                   Visibility="{Binding InstallMedia.ResultLogPath, Converter={StaticResource NullToVisibility}}" />
                    </WrapPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Media_NextStepTitle}" Margin="0,24,0,0" />
                    <ui:TextBlock FontTypography="Body" TextWrapping="Wrap" Text="{l:Tr Media_NextStepVm}" Margin="0,4,0,0" />
                    <ui:HyperlinkButton Content="{l:Tr Media_NextStepVmLink}" Padding="0" Command="{Binding OpenLinkCommand}"
                                        CommandParameter="https://learn.microsoft.com/windows-server/virtualization/hyper-v/get-started/create-a-virtual-machine-in-hyper-v" />
                    <ui:TextBlock FontTypography="Body" TextWrapping="Wrap" Text="{l:Tr Media_NextStepUsb}" Margin="0,8,0,0" />
                    <WrapPanel>
                        <ui:HyperlinkButton Content="{l:Tr Media_NextStepUsbRufus}" Padding="0" Margin="0,0,16,0" Command="{Binding OpenLinkCommand}" CommandParameter="https://rufus.ie/" />
                        <ui:HyperlinkButton Content="{l:Tr Media_NextStepUsbMicrosoft}" Padding="0" Command="{Binding OpenLinkCommand}"
                                            CommandParameter="https://learn.microsoft.com/windows-hardware/manufacture/desktop/install-windows-from-a-usb-flash-drive" />
                    </WrapPanel>
                </StackPanel>
                </DockPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>

    <!-- The summary bar: the chosen image, what goes into it, the space it needs, and Build (Stop while it runs) -->
    <StackPanel Grid.Row="1" Style="{StaticResource EdgeContent}" Margin="24,8,0,16">
        <!-- A build that stopped after a checkpoint left a saved build: Resume goes on from it, Discard deletes it -->
        <StackPanel Margin="0,0,0,8" Visibility="{Binding InstallMedia.ShowResumeBar, Converter={StaticResource BoolToVisibility}}">
            <ui:InfoBar Title="" Message="{Binding InstallMedia.ResumeText}" Severity="Informational" IsClosable="False" IsOpen="True" />
            <WrapPanel Margin="0,8,0,0">
                <ui:Button Content="{l:Tr Media_ResumeButton}" Icon="{ui:SymbolIcon ArrowForward20}" Command="{Binding InstallMedia.ResumeCommand}" Margin="0,0,8,0" />
                <ui:Button Content="{l:Tr Media_DiscardButton}" Icon="{ui:SymbolIcon Delete20}" Command="{Binding InstallMedia.DiscardCommand}" Margin="0,0,16,0" />
                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding InstallMedia.ResumeNote}" TextWrapping="Wrap" VerticalAlignment="Center"
                              Visibility="{Binding InstallMedia.ResumeNote, Converter={StaticResource NullToVisibility}}" />
            </WrapPanel>
        </StackPanel>
        <!-- The last build failed: the reason, the log and Resume are on the Build card at the page's end, and the button in the
             bar goes there. The WPF-UI InfoBar has no content slot: it draws the bar and the icon, the message and the button
             lie over it in two columns (as on the Overview), so the text never runs under the button. -->
        <Grid Margin="0,0,0,8" Visibility="{Binding InstallMedia.ShowFailedBar, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:InfoBar Grid.ColumnSpan="2" Title="" Message="" Severity="Error" IsClosable="False" IsOpen="True" VerticalAlignment="Stretch" />
            <TextBlock Text="{l:Tr Media_FailedBar}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center" Margin="46,12,16,12"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:Button Grid.Column="1" Content="{l:Tr Media_ShowFailure}" Icon="{ui:SymbolIcon ArrowDown20}" Command="{Binding InstallMedia.ShowFailedBuildCommand}"
                       VerticalAlignment="Center" Margin="0,8,16,8" />
        </Grid>
        <!-- What Save, Load or Reset did, or which remembered choices no longer fit -->
        <ui:InfoBar Title="" Message="{Binding InstallMedia.ChoicesNote}" Severity="{Binding InstallMedia.ChoicesNoteSeverity}" IsClosable="False" Margin="0,0,0,8"
                    IsOpen="{Binding InstallMedia.ChoicesNote, Converter={StaticResource NullToBool}}" />
        <ui:Card Padding="{StaticResource CardPadding}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding InstallMedia.SummaryText}" TextWrapping="Wrap" />
                    <!-- Each part on its own, side by side: a line breaks between two parts, never inside one ("Zu installierende /
                         Apps: 2"). Read as one text by screen readers (the name of the list). -->
                    <ItemsControl ItemsSource="{Binding InstallMedia.SummaryChangeParts}" Margin="0,2,0,0" Focusable="False"
                                  AutomationProperties.Name="{Binding InstallMedia.SummaryChangesText}"
                                  Visibility="{Binding InstallMedia.SummaryChangesText, Converter={StaticResource NullToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:TextBlock FontTypography="Body" Text="{Binding}" Margin="0,0,4,0" TextTrimming="CharacterEllipsis"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding InstallMedia.NeededText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                  Visibility="{Binding InstallMedia.NeededText, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
                <ui:TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{Binding InstallMedia.BarNote}" TextWrapping="Wrap" MaxWidth="240"
                              VerticalAlignment="Center" Margin="16,0,0,0" Visibility="{Binding InstallMedia.BarNote, Converter={StaticResource NullToVisibility}}" />
                <ui:DropDownButton Grid.Column="2" Content="{l:Tr Media_ChoicesButton}" Icon="{ui:SymbolIcon Options20}" VerticalAlignment="Center" Margin="16,0,0,0"
                                   IsEnabled="{Binding InstallMedia.CanEdit}">
                    <ui:DropDownButton.Flyout>
                        <ContextMenu>
                            <MenuItem Header="{l:Tr Media_SaveChoices}" Command="{Binding InstallMedia.SaveChoicesCommand}" />
                            <MenuItem Header="{l:Tr Media_LoadChoices}" Command="{Binding InstallMedia.LoadChoicesCommand}" />
                            <Separator />
                            <MenuItem Header="{l:Tr Media_ResetChoices}" Command="{Binding InstallMedia.ResetChoicesCommand}" />
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                </ui:DropDownButton>
                <ui:Button Grid.Column="3" Appearance="Primary" Content="{l:Tr Media_BuildButton}" Icon="{ui:SymbolIcon Play20}" Command="{Binding InstallMedia.BuildCommand}"
                           VerticalAlignment="Center" Margin="16,0,0,0" Visibility="{Binding InstallMedia.IsBuilding, Converter={StaticResource InverseBoolToVisibility}}" />
                <ui:Button Grid.Column="3" Content="{l:Tr Common_Stop}" Icon="{ui:SymbolIcon Stop20}" Command="{Binding Runner.Work.StopCommand}"
                           VerticalAlignment="Center" Margin="16,0,0,0" Visibility="{Binding InstallMedia.IsBuilding, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </ui:Card>
    </StackPanel>
    </Grid>
</UserControl>
