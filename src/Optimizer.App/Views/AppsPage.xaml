<UserControl x:Class="Optimizer.App.Views.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             xmlns:v="clr-namespace:Optimizer.App.Views"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
            <ui:Button DockPanel.Dock="Right" Content="{l:Tr Common_Refresh}" Icon="{ui:SymbolIcon ArrowClockwise20}" Command="{Binding Apps.ReloadCommand}" ToolTip="F5" VerticalAlignment="Top" />
            <StackPanel>
                <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Apps_Title}" />
                <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Apps_Hint}" />
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1" ItemContainerStyle="{StaticResource SelectorTab}" SelectedIndex="{Binding AppsTab}">
            <TabItem Header="{l:Tr Apps_TabApps}">
                <ScrollViewer Style="{StaticResource EdgeTabScroll}">
                    <StackPanel Style="{StaticResource EdgeContent}">
                        <!-- Update all at the top, not after the last of about thirty apps -->
                        <DockPanel Margin="0,0,0,8">
                            <ui:Button DockPanel.Dock="Right" Content="{l:Tr Apps_UpdateAll}" Icon="{ui:SymbolIcon ArrowDownload20}" Command="{Binding Apps.UpdateAllCommand}"
                                       IsEnabled="{Binding Apps.IsUpdatingAll, Converter={StaticResource InverseBool}}" VerticalAlignment="Top" Margin="16,0,0,0" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Apps_TabAppsHint}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <ui:InfoBar Title="" Message="{l:Tr Apps_NoWinget}" Severity="Warning" IsClosable="False" IsOpen="{Binding Apps.WingetMissing}" Margin="0,0,0,8" />
                        <ui:Button Content="{l:Tr Apps_GetAppInstaller}" Icon="{ui:SymbolIcon Open20}" Margin="0,0,0,8"
                                   Command="{Binding OpenLinkCommand}" CommandParameter="https://apps.microsoft.com/detail/9nblggh4nns1"
                                   Visibility="{Binding Apps.WingetMissing, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding Apps.IsLoading, Converter={StaticResource BoolToVisibility}}">
                            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Apps_Loading}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Package managers: what Update all runs, Chocolatey's update list, developer tools with a command to copy.
                             Folded by default with a one-line summary, so the winget search stays on the first screen. -->
                        <ui:CardExpander Margin="0,0,0,8" HorizontalContentAlignment="Stretch" IsExpanded="{Binding Apps.ManagersExpanded, Mode=TwoWay}"
                                         AutomationProperties.Name="{Binding Apps.ManagersAutomationName}" Visibility="{Binding Apps.HasManagerCard, Converter={StaticResource BoolToVisibility}}">
                            <ui:CardExpander.Header>
                                <StackPanel Margin="0,4">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Apps_ManagersTitle}" />
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Apps.ManagersSummary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <StackPanel Visibility="{Binding Apps.HasManagers, Converter={StaticResource BoolToVisibility}}">
                                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Apps.ManagersHint}" TextWrapping="Wrap" />
                                <v:ItemList ItemsSource="{Binding Apps.Managers}">
                                    <v:ItemList.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,12,0,0">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                    <ui:SymbolIcon Symbol="CheckmarkCircle20" Filled="True" FontSize="16" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"
                                                                   VerticalAlignment="Center" Visibility="{Binding Included, Converter={StaticResource BoolToVisibility}}" />
                                                    <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StatusText}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <WrapPanel>
                                                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" Margin="0,0,8,0" />
                                                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding VersionText}" VerticalAlignment="Center" />
                                                    </WrapPanel>
                                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Meta}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </v:ItemList.ItemTemplate>
                                </v:ItemList>

                                </StackPanel>

                                <!-- Chocolatey's update list: asked only when the user selects the button (it contacts the package sources) -->
                                <StackPanel Margin="0,16,0,0" Visibility="{Binding Apps.CanCheckChocolatey, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Content="{l:Tr Apps_ChocoCheck}" Icon="{ui:SymbolIcon ArrowSync20}" Command="{Binding Apps.CheckChocolateyCommand}"
                                                   IsEnabled="{Binding Apps.IsCheckingChocolatey, Converter={StaticResource InverseBool}}" />
                                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="12,0,0,0" Visibility="{Binding Apps.IsCheckingChocolatey, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Apps.ChocolateyNote}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </StackPanel>
                                    <v:ItemList ItemsSource="{Binding Apps.ChocolateyUpdates}">
                                        <v:ItemList.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,8,0,0">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StateText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,12,0" Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}" />
                                                        <ui:Button Content="{l:Tr Apps_Update}" Icon="{ui:SymbolIcon ArrowDownload20}" AutomationProperties.Name="{Binding UpdateLabel}"
                                                                   Visibility="{Binding Updated, Converter={StaticResource InverseBoolToVisibility}}"
                                                                   IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBool}}"
                                                                   Command="{Binding DataContext.Apps.UpdateChocolateyPackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextWrapping="Wrap" />
                                                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Meta}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </v:ItemList.ItemTemplate>
                                    </v:ItemList>
                                </StackPanel>
                                <TextBox Style="{StaticResource OutputBox}" AutomationProperties.Name="{l:Tr Apps_ManagersTitle}" Text="{Binding Apps.ManagerOutput, Mode=OneWay}" Visibility="{Binding Apps.ManagerOutput, Converter={StaticResource NullToVisibility}}" />

                                <!-- Developer tools: listed with their command, never run by Tunero -->
                                <StackPanel Margin="0,16,0,0" Visibility="{Binding Apps.HasDeveloperTools, Converter={StaticResource BoolToVisibility}}">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Apps_DevToolsTitle}" />
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Apps_DevToolsHint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <v:ItemList ItemsSource="{Binding Apps.DeveloperTools}">
                                        <v:ItemList.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,12,0,0">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                                                        <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding CopyState}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                        <ui:Button Content="{l:Tr Apps_CopyCommand}" Icon="{ui:SymbolIcon Copy20}" AutomationProperties.Name="{Binding CopyLabel}"
                                                                   Command="{Binding DataContext.Apps.CopyManagerCommandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <WrapPanel>
                                                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" Margin="0,0,8,0" />
                                                            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding VersionText}" VerticalAlignment="Center" />
                                                        </WrapPanel>
                                                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Meta}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                        <ui:TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding CommandText}"
                                                                      TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </v:ItemList.ItemTemplate>
                                    </v:ItemList>
                                </StackPanel>
                            </StackPanel>
                        </ui:CardExpander>

                        <!-- Any package of the winget repository, beyond the reviewed list below -->
                        <ui:Card Padding="16,12" Margin="0,0,0,8">
                            <StackPanel>
                                <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Apps_SearchTitle}" />
                                <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Apps_SearchHint}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Content="{l:Tr Apps_SearchButton}" Icon="{ui:SymbolIcon Search20}" Margin="8,0,0,0" MinWidth="96"
                                               Command="{Binding Apps.SearchWingetCommand}" IsEnabled="{Binding Apps.IsSearching, Converter={StaticResource InverseBool}}" />
                                    <ui:TextBox PlaceholderText="{l:Tr Apps_SearchPlaceholder}" AutomationProperties.Name="{l:Tr Apps_SearchTitle}" ClearButtonEnabled="True"
                                                Text="{Binding Apps.WingetQuery, UpdateSourceTrigger=PropertyChanged}">
                                        <ui:TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding Apps.SearchWingetCommand}" />
                                        </ui:TextBox.InputBindings>
                                    </ui:TextBox>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding Apps.SearchNote, Converter={StaticResource NullToVisibility}}">
                                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" Visibility="{Binding Apps.IsSearching, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Apps.SearchNote}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                                <v:ItemList ItemsSource="{Binding Apps.SearchResults}" Margin="0,4,0,0">
                                    <v:ItemList.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,8,0,0">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StateText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,12,0" Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}" />
                                                    <ui:Button Content="{l:Tr Apps_Install}" Icon="{ui:SymbolIcon ArrowDownload20}" AutomationProperties.Name="{Binding InstallLabel}"
                                                               IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBool}}"
                                                               Command="{Binding DataContext.Apps.InstallFoundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextWrapping="Wrap" />
                                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Meta}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </v:ItemList.ItemTemplate>
                                </v:ItemList>
                                <TextBox Style="{StaticResource OutputBox}" AutomationProperties.Name="{l:Tr Apps_SearchTitle}" Text="{Binding Apps.SearchOutput, Mode=OneWay}" Visibility="{Binding Apps.SearchOutput, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </ui:Card>

                        <v:ItemList ItemsSource="{Binding Apps.Apps}">
                            <v:ItemList.ItemTemplate>
                                <DataTemplate>
                                    <!-- Category heading above the first app of each category -->
                                    <DockPanel>
                                    <ui:TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Text="{Binding GroupHeader}" Margin="0,12,0,8"
                                                  Visibility="{Binding GroupHeader, Converter={StaticResource NullToVisibility}}" />
                                    <ui:CardControl Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}">
                                        <ui:CardControl.Icon>
                                            <ui:SymbolIcon Symbol="{Binding Symbol}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </ui:CardControl.Icon>
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                                                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Text}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Installed: a check mark in the success color carries the state, the text stays readable in both themes -->
                                            <ui:SymbolIcon Symbol="CheckmarkCircle20" Filled="True" FontSize="16" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"
                                                           VerticalAlignment="Center" Visibility="{Binding Installed, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StateText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,12,0" Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}" />
                                            <!-- One place for the button, kept on every row: "Installed" stays in line whether a row has
                                                 Update, Install or no button at all -->
                                            <Grid Width="140">
                                                <ui:Button Content="{l:Tr Apps_Install}" Icon="{ui:SymbolIcon ArrowDownload20}" AutomationProperties.Name="{Binding InstallLabel}" HorizontalAlignment="Right"
                                                           Visibility="{Binding Installed, Converter={StaticResource InverseBoolToVisibility}}"
                                                           IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBool}}"
                                                           Command="{Binding DataContext.Apps.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <!-- An installed app: update just this one from winget -->
                                                <ui:Button Content="{l:Tr Apps_Update}" Icon="{ui:SymbolIcon ArrowDownload20}" Appearance="Transparent" AutomationProperties.Name="{Binding UpdateLabel}" HorizontalAlignment="Right"
                                                           Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}"
                                                           IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBool}}"
                                                           Command="{Binding DataContext.Apps.UpdateAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </StackPanel>
                                    </ui:CardControl>
                                    </DockPanel>
                                </DataTemplate>
                            </v:ItemList.ItemTemplate>
                        </v:ItemList>
                        <TextBox Style="{StaticResource OutputBox}" AutomationProperties.Name="{l:Tr Apps_Title}" Text="{Binding Apps.Output, Mode=OneWay}" Visibility="{Binding Apps.Output, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{l:Tr Drv_Title}">
                <ScrollViewer Style="{StaticResource EdgeTabScroll}">
                    <StackPanel Style="{StaticResource EdgeContent}">
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Drv_Hint}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Drv_CleanTitle}" />
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Drv_CleanHint}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="{l:Tr Drv_CleanOpen}" Icon="{ui:SymbolIcon Open20}" Command="{Binding OpenLinkCommand}"
                                       CommandParameter="https://www.guru3d.com/download/display-driver-uninstaller-download/" />
                        </ui:CardControl>
                        <v:ItemList ItemsSource="{Binding Apps.Drivers}">
                            <v:ItemList.ItemTemplate>
                                <DataTemplate>
                                    <!-- One link per update source above its first driver, not one per row -->
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,12,0,8" Visibility="{Binding GroupHeader, Converter={StaticResource NullToVisibility}}">
                                            <ui:Button DockPanel.Dock="Right" Content="{l:Tr Drv_Update}" Icon="{ui:SymbolIcon Open20}" Visibility="{Binding GroupUrl, Converter={StaticResource NullToVisibility}}"
                                                       Command="{Binding DataContext.Apps.OpenDriverPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding GroupUrl}" />
                                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding GroupHeader}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <ui:CardControl Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Device}" TextWrapping="Wrap" />
                                                    <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding MetaText, Mode=OneWay}" />
                                                    <ui:TextBlock x:Name="Date" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0" Text="{Binding DateText, Mode=OneWay}" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                        </ui:CardControl>
                                    </DockPanel>
                        <!-- More than two years old, for graphics, network or audio: worth an update, so the date is in the caution color -->
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Old}" Value="True">
                                            <Setter TargetName="Date" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </v:ItemList.ItemTemplate>
                        </v:ItemList>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
