<UserControl x:Class="Optimizer.App.Views.StoragePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             xmlns:v="clr-namespace:Optimizer.App.Views"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <!-- This page is up to 1600 px wide, not 1000 like the others: list and treemap side by side need the room. The
             page's parts use these instead of the App.xaml styles of the same name, so header and tabs keep one width. -->
        <v:PageWidthConverter x:Key="StorageWidth" Limit="1600" />
        <v:EdgeMarginConverter x:Key="StorageEdgeMargin" Limit="1600" />
        <Style x:Key="PageRoot" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="{StaticResource PagePadding}" />
            <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StorageWidth}}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="EdgeContent" TargetType="StackPanel">
            <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StorageWidth}}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="EdgeTabScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Margin" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StorageEdgeMargin}, ConverterParameter=8}" />
        </Style>
        <!-- A group row: the whole row toggles the group (Toggle pattern for screen readers), drawn like a list row -->
        <Style x:Key="GroupToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A file in File types, Largest files or Duplicates: path and last change or group note, size on the right. Every
             row can be selected for the command bar; a lock marks the ones that may not be recycled, with the reason. -->
        <DataTemplate x:Key="FileRow">
            <DockPanel Margin="0,4">
                <ui:TextBlock DockPanel.Dock="Right" FontTypography="Body" Text="{Binding SizeText}" Margin="16,0,0,0" />
                <ui:SymbolIcon DockPanel.Dock="Right" Symbol="LockClosed16" FontSize="16" Margin="16,2,0,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{Binding BlockText}"
                               Visibility="{Binding BlockText, Converter={StaticResource NullToVisibility}}" />
                <CheckBox IsChecked="{Binding Selected}" AutomationProperties.Name="{Binding Path}" AutomationProperties.HelpText="{Binding BlockText}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Mono}" Text="{Binding Path}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Meta}" />
                    </StackPanel>
                </CheckBox>
            </DockPanel>
        </DataTemplate>
        <!-- The command bar above each list (content: the Storage view model). It acts on the open tab's selection and says
             why Move to Recycle Bin is off for it, or what selecting does while nothing is selected. -->
        <DataTemplate x:Key="CommandBar">
            <StackPanel Margin="0,0,0,8">
                <WrapPanel>
                    <ui:Button Appearance="Transparent" BorderThickness="0" Content="{l:Tr Storage_OpenInExplorer}" Icon="{ui:SymbolIcon FolderOpen20}" Command="{Binding OpenInExplorerCommand}" Margin="0,0,4,0" />
                    <ui:Button Appearance="Transparent" BorderThickness="0" Content="{l:Tr Storage_CopyPath}" Icon="{ui:SymbolIcon Copy20}" Command="{Binding CopyPathCommand}" Margin="0,0,4,0" />
                    <ui:Button Appearance="Transparent" BorderThickness="0" Content="{Binding RecycleText}" Icon="{ui:SymbolIcon Delete20}" Command="{Binding RecycleCommand}" />
                </WrapPanel>
                <DockPanel Margin="12,4,0,0" Visibility="{Binding SelectionBlock, Converter={StaticResource NullToVisibility}}">
                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="LockClosed16" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock FontTypography="Body" Text="{Binding SelectionBlock}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DockPanel>
                <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Storage_SelectHint}" Margin="12,4,0,0"
                              Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <!-- Drive picker and the result stay in place; each tab scrolls below them. Nothing is read before Analyze. -->
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Storage_PageTitle}" />
            <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Storage_PageHint}" />
            <ui:Card Padding="{StaticResource CardPadding}" Margin="0,0,0,8">
                <StackPanel>
                    <WrapPanel>
                        <!-- Each drive with its used share (two borders, as on System info) and free space -->
                        <ComboBox ItemsSource="{Binding Storage.Drives}" SelectedItem="{Binding Storage.SelectedDrive}" MinWidth="280" Margin="0,0,8,0"
                                  AutomationProperties.Name="{l:Tr Storage_Drive}" IsEnabled="{Binding Storage.IsBusy, Converter={StaticResource InverseBool}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Root}" />
                                            <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SpaceText}"
                                                          Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Width="200" Height="4" CornerRadius="2" HorizontalAlignment="Left" Margin="0,4,0,0" Background="{DynamicResource ControlStrongFillColorDisabledBrush}">
                                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding UsedShare}" />
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ui:Button Appearance="Primary" Content="{l:Tr Storage_Analyze}" Icon="{ui:SymbolIcon Search20}" Command="{Binding Storage.AnalyzeCommand}"
                                   VerticalAlignment="Center" />
                    </WrapPanel>
                    <!-- After an analysis: what it read, and Close result to drop it -->
                    <DockPanel Margin="0,12,0,0" Visibility="{Binding Storage.HasResult, Converter={StaticResource BoolToVisibility}}">
                        <ui:Button DockPanel.Dock="Right" Content="{l:Tr Storage_CloseResult}" Icon="{ui:SymbolIcon Dismiss20}" Command="{Binding Storage.CloseResultCommand}"
                                   IsEnabled="{Binding Storage.IsBusy, Converter={StaticResource InverseBool}}" Margin="16,0,0,0" VerticalAlignment="Center" />
                        <ui:TextBlock FontTypography="Body" Text="{Binding Storage.ResultText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
        <!-- Before an analysis: what the page does and the drive Analyze reads, instead of four tabs over an empty page -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Margin="0,0,0,48"
                    Visibility="{Binding Storage.NoResult, Converter={StaticResource BoolToVisibility}}">
            <ui:SymbolIcon Symbol="DataTreemap24" FontSize="48" HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                           Visibility="{Binding Storage.IsAnalyzing, Converter={StaticResource InverseBoolToVisibility}}" />
            <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" HorizontalAlignment="Center"
                             Visibility="{Binding Storage.IsAnalyzing, Converter={StaticResource BoolToVisibility}}" />
            <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Storage_EmptyTitle}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,0" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Storage.EmptyHint}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <TabControl Grid.Row="1" ItemContainerStyle="{StaticResource SelectorTab}" SelectedIndex="{Binding Storage.Tab}"
                    Visibility="{Binding Storage.HasResult, Converter={StaticResource BoolToVisibility}}">
            <TabItem Header="{l:Tr Storage_TabFolders}">
                <!-- Wide: list and map side by side, as tall as the tab (the scroll viewer gives its height). Narrow: the map
                     under the list, and the tab scrolls. Switched in code-behind (Layout). -->
                <ScrollViewer x:Name="FoldersScroll" Style="{StaticResource EdgeTabScroll}">
                    <Grid x:Name="FoldersContent" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentControl Content="{Binding Storage}" ContentTemplate="{StaticResource CommandBar}" Focusable="False" />
                        <Grid x:Name="FoldersGrid" Grid.Row="1" Visibility="{Binding Storage.HasResult, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ListColumn" Width="*" />
                                <ColumnDefinition x:Name="GapColumn" Width="0" />
                                <ColumnDefinition x:Name="MapColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="ListRow" Height="Auto" />
                                <RowDefinition x:Name="GapRow" Height="16" />
                                <RowDefinition x:Name="MapRow" Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- The folder tree as a flat list: only expanded folders become rows (a drive has millions of entries).
                                 No side padding: the rows' hover and selection highlights come nearer the card's edges than
                                 CardPadding allows; the header and the list set their own insets. -->
                            <ui:Card x:Name="ListCard" Padding="0,8" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="16,0,28,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Storage_ColName}" Margin="52,0,0,0" />
                                        <ui:TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{l:Tr Storage_ColSize}" TextAlignment="Right" />
                                        <ui:TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{l:Tr Storage_ColShare}" Margin="12,0,0,0" />
                                        <ui:TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="{l:Tr Storage_ColFiles}" TextAlignment="Right" />
                                        <ui:TextBlock Grid.Column="4" Style="{StaticResource Caption}" Text="{l:Tr Storage_ColChanged}" TextAlignment="Right" />
                                    </Grid>
                                    <ui:ListView x:Name="FolderList" Margin="11,0" ItemsSource="{Binding Storage.Folders.Rows}" SelectedItem="{Binding Storage.SelectedRow}" SelectionMode="Single"
                                                 AutomationProperties.Name="{l:Tr Storage_FolderList}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                                 PreviewKeyDown="FolderList_PreviewKeyDown" MouseDoubleClick="FolderList_MouseDoubleClick" SelectionChanged="FolderList_SelectionChanged">
                                        <ui:ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,12,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="88" />
                                                    </Grid.ColumnDefinitions>
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Left" Width="{Binding Indent}" />
                                                        <!-- The chevron opens and closes the folder (Left and Right do the same from the keyboard) -->
                                                        <ui:Button x:Name="Chevron" DockPanel.Dock="Left" Appearance="Transparent" Width="24" Height="24" Padding="0" BorderThickness="0"
                                                                   Focusable="False" Command="{Binding DataContext.Storage.ToggleRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   CommandParameter="{Binding}" Visibility="{Binding CanExpand, Converter={StaticResource BoolToHidden}}"
                                                                   AutomationProperties.Name="{l:Tr Storage_ToggleFolder}" ToolTip="{l:Tr Storage_ToggleFolder}">
                                                            <ui:SymbolIcon x:Name="ChevronIcon" Symbol="ChevronRight16" FontSize="12" />
                                                        </ui:Button>
                                                        <ui:SymbolIcon x:Name="KindIcon" DockPanel.Dock="Left" Symbol="Document20" FontSize="16" Margin="4,0,8,0"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                        <!-- A cut name shows in full on hover -->
                                                        <ui:TextBlock FontTypography="Body" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}" ToolTip="{Binding Name}" />
                                                    </DockPanel>
                                                    <ui:TextBlock Grid.Column="1" FontTypography="Body" Text="{Binding SizeText}" TextAlignment="Right" VerticalAlignment="Center"
                                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <!-- Share of the parent folder: two borders, as on the Hardware page -->
                                                    <Border Grid.Column="2" Height="4" CornerRadius="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                                            Background="{DynamicResource ControlStrongFillColorDisabledBrush}">
                                                        <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="{Binding Share}" />
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Border>
                                                    <ui:TextBlock Grid.Column="3" FontTypography="Body" Text="{Binding FilesText}" TextAlignment="Right" VerticalAlignment="Center"
                                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <ui:TextBlock Grid.Column="4" FontTypography="Body" Text="{Binding LastChange}" TextAlignment="Right" VerticalAlignment="Center"
                                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter TargetName="ChevronIcon" Property="Symbol" Value="ChevronDown16" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                        <Setter TargetName="KindIcon" Property="Symbol" Value="Folder20" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ui:ListView.ItemTemplate>
                                    </ui:ListView>
                                </DockPanel>
                            </ui:Card>
                            <!-- The shown folder's path (back up), the treemap and what its colors mean -->
                            <ui:Card x:Name="MapCard" Grid.Row="2" Padding="{StaticResource CardPadding}" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <DockPanel>
                                    <ui:BreadcrumbBar x:Name="Crumbs" DockPanel.Dock="Top" ItemsSource="{Binding Storage.Crumbs}" ItemClicked="Crumbs_ItemClicked"
                                                      AutomationProperties.Name="{l:Tr Storage_ShownFolder}" Margin="0,0,0,8">
                                        <ui:BreadcrumbBar.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontSize="14" />
                                            </DataTemplate>
                                        </ui:BreadcrumbBar.ItemTemplate>
                                    </ui:BreadcrumbBar>
                                    <ui:TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Text="{l:Tr Storage_TreemapHint}" Margin="0,4,0,0" />
                                    <!-- The legend: every group color with its name (the colors are the data, never decoration). Only
                                         the groups the map shows (code-behind, by Tag), so no color has to be matched in vain. -->
                                    <WrapPanel x:Name="Legend" DockPanel.Dock="Bottom" Margin="0,8,0,0" AutomationProperties.Name="{l:Tr Storage_Legend}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4" Tag="Video">
                                            <Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource TreemapVideoBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ui:TextBlock FontTypography="Caption" Text="{l:Tr Storage_GroupVideo}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4" Tag="Audio">
                                            <Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource TreemapAudioBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ui:TextBlock FontTypography="Caption" Text="{l:Tr Storage_GroupAudio}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4" Tag="Images">
                                            <Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource TreemapImagesBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ui:TextBlock FontTypography="Caption" Text="{l:Tr Storage_GroupImages}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4" Tag="Archives">
                                            <Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource TreemapArchivesBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ui:TextBlock FontTypography="Caption" Text="{l:Tr Storage_GroupArchives}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4" Tag="Programs">
                                            <Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource TreemapProgramsBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ui:TextBlock FontTypography="Caption" Text="{l:Tr Storage_GroupPrograms}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4" Tag="Documents">
                                            <Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource TreemapDocumentsBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ui:TextBlock FontTypography="Caption" Text="{l:Tr Storage_GroupDocuments}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4" Tag="System">
                                            <Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource TreemapSystemBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ui:TextBlock FontTypography="Caption" Text="{l:Tr Storage_GroupSystem}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4" Tag="Other">
                                            <Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource TreemapOtherBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ui:TextBlock FontTypography="Caption" Text="{l:Tr Storage_GroupOther}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <v:TreemapView x:Name="Map" Tree="{Binding Storage.Tree}" Folder="{Binding Storage.Folder}" SelectedEntry="{Binding Storage.SelectedEntry}"
                                                   EntryActivated="Map_EntryActivated" GroupsShown="Map_GroupsShown" MinHeight="160" />
                                </DockPanel>
                            </ui:Card>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{l:Tr Storage_TabTypes}">
                <ScrollViewer Style="{StaticResource EdgeTabScroll}">
                    <StackPanel Style="{StaticResource EdgeContent}">
                        <StackPanel Visibility="{Binding Storage.HasResult, Converter={StaticResource BoolToVisibility}}">
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Storage_TypesHint}" Margin="0,0,0,8" />
                            <!-- Groups by size; a group opens into its extensions (rows exist only for opened groups). No side
                                 padding, as in the folder list: the header and the list set their own insets. -->
                            <ui:Card Padding="0,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="16,0,16,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Storage_ColName}" Margin="41,0,0,0" />
                                        <ui:TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{l:Tr Storage_ColSize}" TextAlignment="Right" />
                                        <ui:TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{l:Tr Storage_ColShare}" Margin="12,0,0,0" />
                                        <ui:TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="{l:Tr Storage_ColFiles}" TextAlignment="Right" />
                                    </Grid>
                                    <v:ItemList ItemsSource="{Binding Storage.TypeGroups}" AutomationProperties.Name="{l:Tr Storage_TypeGroupList}" Margin="8,0">
                                        <v:ItemList.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <ToggleButton Style="{StaticResource GroupToggle}" IsChecked="{Binding IsExpanded}" AutomationProperties.Name="{Binding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="80" />
                                                                <ColumnDefinition Width="64" />
                                                                <ColumnDefinition Width="72" />
                                                            </Grid.ColumnDefinitions>
                                                            <DockPanel>
                                                                <ui:SymbolIcon x:Name="ChevronIcon" DockPanel.Dock="Left" Symbol="ChevronRight16" FontSize="12" Margin="0,0,8,0" />
                                                                <!-- The group's treemap color; the outline keeps the light yellow visible on white -->
                                                                <Border x:Name="Swatch" DockPanel.Dock="Left" Width="12" Height="12" CornerRadius="2" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />
                                                                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            </DockPanel>
                                                            <ui:TextBlock Grid.Column="1" FontTypography="Body" Text="{Binding SizeText}" TextAlignment="Right" VerticalAlignment="Center"
                                                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            <Border Grid.Column="2" Height="4" CornerRadius="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                                                    Background="{DynamicResource ControlStrongFillColorDisabledBrush}">
                                                                <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                                                    <Border.RenderTransform>
                                                                        <ScaleTransform ScaleX="{Binding Share}" />
                                                                    </Border.RenderTransform>
                                                                </Border>
                                                            </Border>
                                                            <ui:TextBlock Grid.Column="3" FontTypography="Body" Text="{Binding CountText}" TextAlignment="Right" VerticalAlignment="Center"
                                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </Grid>
                                                    </ToggleButton>
                                                    <ui:ListView ItemsSource="{Binding Extensions}" SelectedItem="{Binding Selected}" SelectionMode="Single" Margin="20,0,0,0"
                                                             AutomationProperties.Name="{Binding Name}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             v:ScrollChain.Enabled="True">
                                                    <ui:ListView.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2,4,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="80" />
                                                                    <ColumnDefinition Width="64" />
                                                                    <ColumnDefinition Width="72" />
                                                                </Grid.ColumnDefinitions>
                                                                <ui:TextBlock FontTypography="Body" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="8,0,0,0" />
                                                                <ui:TextBlock Grid.Column="1" FontTypography="Body" Text="{Binding SizeText}" TextAlignment="Right" VerticalAlignment="Center"
                                                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                <Border Grid.Column="2" Height="4" CornerRadius="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                                                        Background="{DynamicResource ControlStrongFillColorDisabledBrush}">
                                                                    <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                                                        <Border.RenderTransform>
                                                                            <ScaleTransform ScaleX="{Binding Share}" />
                                                                        </Border.RenderTransform>
                                                                    </Border>
                                                                </Border>
                                                                <ui:TextBlock Grid.Column="3" FontTypography="Body" Text="{Binding CountText}" TextAlignment="Right" VerticalAlignment="Center"
                                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ui:ListView.ItemTemplate>
                                                </ui:ListView>
                                                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding MoreText}" Margin="48,4,0,4"
                                                              Visibility="{Binding MoreText, Converter={StaticResource NullToVisibility}}" />
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter TargetName="ChevronIcon" Property="Symbol" Value="ChevronDown16" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Group}" Value="Video"><Setter TargetName="Swatch" Property="Background" Value="{DynamicResource TreemapVideoBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Group}" Value="Audio"><Setter TargetName="Swatch" Property="Background" Value="{DynamicResource TreemapAudioBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Group}" Value="Images"><Setter TargetName="Swatch" Property="Background" Value="{DynamicResource TreemapImagesBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Group}" Value="Archives"><Setter TargetName="Swatch" Property="Background" Value="{DynamicResource TreemapArchivesBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Group}" Value="Programs"><Setter TargetName="Swatch" Property="Background" Value="{DynamicResource TreemapProgramsBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Group}" Value="Documents"><Setter TargetName="Swatch" Property="Background" Value="{DynamicResource TreemapDocumentsBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Group}" Value="System"><Setter TargetName="Swatch" Property="Background" Value="{DynamicResource TreemapSystemBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Group}" Value="Other"><Setter TargetName="Swatch" Property="Background" Value="{DynamicResource TreemapOtherBrush}" /></DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </v:ItemList.ItemTemplate>
                                    </v:ItemList>
                                </StackPanel>
                            </ui:Card>
                            <!-- The largest files of the selected extension, rows as under Largest files -->
                            <StackPanel Visibility="{Binding Storage.TypeFiles.Count, Converter={StaticResource CountToVisibility}}">
                                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Storage.TypeFilesTitle}" Margin="0,0,0,8" />
                                <ContentControl Content="{Binding Storage}" ContentTemplate="{StaticResource CommandBar}" Focusable="False" />
                                <ui:Card Padding="{StaticResource CardPadding}">
                                    <v:ItemList ItemsSource="{Binding Storage.TypeFiles}" ItemTemplate="{StaticResource FileRow}" />
                                </ui:Card>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{l:Tr Storage_TabLargest}">
                <ScrollViewer Style="{StaticResource EdgeTabScroll}">
                    <StackPanel Style="{StaticResource EdgeContent}">
                        <StackPanel Visibility="{Binding Storage.LargestFiles.Count, Converter={StaticResource CountToVisibility}}">
                            <ContentControl Content="{Binding Storage}" ContentTemplate="{StaticResource CommandBar}" Focusable="False" />
                            <ui:Card Padding="{StaticResource CardPadding}">
                                <v:ItemList ItemsSource="{Binding Storage.LargestFiles}" ItemTemplate="{StaticResource FileRow}" />
                            </ui:Card>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{l:Tr Storage_TabDuplicates}">
                <ScrollViewer Style="{StaticResource EdgeTabScroll}">
                    <StackPanel Style="{StaticResource EdgeContent}">
                        <!-- Nothing is hashed before Find duplicates -->
                        <ui:Card Padding="{StaticResource CardPadding}" Margin="0,0,0,8" Visibility="{Binding Storage.HasResult, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Content="{l:Tr Storage_FindDuplicates}" Icon="{ui:SymbolIcon DocumentCopy20}" Command="{Binding Storage.FindDuplicatesCommand}"
                                           Margin="16,0,0,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Storage_DuplicatesHint}" />
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Storage.DuplicatesText}" Margin="0,4,0,0"
                                                  Visibility="{Binding Storage.DuplicatesText, Converter={StaticResource NullToVisibility}}" />
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Storage_NoDuplicates}" Margin="0,4,0,0"
                                                  Visibility="{Binding Storage.NoDuplicates, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DockPanel>
                        </ui:Card>
                        <StackPanel Visibility="{Binding Storage.Duplicates.Count, Converter={StaticResource CountToVisibility}}">
                            <ContentControl Content="{Binding Storage}" ContentTemplate="{StaticResource CommandBar}" Focusable="False" />
                            <ui:Card Padding="{StaticResource CardPadding}">
                                <v:ItemList ItemsSource="{Binding Storage.Duplicates}" ItemTemplate="{StaticResource FileRow}" />
                            </ui:Card>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
