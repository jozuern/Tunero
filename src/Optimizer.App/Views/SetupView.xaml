<UserControl x:Class="Optimizer.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- The first start's setup (MainViewModel.Setup): over the whole window until it is answered -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" Margin="24,48,24,24" VerticalAlignment="Center">
            <ui:TextBlock FontTypography="Title" Text="{l:Tr Setup_Title}" />
            <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SetupLocationText}"
                          TextWrapping="Wrap" Margin="0,8,0,24" />
            <ui:Card Padding="16" Margin="0,0,0,4">
                <CheckBox IsChecked="{Binding SetupToProgramFiles}" VerticalContentAlignment="Top" AutomationProperties.Name="{l:Tr Setup_ProgramFiles}">
                    <StackPanel Margin="4,0,0,0">
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Setup_ProgramFiles}" TextWrapping="Wrap" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding SetupProgramFilesHint}" Margin="0,4,0,0" />
                    </StackPanel>
                </CheckBox>
            </ui:Card>
            <ui:Card Padding="16">
                <CheckBox IsChecked="{Binding SetupStartMenu}" VerticalContentAlignment="Top" AutomationProperties.Name="{l:Tr Setup_StartMenu}">
                    <StackPanel Margin="4,0,0,0">
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Setup_StartMenu}" TextWrapping="Wrap" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Setup_StartMenuHint}" Margin="0,4,0,0" />
                    </StackPanel>
                </CheckBox>
            </ui:Card>
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <ui:Button x:Name="InstallButton" Appearance="Primary" Content="{l:Tr Setup_Install}" Command="{Binding SetupInstallCommand}" MinWidth="120" Margin="0,0,8,0" />
                <ui:Button Content="{l:Tr Setup_RunHere}" Command="{Binding SetupRunHereCommand}" MinWidth="120" />
                <!-- Install copies about 70 MB and checks the signature: a few seconds -->
                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="16,0,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding SetupBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <!-- Install refused while a change, scan or update runs: the window's result bar is under this screen -->
            <ui:InfoBar Title="" Message="{Binding SetupNote}" Severity="Warning" IsClosable="False" Margin="0,16,0,0"
                        IsOpen="{Binding SetupNote, Converter={StaticResource NullToBool}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
