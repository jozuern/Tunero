<UserControl x:Class="Optimizer.App.Views.HealthPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:v="clr-namespace:Optimizer.App.Views"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             xmlns:act="clr-namespace:Optimizer.Core.Activity;assembly=Optimizer.Core"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageRoot}">
            <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Health_Title}" />
            <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Health_Hint}" />

            <!-- Throttle check -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Throttle_Title}" Margin="0,0,0,8" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Throttle_Hint}" Margin="0,0,0,8" />
            <ui:Card Padding="16,12">
                <StackPanel>
                    <WrapPanel>
                        <!-- A visible label: a bare "120 s" could be a delay as well as the length of the check -->
                        <ui:TextBlock FontTypography="Body" Text="{l:Tr Bench_Duration}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Health.DurationOptions}" SelectedItem="{Binding Health.ThrottleSeconds}" ItemStringFormat="{}{0} s" MinWidth="100" Margin="0,0,8,0" AutomationProperties.Name="{l:Tr Bench_Duration}" />
                        <ui:Button Appearance="Primary" Content="{l:Tr Throttle_Start}" Icon="{ui:SymbolIcon Play20}" Command="{Binding Health.StartThrottleCommand}"
                                   IsEnabled="{Binding Health.IsThrottleRunning, Converter={StaticResource InverseBool}}" Margin="0,0,8,0" />
                        <ui:Button Content="{l:Tr Common_Stop}" Icon="{ui:SymbolIcon Stop20}" Command="{Binding Health.StopThrottleCommand}"
                                   Visibility="{Binding Health.IsThrottleRunning, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Health.ThrottleStatus}" Margin="0,8,0,0" Visibility="{Binding Health.ThrottleStatus, Converter={StaticResource NullToVisibility}}" />
                    <ui:TextBlock FontTypography="Body" Text="{Binding Health.ThrottleResult}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding Health.ThrottleResult, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </ui:Card>

            <!-- Benchmark -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Bench_Title}" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Bench_Hint}" Margin="0,0,0,4" />

            <ui:Card Padding="16,12">
                <StackPanel>
                    <!-- Where the measurement stands: four marks (reached ones in the accent color), "Step 2 of 4" and what to do now -->
                    <UniformGrid Rows="1" Columns="4" Width="240" HorizontalAlignment="Left" Margin="0,4,0,8">
                        <UniformGrid.Resources>
                            <Style x:Key="StepMark" TargetType="Border">
                                <Setter Property="Height" Value="4" />
                                <Setter Property="CornerRadius" Value="2" />
                                <Setter Property="Margin" Value="0,0,4,0" />
                                <Setter Property="Background" Value="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                            </Style>
                        </UniformGrid.Resources>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepMark}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Health.BenchmarkStepNumber, Converter={StaticResource AtLeast}, ConverterParameter=1}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepMark}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Health.BenchmarkStepNumber, Converter={StaticResource AtLeast}, ConverterParameter=2}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepMark}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Health.BenchmarkStepNumber, Converter={StaticResource AtLeast}, ConverterParameter=3}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepMark}">
                                    <Setter Property="Margin" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Health.BenchmarkStepNumber, Converter={StaticResource AtLeast}, ConverterParameter=4}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </UniformGrid>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Health.BenchmarkStepLabel}" />
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Health.BenchmarkStep}" TextWrapping="Wrap" Margin="0,2,0,12" />
                    <!-- The bottom margin cancels the last row's 8 px, so the card's padding is even -->
                    <WrapPanel Margin="0,0,0,-8">
                        <!-- A combo box has no placeholder: the hint lies over it until a game is picked -->
                        <Grid Margin="0,0,8,8">
                            <ComboBox ItemsSource="{Binding Health.Processes}" SelectedItem="{Binding Health.SelectedProcess}" MinWidth="220" AutomationProperties.Name="{l:Tr Bench_Game}" />
                            <ui:TextBlock FontTypography="Body" Text="{l:Tr Bench_PickGame}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="12,0,32,0"
                                          VerticalAlignment="Center" IsHitTestVisible="False"
                                          Visibility="{Binding Health.SelectedProcess, Converter={StaticResource VisibleWhenNull}}" />
                        </Grid>
                        <ui:Button Icon="{ui:SymbolIcon ArrowSync20}" Command="{Binding Health.RefreshProcessesCommand}" ToolTip="{l:Tr Common_Refresh}" AutomationProperties.Name="{l:Tr Common_Refresh}" Margin="0,0,8,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                            <ui:TextBlock FontTypography="Body" Text="{l:Tr Bench_PerRun}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding Health.CaptureOptions}" SelectedItem="{Binding Health.CaptureSeconds}" ItemStringFormat="{}{0} s" MinWidth="100" AutomationProperties.Name="{l:Tr Bench_PerRun}" />
                        </StackPanel>
                        <!-- One unit: A and B wrap together instead of B alone on the next line -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:Button Content="{l:Tr Bench_Before}" Command="{Binding Health.CaptureBeforeCommand}" IsEnabled="{Binding Health.CanCaptureBefore}" Margin="0,0,8,0" />
                            <ui:Button Content="{l:Tr Bench_After}" Command="{Binding Health.CaptureAfterCommand}" IsEnabled="{Binding Health.CanCaptureAfter}" Margin="0,0,8,0" />
                            <ui:Button Content="{l:Tr Common_Stop}" Command="{Binding Health.StopCaptureCommand}" Margin="0,0,8,0"
                                       Visibility="{Binding Health.IsCapturing, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Content="{l:Tr Bench_Clear}" Appearance="Transparent" Command="{Binding Health.ClearRunsCommand}"
                                       Visibility="{Binding Health.HasRuns, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </WrapPanel>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Health.BenchmarkStatus}" Margin="0,8,0,0" Visibility="{Binding Health.BenchmarkStatus, Converter={StaticResource NullToVisibility}}" />
                    <v:ItemList ItemsSource="{Binding Health.Runs}" Margin="0,8,0,0" Visibility="{Binding Health.HasRuns, Converter={StaticResource BoolToVisibility}}">
                        <v:ItemList.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Label}" />
                                    <ui:TextBlock Grid.Column="1" FontTypography="Body" Text="{Binding AvgFps}" />
                                    <ui:TextBlock Grid.Column="2" FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Low}" />
                                    <ui:TextBlock Grid.Column="3" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Frames}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </v:ItemList.ItemTemplate>
                    </v:ItemList>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Health.ComparisonText}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding Health.ComparisonText, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </ui:Card>

            <!-- Drives -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Health_Disks}" />
            <v:ItemList ItemsSource="{Binding Health.Disks}">
                <v:ItemList.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="{Binding Status, Converter={StaticResource StatusToSymbol}}" Filled="True" v:ThemeBrush.Status="{Binding Status}" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextWrapping="Wrap" />
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Details}" Margin="0,4,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:TextBlock FontTypography="Body" Text="{Binding Health}" />
                        </ui:CardControl>
                    </DataTemplate>
                </v:ItemList.ItemTemplate>
            </v:ItemList>

            <!-- Sensors (opt-in) -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Sensors_Title}" />
            <ui:CardControl Padding="{StaticResource CardPadding}">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Temperature24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Sensors_Live}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Sensors_Hint}" Margin="0,4,0,0" />
                        <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Health.PawnIoText}" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{l:Tr Sensors_InstallPawnIo}" Margin="0,0,16,0" Command="{Binding Health.InstallPawnIoCommand}"
                               Visibility="{Binding Health.CanInstallPawnIo, Converter={StaticResource BoolToVisibility}}" />
                    <ui:ToggleSwitch AutomationProperties.Name="{l:Tr Sensors_Live}" IsChecked="{Binding Health.SensorsOn}" OnContent="{l:Tr Feature_On}" OffContent="{l:Tr Feature_Off}" />
                </StackPanel>
            </ui:CardControl>
            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Health.SensorsStatus}" Margin="0,8,0,0"
                          Visibility="{Binding Health.SensorsStatus, Converter={StaticResource NullToVisibility}}" />
            <!-- One card per component: its headline values large, every reading folded below (the values change in place) -->
            <v:ItemList ItemsSource="{Binding Health.SensorGroups}" Margin="0,8,0,0">
                <v:ItemList.ItemTemplate>
                    <DataTemplate>
                        <ui:CardExpander Margin="{StaticResource CardRowMargin}" IsExpanded="{Binding IsExpanded}" HorizontalContentAlignment="Stretch">
                            <ui:CardExpander.Header>
                                <StackPanel Margin="0,4,0,4">
                                    <DockPanel>
                                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <ui:TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding Kind}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <v:ItemList ItemsSource="{Binding Tiles}" Margin="32,12,0,0" Focusable="False">
                                        <v:ItemList.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </v:ItemList.ItemsPanel>
                                        <v:ItemList.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="144" Margin="0,0,16,4">
                                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Title}" />
                                                    <ui:TextBlock FontTypography="Subtitle" Margin="0,2,0,0">
                                                        <Run Text="{Binding Value, Mode=OneWay}" /><Run Text=" " FontSize="14" /><Run Text="{Binding Unit, Mode=OneWay}" FontSize="14" FontWeight="Normal"
                                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </ui:TextBlock>
                                                    <!-- Load as a bar; other kinds keep its space so the lines below stay level -->
                                                    <Border Width="112" Height="4" CornerRadius="2" HorizontalAlignment="Left" Margin="0,4,0,4" Background="{DynamicResource ControlStrongFillColorDisabledBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Fill}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Hidden" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="{Binding Fill, FallbackValue=0, TargetNullValue=0}" />
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Border>
                                                    <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Source}"
                                                                  TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" />
                                                    <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Peak}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </v:ItemList.ItemTemplate>
                                    </v:ItemList>
                                    <!-- The three programs using this component most right now -->
                                    <StackPanel Margin="32,8,0,4" Width="560" HorizontalAlignment="Left">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Activity}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ShowsActivity}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Activity_UsingNow}" Margin="0,0,0,4" />
                                        <v:ItemList ItemsSource="{Binding Activity.Top}" Focusable="False">
                                            <v:ItemList.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="128" />
                                                            <ColumnDefinition Width="104" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                        <ui:TextBlock Grid.Column="1" FontTypography="Body" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" />
                                                        <Border Grid.Column="2" Width="112" Height="4" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                Background="{DynamicResource ControlStrongFillColorDisabledBrush}">
                                                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                                                <Border.RenderTransform>
                                                                    <ScaleTransform ScaleX="{Binding Fill}" />
                                                                </Border.RenderTransform>
                                                            </Border>
                                                        </Border>
                                                        <ui:TextBlock Grid.Column="3" FontTypography="Body" Text="{Binding Now}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </v:ItemList.ItemTemplate>
                                        </v:ItemList>
                                        <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Activity.EmptyText}"
                                                      Visibility="{Binding Activity.EmptyText, Converter={StaticResource NullToVisibility}}" />
                                        <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Activity.UnavailableText}" TextWrapping="Wrap"
                                                      Visibility="{Binding Activity.UnavailableText, Converter={StaticResource NullToVisibility}}" />
                                    </StackPanel>
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding AllTitle}" Margin="32,4,0,0" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                            <!-- Every program that used this component since the readings were switched on, sortable -->
                            <StackPanel Width="560" HorizontalAlignment="Left" Margin="32,0,0,16">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Activity}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ShowsActivity}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Activity.ProgramCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel.Resources>
                                    <Style x:Key="ColumnHeader" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="4,2" />
                                        <Setter Property="HorizontalContentAlignment" Value="Right" />
                                        <Setter Property="Command" Value="{Binding Activity.SortCommand}" />
                                    </Style>
                                </StackPanel.Resources>
                                <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Activity_Programs}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Style="{StaticResource ColumnHeader}" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Margin="-4,0,0,0"
                                               CommandParameter="{x:Static act:ActivityColumn.Name}" AutomationProperties.Name="{l:Tr Activity_ColProgram}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Activity_ColProgram}" />
                                            <ui:SymbolIcon Symbol="{Binding Activity.SortSymbol}" FontSize="12" Margin="4,0,0,0" Visibility="{Binding Activity.SortedByName, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Grid.Column="1" Style="{StaticResource ColumnHeader}" Width="96" CommandParameter="{x:Static act:ActivityColumn.Now}"
                                               AutomationProperties.Name="{l:Tr Activity_ColNow}" Visibility="{Binding Activity.ShowsNow, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="{Binding Activity.SortSymbol}" FontSize="12" Margin="0,0,4,0" Visibility="{Binding Activity.SortedByNow, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Activity_ColNow}" />
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Grid.Column="2" Style="{StaticResource ColumnHeader}" Width="96" CommandParameter="{x:Static act:ActivityColumn.Read}"
                                               AutomationProperties.Name="{l:Tr Activity_ColRead}" Visibility="{Binding Activity.ShowsReadWrite, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="{Binding Activity.SortSymbol}" FontSize="12" Margin="0,0,4,0" Visibility="{Binding Activity.SortedByRead, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Activity_ColRead}" />
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Grid.Column="3" Style="{StaticResource ColumnHeader}" Width="96" CommandParameter="{x:Static act:ActivityColumn.Write}"
                                               AutomationProperties.Name="{l:Tr Activity_ColWrite}" Visibility="{Binding Activity.ShowsReadWrite, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="{Binding Activity.SortSymbol}" FontSize="12" Margin="0,0,4,0" Visibility="{Binding Activity.SortedByWrite, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Activity_ColWrite}" />
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Grid.Column="4" Style="{StaticResource ColumnHeader}" Width="112" CommandParameter="{x:Static act:ActivityColumn.Engine}"
                                               AutomationProperties.Name="{l:Tr Activity_ColEngine}" Visibility="{Binding Activity.ShowsEngine, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="{Binding Activity.SortSymbol}" FontSize="12" Margin="0,0,4,0" Visibility="{Binding Activity.SortedByEngine, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Activity_ColEngine}" />
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Grid.Column="5" Style="{StaticResource ColumnHeader}" Width="112" CommandParameter="{x:Static act:ActivityColumn.SinceOn}"
                                               AutomationProperties.Name="{l:Tr Activity_ColSinceOn}" ToolTip="{l:Tr Activity_SinceOnHint}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="{Binding Activity.SortSymbol}" FontSize="12" Margin="0,0,4,0" Visibility="{Binding Activity.SortedBySinceOn, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Activity_ColSinceOn}" />
                                        </StackPanel>
                                    </ui:Button>
                                </Grid>
                                <v:ItemList ItemsSource="{Binding Activity.Rows}" Focusable="False">
                                    <v:ItemList.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                            <!-- A row is a button: a click opens its details under it, a second click closes them -->
                                            <ui:Button Appearance="Transparent" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" CornerRadius="0"
                                                       Padding="0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                       Command="{Binding DataContext.Activity.SelectCommand, RelativeSource={RelativeSource AncestorType=v:ItemList}}" CommandParameter="{Binding}"
                                                       AutomationProperties.Name="{Binding Name}">
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.Resources>
                                                        <Style x:Key="Cell" TargetType="ui:TextBlock">
                                                            <Setter Property="FontTypography" Value="Body" />
                                                            <Setter Property="Width" Value="96" />
                                                            <Setter Property="Padding" Value="0,0,4,0" />
                                                            <Setter Property="TextAlignment" Value="Right" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Ended}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Resources>
                                                    <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                    <ui:TextBlock Grid.Column="1" Style="{StaticResource Cell}" Width="Auto" TextAlignment="Left" Text="{Binding Name}"
                                                                  TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                    <ui:TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="{Binding Now}"
                                                                  Visibility="{Binding DataContext.Activity.ShowsNow, RelativeSource={RelativeSource AncestorType=v:ItemList}, Converter={StaticResource BoolToVisibility}}" />
                                                    <ui:TextBlock Grid.Column="3" Style="{StaticResource Cell}" Text="{Binding Read}"
                                                                  Visibility="{Binding DataContext.Activity.ShowsReadWrite, RelativeSource={RelativeSource AncestorType=v:ItemList}, Converter={StaticResource BoolToVisibility}}" />
                                                    <ui:TextBlock Grid.Column="4" Style="{StaticResource Cell}" Text="{Binding Write}"
                                                                  Visibility="{Binding DataContext.Activity.ShowsReadWrite, RelativeSource={RelativeSource AncestorType=v:ItemList}, Converter={StaticResource BoolToVisibility}}" />
                                                    <ui:TextBlock Grid.Column="5" Style="{StaticResource Cell}" Width="112" Text="{Binding Engine}"
                                                                  Visibility="{Binding DataContext.Activity.ShowsEngine, RelativeSource={RelativeSource AncestorType=v:ItemList}, Converter={StaticResource BoolToVisibility}}" />
                                                    <ui:TextBlock Grid.Column="6" Style="{StaticResource Cell}" Width="112" Text="{Binding SinceOn}" />
                                                </Grid>
                                            </ui:Button>
                                            <!-- The selected program: what it is, and Open in Explorer, a priority rule or End task -->
                                            <Border DataContext="{Binding DataContext.Activity, RelativeSource={RelativeSource AncestorType=v:ItemList}}"
                                                    Margin="24,4,0,8" Padding="12" CornerRadius="4" BorderThickness="1"
                                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    Visibility="{Binding DataContext.IsSelected, RelativeSource={RelativeSource AncestorType=StackPanel}, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Visibility="{Binding Details, Converter={StaticResource NullToVisibility}}">
                                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Details.Name}" TextWrapping="Wrap" />
                                                    <ui:TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Details.MetaText}" />
                                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Details.Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details.Path}" Margin="0,2,0,0"
                                                                  Visibility="{Binding Details.Path, Converter={StaticResource NullToVisibility}}" />
                                                    <ui:TextBlock FontTypography="Body" Text="{Binding Details.ServicesText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                                  Visibility="{Binding Details.ServicesText, Converter={StaticResource NullToVisibility}}" />
                                                    <ui:TextBlock FontTypography="Body" Text="{Binding Details.Note}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                                  Visibility="{Binding Details.Note, Converter={StaticResource NullToVisibility}}" />
                                                    <WrapPanel Margin="0,12,0,0">
                                                        <ui:Button Content="{l:Tr Storage_OpenInExplorer}" Icon="{ui:SymbolIcon FolderOpen20}" Command="{Binding OpenLocationCommand}" Margin="0,0,8,0"
                                                                   Visibility="{Binding Details.Path, Converter={StaticResource NullToVisibility}}" />
                                                        <ui:Button Content="{l:Tr Activity_AddRule}" Icon="{ui:SymbolIcon TopSpeed20}" Command="{Binding AddRuleCommand}" Margin="0,0,8,0"
                                                                   Visibility="{Binding Details.CanAddRule, Converter={StaticResource BoolToVisibility}}" />
                                                        <ui:Button Content="{l:Tr Activity_EndButton}" Icon="{ui:SymbolIcon Dismiss20}" Command="{Binding EndTaskCommand}"
                                                                   Visibility="{Binding Details.CanEnd, Converter={StaticResource BoolToVisibility}}" />
                                                    </WrapPanel>
                                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Details.EndRefusal}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                                  Visibility="{Binding Details.EndRefusal, Converter={StaticResource NullToVisibility}}" />
                                                </StackPanel>
                                            </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </v:ItemList.ItemTemplate>
                                </v:ItemList>
                                <ui:Button Content="{Binding Activity.ShowAllText}" Command="{Binding Activity.ShowAllCommand}" Appearance="Transparent" Margin="0,4,0,0"
                                           Visibility="{Binding Activity.ShowAllText, Converter={StaticResource NullToVisibility}}" />
                                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Activity.OtherText}" Margin="0,4,0,0"
                                              Visibility="{Binding Activity.OtherText, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                            <!-- Every reading, by kind: name, value now, peak since the readings were switched on -->
                            <v:ItemList ItemsSource="{Binding Sections}" Width="560" HorizontalAlignment="Left" Margin="32,0,0,0" Focusable="False">
                                <v:ItemList.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="104" />
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" />
                                                <ui:TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{l:Tr Sensors_Now}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                <ui:TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{l:Tr Sensors_PeakColumn}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                            </Grid>
                                            <v:ItemList ItemsSource="{Binding Rows}" Focusable="False">
                                                <v:ItemList.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="104" />
                                                                    <ColumnDefinition Width="104" />
                                                                </Grid.ColumnDefinitions>
                                                                <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Name}"
                                                                              TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                                <ui:TextBlock Grid.Column="1" FontTypography="Body" Text="{Binding Value}" HorizontalAlignment="Right" />
                                                                <ui:TextBlock Grid.Column="2" FontTypography="Body" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Peak}" HorizontalAlignment="Right" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </v:ItemList.ItemTemplate>
                                            </v:ItemList>
                                        </StackPanel>
                                    </DataTemplate>
                                </v:ItemList.ItemTemplate>
                            </v:ItemList>
                            </StackPanel>
                        </ui:CardExpander>
                    </DataTemplate>
                </v:ItemList.ItemTemplate>
            </v:ItemList>
        </StackPanel>
    </ScrollViewer>
</UserControl>
