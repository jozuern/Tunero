<UserControl x:Class="Optimizer.App.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:v="clr-namespace:Optimizer.App.Views"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageRoot}">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="{l:Tr Scan_Again}" Icon="{ui:SymbolIcon ArrowSync20}" Command="{Binding ScanCommand}" ToolTip="F5" VerticalAlignment="Top" />
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Dash_Title}" />
                    <ui:TextBlock Style="{StaticResource PageIntro}" Text="{Binding Headline}" />
                </StackPanel>
            </DockPanel>

            <v:ItemList ItemsSource="{Binding Banners}">
                <v:ItemList.ItemTemplate>
                    <DataTemplate>
                        <!-- The WPF-UI InfoBar has no content slot and a fixed padding: it draws the bar and icon, the message
                             and the optional action button are laid over it in two columns so the text never runs under the button. -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:InfoBar Grid.ColumnSpan="2" Title="" Message="" Severity="{Binding Severity}" IsOpen="True" IsClosable="False" VerticalAlignment="Stretch" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center" Margin="46,12,16,12"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <ui:Button Grid.Column="1" Content="{Binding ActionText}" Command="{Binding Action}"
                                       VerticalAlignment="Center" Margin="0,8,16,8"
                                       Visibility="{Binding ActionText, Converter={StaticResource NullToVisibility}}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="{Binding ActionIcon}" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                    </DataTemplate>
                </v:ItemList.ItemTemplate>
            </v:ItemList>

            <!-- What the scan says, in one sentence: the one loud element of this page. The light weight is kept for what the scan
                 says (this sentence and the rating marks); the problems it counts follow right under it, each with its mark. -->
            <TextBlock Text="{Binding VerdictShown}" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="Light" FontSize="32"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,8,0,8"
                       AutomationProperties.HeadingLevel="Level2" />
            <!-- The score as one quiet line (how it is counted in its tooltip), the way to Manual checks when the BIOS or the
                 hardware has something to change, and on the right the switch for the passed checks of the list below -->
            <DockPanel Margin="0,0,0,12">
                <ui:ToggleSwitch DockPanel.Dock="Right" Content="{l:Tr Dash_ShowAll}" IsChecked="{Binding ShowPassed}" VerticalAlignment="Top" Margin="16,0,0,0" />
                <StackPanel VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ReadinessShown}" TextWrapping="Wrap"
                                  ToolTip="{Binding ScoreHint}" />
                    <ui:HyperlinkButton Content="{Binding AdvisorLinkShown}" Padding="0" Margin="0,4,0,0" HorizontalAlignment="Left" Click="Advisor_Click"
                                        ToolTip="{l:Tr Dash_CountsHint}" Visibility="{Binding AdvisorLinkShown, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </DockPanel>
            <ui:TextBlock Style="{StaticResource EmptyState}" Text="{l:Tr Empty_List}" Visibility="{Binding FindingsEmpty, Converter={StaticResource BoolToVisibility}}" />
            <v:ItemList ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingRow}" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding HiddenFindingsText}" Margin="0,4,0,0"
                          Visibility="{Binding HiddenFindingsText, Converter={StaticResource NullToVisibility}}" />
            <!-- Results the user ignores: out of the list and the score, one click away -->
            <StackPanel Visibility="{Binding IgnoredText, Converter={StaticResource NullToVisibility}}" Margin="0,4,0,0">
                <ui:HyperlinkButton Content="{Binding IgnoredText}" Command="{Binding ToggleIgnoredCommand}" Padding="0" />
                <v:ItemList ItemsSource="{Binding IgnoredItems}" ItemTemplate="{StaticResource FindingRow}" Margin="0,8,0,0"
                            Visibility="{Binding ShowIgnored, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- Usage profile: decides recommendations and what counts; changes nothing by itself. After the findings: the verdict
                 comes first, the setting that shapes it follows. -->
            <ui:CardControl Padding="{StaticResource CardPadding}" Margin="0,24,0,0">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="{Binding SelectedProfile.Icon}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Profile_Label}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding ProfileDescription}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding SuggestedProfileText, Converter={StaticResource NullToVisibility}}">
                            <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="{Binding SuggestedProfileText}" VerticalAlignment="Center" />
                            <ui:HyperlinkButton Content="{l:Tr Profile_UseSuggested}" Command="{Binding UseSuggestedProfileCommand}" Padding="8,0" Margin="4,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding SelectedProfile}" ItemTemplate="{StaticResource ProfileItem}"
                          MinWidth="220" Margin="16,0,0,0" ToolTip="{l:Tr Profile_Hint}" AutomationProperties.Name="{l:Tr Profile_Label}" />
            </ui:CardControl>

            <!-- Game access (gaming profiles only): its own section after the findings and the profile, outside the verdict (it is
                 not part of the impact rating) -->
            <StackPanel Visibility="{Binding GameAccess, Converter={StaticResource NullToVisibility}}">
                <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Dash_GameAccess}" />
                <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Dash_GameAccessHint}" Margin="0,0,0,8" />
                <ContentControl Content="{Binding GameAccess}" ContentTemplate="{StaticResource FindingRow}" Focusable="False" />
            </StackPanel>

            <!-- Apply recommended -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Rec_Section}" />
            <ui:Card Padding="{StaticResource CardPadding}">
                <StackPanel>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="{Binding RecommendedButtonText}" Command="{Binding ApplyRecommendedCommand}"
                                   Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Top" />
                        <!-- Nothing to apply: one line instead of the intro and an empty list -->
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding RecommendationsIntro}" Margin="0,0,16,0"
                                      Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVisibility}}" />
                        <!-- 24 + 14 px in front, as on the cards above, so the text starts where their titles start; in
                             the secondary color, quieter than the titles around it -->
                        <DockPanel Visibility="{Binding HasRecommendations, Converter={StaticResource InverseBoolToVisibility}}">
                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info24" FontSize="24" Width="24" Margin="0,0,14,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Style="{StaticResource EmptyState}" Text="{Binding RecommendationsEmptyText}" VerticalAlignment="Center" />
                        </DockPanel>
                    </DockPanel>
                    <v:ItemList ItemsSource="{Binding Recommendations}" Margin="0,8,0,0">
                        <v:ItemList.ItemTemplate>
                            <DataTemplate>
                                <!-- A checklist: untick what you do not want, the button applies the rest; the eye ignores the
                                     line's tweak (until Stop ignoring); the problem a fix is for stays -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" MinWidth="0" Margin="0,0,8,0" AutomationProperties.Name="{Binding Title}" />
                                    <StackPanel Grid.Column="1">
                                        <ui:TextBlock FontTypography="Body" Text="{Binding Title}" TextWrapping="Wrap" />
                                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Reason}" />
                                    </StackPanel>
                                    <v:RatingMark Grid.Column="2" Style="{StaticResource RowRating}" Margin="16,0,0,0" VerticalAlignment="Top" Value="{Binding Rating}" Disputed="{Binding IsDisputed}"
                                                  ToolTip="{Binding ImpactText}" AutomationProperties.Name="{Binding ImpactText}" />
                                    <ui:Button Grid.Column="3" Appearance="Transparent" Icon="{ui:SymbolIcon EyeOff20}" Margin="8,0,0,0" VerticalAlignment="Top"
                                               ToolTip="{l:Tr Tweaks_Ignore}" AutomationProperties.Name="{l:Tr Tweaks_Ignore}"
                                               Visibility="{Binding IgnoreTweakId, Converter={StaticResource NullToVisibility}}"
                                               Command="{Binding DataContext.IgnoreTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding IgnoreTweakId}" />
                                </Grid>
                            </DataTemplate>
                        </v:ItemList.ItemTemplate>
                    </v:ItemList>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Rec_SafetyNote}" Margin="0,8,0,0" TextWrapping="Wrap"
                                  Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVisibility}}" />
                    <!-- What the one-click list leaves out, with what each needs first: under a line in the same card (a card
                         in the card drew two borders). With nothing to apply the line above already says so; else a heading. -->
                    <StackPanel Visibility="{Binding RecommendationsExcluded.Count, Converter={StaticResource CountToVisibility}}">
                        <Border Style="{StaticResource Divider}" />
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Rec_ExcludedTitle}" TextWrapping="Wrap" Margin="0,0,0,4"
                                      Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVisibility}}" />
                        <v:ItemList ItemsSource="{Binding RecommendationsExcluded}">
                            <v:ItemList.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Icon="{ui:SymbolIcon EyeOff20}" Margin="8,0,0,0" VerticalAlignment="Top"
                                                   ToolTip="{l:Tr Tweaks_Ignore}" AutomationProperties.Name="{l:Tr Tweaks_Ignore}"
                                                   Visibility="{Binding IgnoreTweakId, Converter={StaticResource NullToVisibility}}"
                                                   Command="{Binding DataContext.IgnoreTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding IgnoreTweakId}" />
                                        <StackPanel>
                                            <ui:TextBlock FontTypography="Body" Text="{Binding Title}" TextWrapping="Wrap" />
                                            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Reason}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </v:ItemList.ItemTemplate>
                        </v:ItemList>
                    </StackPanel>
                    <!-- Recommendations the user ignores: on the Tweaks page, in their own group -->
                    <ui:HyperlinkButton Content="{Binding IgnoredTweaksText}" Command="{Binding ShowIgnoredTweaksCommand}" Padding="0" Margin="0,8,0,0"
                                        Visibility="{Binding IgnoredTweaksText, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </ui:Card>

            <!-- Settings that work against the profile: a section of their own, so they do not read as part of the
                 recommendations (or contradict "nothing to recommend"), each with what can be done about it -->
            <StackPanel Visibility="{Binding HasAgainst, Converter={StaticResource BoolToVisibility}}">
                <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{Binding AgainstTitle}" />
                <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Rec_AgainstHint}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <ui:Card Padding="{StaticResource CardPadding}">
                    <v:ItemList ItemsSource="{Binding AgainstProfile}">
                        <v:ItemList.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 24 + 14 px, as on the finding cards: the titles start at the same edge -->
                                    <ui:SymbolIcon Symbol="Warning24" Filled="True" FontSize="24" Width="24" Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Top" Margin="0,0,14,0" />
                                    <StackPanel Grid.Column="1">
                                        <ui:TextBlock FontTypography="Body" Text="{Binding Title}" TextWrapping="Wrap" />
                                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Reason}" TextWrapping="Wrap" />
                                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Rec_AgainstOutside}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                      Visibility="{Binding SetOutside, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="2" Content="{l:Tr Tweak_Undo}" Icon="{ui:SymbolIcon ArrowUndo20}" Margin="16,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding UndoLabel}"
                                               Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}"
                                               Command="{Binding DataContext.UndoRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding TweakId}" />
                                    <ui:Button Grid.Column="2" Content="{l:Tr Common_Details}" Margin="16,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding DetailsLabel}"
                                               Visibility="{Binding SetOutside, Converter={StaticResource BoolToVisibility}}"
                                               Command="{Binding DataContext.ShowTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding TweakId}" />
                                    <ui:Button Grid.Column="3" Appearance="Transparent" Icon="{ui:SymbolIcon EyeOff20}" Margin="8,0,0,0" VerticalAlignment="Center"
                                               ToolTip="{l:Tr Rec_AgainstIgnore}" AutomationProperties.Name="{l:Tr Rec_AgainstIgnore}"
                                               Command="{Binding DataContext.IgnoreTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding TweakId}" />
                                </Grid>
                            </DataTemplate>
                        </v:ItemList.ItemTemplate>
                    </v:ItemList>
                </ui:Card>
            </StackPanel>


        </StackPanel>
    </ScrollViewer>
</UserControl>
