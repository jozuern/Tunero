<UserControl x:Class="Optimizer.App.Views.DebloatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             xmlns:v="clr-namespace:Optimizer.App.Views"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <!-- The reviewed apps under a header per group (Microsoft apps, Xbox components and so on): the list is sorted by
             group, which without the headers read as a broken alphabetical order -->
        <CollectionViewSource x:Key="GroupedApps" Source="{Binding Debloat.Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <v:FractionConverter x:Key="Fraction" />
    </UserControl.Resources>
    <!-- Everything that removes apps in one place: Store apps that came with Windows, and desktop programs -->
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
            <!-- One Refresh for the page, as on the other pages: it reads the open tab again (F5 does the same) -->
            <ui:Button DockPanel.Dock="Right" Content="{l:Tr Common_Refresh}" Icon="{ui:SymbolIcon ArrowClockwise20}" Command="{Binding RefreshCommand}" ToolTip="F5" VerticalAlignment="Top" />
            <StackPanel>
                <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Debloat_Title}" />
                <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Debloat_PageHint}" />
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1" ItemContainerStyle="{StaticResource SelectorTab}" SelectedIndex="{Binding DebloatTab}">
            <TabItem Header="{l:Tr Debloat_TabStore}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- As on Installed programs: the note, the states, then the action right above the list it acts on -->
                    <StackPanel Margin="0,8,0,0">
                        <!-- What is offered and that removing cannot be undone here: a plain note, the info bars below are for states -->
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Debloat_TabNote}" TextWrapping="Wrap" />
                        <ui:InfoBar Title="" Message="{l:Tr Banner_AdminToApply}" Severity="Warning" IsClosable="False"
                                    IsOpen="{Binding IsElevated, Converter={StaticResource InverseBool}}" Margin="0,8,0,0" />
                        <ui:InfoBar Title="" Message="{Binding Debloat.CameBackText}" Severity="Warning" IsClosable="False" Margin="0,8,0,0"
                                    IsOpen="{Binding Debloat.CameBackText, Converter={StaticResource NullToBool}}" />
                        <ui:Button Content="{l:Tr Debloat_CameBackDismiss}" Command="{Binding Debloat.DismissCameBackCommand}" Margin="0,4,0,0"
                                   Visibility="{Binding Debloat.CameBackText, Converter={StaticResource NullToVisibility}}" />
                        <!-- Several apps in one go: one confirmation names each of them. Outside the scrolling list and always there,
                             as on Cleanup, so the action is in view wherever an app is ticked and the list does not move. -->
                        <ui:Card Padding="16,12" Margin="0,12,0,0">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="{l:Tr Debloat_RemoveSelected}" Icon="{ui:SymbolIcon Delete20}" Margin="16,0,0,0"
                                           Command="{Binding Debloat.RemoveSelectedCommand}" IsEnabled="{Binding Debloat.HasSelection}" VerticalAlignment="Center" />
                                <ui:TextBlock FontTypography="Body" Text="{Binding Debloat.SelectionText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </ui:Card>
                        <!-- The list scrolls below this line, not flush under the card -->
                        <Border Height="1" Margin="0,12,0,0" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    </StackPanel>
                <ScrollViewer Grid.Row="1" Style="{StaticResource EdgeScroll}">
                    <StackPanel Style="{StaticResource EdgeContent}">
                        <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" HorizontalAlignment="Left" Margin="0,16,0,0" Visibility="{Binding Debloat.IsLoading, Converter={StaticResource BoolToVisibility}}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Debloat_Empty}" Margin="0,16,0,0" Visibility="{Binding Debloat.ItemsEmpty, Converter={StaticResource BoolToVisibility}}" />

                        <!-- No icon per row: it only repeated the group, which the header now names -->
                        <v:ItemList ItemsSource="{Binding Source={StaticResource GroupedApps}}">
                            <v:ItemList.GroupStyle>
                                <GroupStyle>
                                    <!-- WPF's own group container indents the rows by 5 px; here they line up with the other cards -->
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <StackPanel>
                                                            <ContentPresenter />
                                                            <ItemsPresenter />
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{Binding Name}" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </v:ItemList.GroupStyle>
                            <v:ItemList.ItemTemplate>
                                <DataTemplate>
                                    <ui:CardControl Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}" IsHitTestVisible="True">
                                        <ui:CardControl.Header>
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanRemove}" MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Center"
                                                          AutomationProperties.Name="{Binding SelectLabel}" />
                                                <StackPanel>
                                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Text}" Margin="0,4,0,0" />
                                                    <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0" Visibility="{Binding DataContext.ShowTechnical, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                                        <Run Text="{Binding PackageName, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Version, Mode=OneWay}" />
                                                    </ui:TextBlock>
                                                    <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding BlockText}" TextWrapping="Wrap"
                                                                  Margin="0,4,0,0" Visibility="{Binding BlockText, Converter={StaticResource NullToVisibility}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </ui:CardControl.Header>
                                        <ui:Button Content="{l:Tr Debloat_Remove}" Appearance="Secondary" IsEnabled="{Binding CanRemove}" AutomationProperties.Name="{Binding RemoveLabel}"
                                                   Command="{Binding DataContext.Debloat.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </ui:CardControl>
                                </DataTemplate>
                            </v:ItemList.ItemTemplate>
                        </v:ItemList>

                        <!-- Apps nobody reviewed: off by default, with a warning, in a section of their own after the reviewed list
                             (the switch between the list and OneDrive read as one more app) -->
                        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Debloat_OtherApps}" />
                        <ui:CardControl Padding="{StaticResource CardPadding}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="{l:Tr Debloat_UnreviewedSwitch}" />
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Debloat_UnreviewedHint}" Margin="0,4,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch AutomationProperties.Name="{l:Tr Debloat_UnreviewedSwitch}" IsChecked="{Binding Debloat.ShowUnreviewed}" />
                        </ui:CardControl>
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Debloat_UnreviewedEmpty}" Margin="0,8,0,0"
                                      Visibility="{Binding Debloat.UnreviewedEmpty, Converter={StaticResource BoolToVisibility}}" />
                        <v:ItemList ItemsSource="{Binding Debloat.Unreviewed}" Margin="0,8,0,0">
                            <v:ItemList.ItemTemplate>
                                <DataTemplate>
                                    <ui:CardControl Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}">
                                        <ui:CardControl.Icon>
                                            <ui:SymbolIcon Symbol="Apps24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </ui:CardControl.Icon>
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextWrapping="Wrap" />
                                                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Meta}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:Button Content="{l:Tr Debloat_Remove}" Appearance="Secondary" IsEnabled="{Binding CanRemove}" AutomationProperties.Name="{Binding RemoveLabel}"
                                                   Command="{Binding DataContext.Debloat.RemoveUnreviewedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </ui:CardControl>
                                </DataTemplate>
                            </v:ItemList.ItemTemplate>
                        </v:ItemList>

                        <!-- OneDrive and Edge under one header, each card titled with the app (the verb is on the button) -->
                        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Debloat_OneDriveEdge}" />
                        <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Cloud24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="OneDrive" />
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Debloat.OneDriveText}" Margin="0,4,0,0" />
                                    <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding Debloat.OneDriveBlock}" TextWrapping="Wrap"
                                                  Margin="0,4,0,0" Visibility="{Binding Debloat.OneDriveBlock, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="{l:Tr Debloat_Uninstall}" Appearance="Secondary" IsEnabled="{Binding Debloat.CanUninstallOneDrive}" Command="{Binding Debloat.UninstallOneDriveCommand}"
                                       AutomationProperties.Name="{l:Tr Debloat_OneDriveTitle}"
                                       Visibility="{Binding Debloat.OneDriveInstalled, Converter={StaticResource BoolToVisibility}}" />
                        </ui:CardControl>

                        <!-- Edge: Windows removes it in Settings (its uninstaller refuses other callers); WebView2 stays -->
                        <ui:CardControl Padding="{StaticResource CardPadding}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Globe24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="Microsoft Edge" />
                                    <!-- What removing it means, only while there is something to remove -->
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Debloat_EdgeText}" Margin="0,4,0,0"
                                                  Visibility="{Binding Debloat.EdgeInstalled, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Debloat.EdgeMissing}" Margin="0,4,0,0" Visibility="{Binding Debloat.EdgeMissing, Converter={StaticResource NullToVisibility}}" />
                                    <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding Debloat.EdgeBlock}" TextWrapping="Wrap"
                                                  Margin="0,4,0,0" Visibility="{Binding Debloat.EdgeBlock, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="{l:Tr Debloat_EdgeOpen}" Icon="{ui:SymbolIcon Open20}" Appearance="Secondary" IsEnabled="{Binding Debloat.CanRemoveEdge}" Command="{Binding Debloat.RemoveEdgeCommand}"
                                       AutomationProperties.Name="{l:Tr Debloat_EdgeTitle}"
                                       Visibility="{Binding Debloat.EdgeInstalled, Converter={StaticResource BoolToVisibility}}" />
                        </ui:CardControl>

                        <!-- Removed apps -->
                        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Debloat_RemovedTitle}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Debloat_RemovedEmpty}" Visibility="{Binding Debloat.RemovedEmpty, Converter={StaticResource BoolToVisibility}}" />
                        <v:ItemList ItemsSource="{Binding Debloat.Removed}">
                            <v:ItemList.ItemTemplate>
                                <DataTemplate>
                                    <ui:CardControl Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <ui:TextBlock FontTypography="Body" Text="{Binding Name}" />
                                                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding When}" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:Button Content="{l:Tr Debloat_Reinstall}" Icon="{ui:SymbolIcon Open20}" AutomationProperties.Name="{Binding ReinstallLabel}"
                                                   Command="{Binding DataContext.Debloat.OpenStoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding StoreLink}"
                                                   Visibility="{Binding StoreLink, Converter={StaticResource NullToVisibility}}" />
                                    </ui:CardControl>
                                </DataTemplate>
                            </v:ItemList.ItemTemplate>
                        </v:ItemList>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="{l:Tr Programs_Title}">
                <Grid x:Name="ProgramsGrid" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- At most 60 percent of the tab, scrolling beyond: with the queue and the Left behind card on a short window
                         (1080p at 150 percent) the program list kept one row and the card's buttons were out of reach -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                  MaxHeight="{Binding ActualHeight, ElementName=ProgramsGrid, Converter={StaticResource Fraction}, ConverterParameter=0.6}">
                    <StackPanel>
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Programs_Hint}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <DockPanel Margin="0,0,0,8">
                            <!-- Program Files folders of programs uninstalled long ago: listed under Left behind for review -->
                            <ui:Button DockPanel.Dock="Right" Content="{l:Tr Orphans_Find}" Icon="{ui:SymbolIcon FolderOpen20}" Appearance="Transparent" Margin="8,0,0,0"
                                       ToolTip="{l:Tr Orphans_FindHint}" Command="{Binding Apps.FindOrphansCommand}"
                                       IsEnabled="{Binding Apps.IsFindingOrphans, Converter={StaticResource InverseBool}}" />
                            <ui:ProgressRing DockPanel.Dock="Right" IsIndeterminate="True" Width="16" Height="16" Margin="8,0,0,0"
                                             Visibility="{Binding Apps.IsFindingOrphans, Converter={StaticResource BoolToVisibility}}" />
                            <ui:TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding Apps.ProgramsText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <!-- Biggest or newest first: the row shows size and install date -->
                            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Apps.ProgramSorts}" SelectedValuePath="Key" SelectedValue="{Binding Apps.ProgramSort}" DisplayMemberPath="Text"
                                      MinWidth="160" Margin="12,0,0,0" AutomationProperties.Name="{l:Tr Programs_Sort}" ToolTip="{l:Tr Programs_Sort}" />
                            <ui:TextBox PlaceholderText="{l:Tr Programs_Search}" AutomationProperties.Name="{l:Tr Programs_Search}" Icon="{ui:SymbolIcon Search20}" Text="{Binding Apps.ProgramSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                        </DockPanel>
                        <ui:TextBlock FontTypography="Body" Text="{l:Tr List_NoMatch}" Margin="0,0,0,8"
                                      Visibility="{Binding Apps.ProgramsNoMatch, Converter={StaticResource BoolToVisibility}}" />
                        <!-- Several programs in one go: one after the other, quietly where the program offers it -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding Apps.HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <ui:Button Appearance="Primary" Content="{Binding Apps.UninstallSelectedText}" Icon="{ui:SymbolIcon Delete20}" Command="{Binding Apps.UninstallSelectedCommand}"
                                       IsEnabled="{Binding Apps.IsQueueRunning, Converter={StaticResource InverseBool}}" />
                            <CheckBox Content="{l:Tr Programs_Quiet}" IsChecked="{Binding Apps.QuietUninstall}" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="{l:Tr Programs_QuietHint}" />
                        </StackPanel>
                        <ui:Card Padding="16,12" Margin="0,0,0,8" Visibility="{Binding Apps.IsQueueRunning, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <ui:Button Content="{l:Tr Programs_QueueContinue}" Command="{Binding Apps.ContinueQueueCommand}" Margin="0,0,8,0" ToolTip="{l:Tr Programs_QueueContinueHint}"
                                               Visibility="{Binding Apps.IsWaitingForUninstaller, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:Button Content="{l:Tr Programs_QueueStop}" Command="{Binding Apps.StopQueueCommand}" ToolTip="{l:Tr Programs_QueueStopHint}" />
                                </StackPanel>
                                <ui:ProgressRing DockPanel.Dock="Left" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <ui:TextBlock FontTypography="Body" Text="{Binding Apps.QueueText}" TextWrapping="Wrap" />
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Programs_QueueWaiting}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                  Visibility="{Binding Apps.IsWaitingForUninstaller, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DockPanel>
                        </ui:Card>
                        <!-- What uninstalled programs left behind: reviewed here, then moved to the Recycle Bin -->
                        <ui:Card Padding="16,12" Margin="0,0,0,8" Visibility="{Binding Apps.Leftovers.Count, Converter={StaticResource CountToVisibility}}">
                            <StackPanel>
                                <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Leftovers_Title}" />
                                <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Leftovers_Hint}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                <ScrollViewer MaxHeight="216" VerticalScrollBarVisibility="Auto">
                                    <v:ItemList ItemsSource="{Binding Apps.Leftovers}">
                                        <v:ItemList.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Selected}" Margin="0,4" AutomationProperties.Name="{Binding Path}">
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource Mono}" Text="{Binding Path}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Meta}" />
                                                        <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding StateText}" TextWrapping="Wrap"
                                                                      Visibility="{Binding StateText, Converter={StaticResource NullToVisibility}}" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </v:ItemList.ItemTemplate>
                                    </v:ItemList>
                                </ScrollViewer>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <ui:Button Appearance="Primary" Content="{l:Tr Leftovers_Recycle}" Icon="{ui:SymbolIcon Delete20}" Command="{Binding Apps.RecycleLeftoversCommand}" Margin="0,0,8,0"
                                               IsEnabled="{Binding Apps.IsRecycling, Converter={StaticResource InverseBool}}" />
                                    <ui:Button Content="{l:Tr Leftovers_Dismiss}" Command="{Binding Apps.DismissLeftoversCommand}" Appearance="Transparent" />
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                    </ScrollViewer>
                    <v:ItemList Grid.Row="1" ItemsSource="{Binding Apps.ProgramRows}" Style="{StaticResource VirtualCardList}">
                        <v:ItemList.ItemTemplate>
                            <DataTemplate>
                                <ui:CardControl Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}">
                                    <ui:CardControl.Header>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding SelectLabel}" IsEnabled="{Binding IsRemoving, Converter={StaticResource InverseBool}}" />
                                            <StackPanel>
                                                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextWrapping="Wrap" />
                                                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Meta}" Margin="0,4,0,0" />
                                                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding StateText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                              Visibility="{Binding StateText, Converter={StaticResource NullToVisibility}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,12,0" Visibility="{Binding IsRemoving, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:Button Content="{l:Tr Programs_Uninstall}" Icon="{ui:SymbolIcon Delete20}" IsEnabled="{Binding IsRemoving, Converter={StaticResource InverseBool}}" AutomationProperties.Name="{Binding UninstallLabel}"
                                                   Command="{Binding DataContext.Apps.UninstallProgramCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </ui:CardControl>
                            </DataTemplate>
                        </v:ItemList.ItemTemplate>
                    </v:ItemList>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
