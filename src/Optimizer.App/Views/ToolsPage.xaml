<UserControl x:Class="Optimizer.App.Views.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:s="clr-namespace:Optimizer.App.Services"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             xmlns:v="clr-namespace:Optimizer.App.Views"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <DataTemplate x:Key="QuickFixRow">
            <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Hint}" Margin="0,4,0,0" />
                        <ContentControl Style="{StaticResource DurationHint}" Margin="0,8,0,0" Visibility="{Binding TakesMinutes, Converter={StaticResource BoolToVisibility}}" />
                        <!-- A fix that needs a restart is marked, so it does not look as harmless as a cache flush -->
                        <Border Style="{StaticResource TagBorder}" Margin="0,6,0,0" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{l:Tr Tag_Restart}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>
                        <!-- One that restarts the whole PC at once says so before the confirmation does -->
                        <Border Style="{StaticResource TagBorder}" Margin="0,6,0,0" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                Visibility="{Binding RestartsNow, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{l:Tr Tag_RestartsNow}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>
                        <!-- The tool's report (chkdsk, reagentc) under the card that ran it -->
                        <TextBox Style="{StaticResource OutputBox}" AutomationProperties.Name="{Binding Title}" Text="{Binding Output, Mode=OneWay}" Visibility="{Binding Output, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <!-- Named after its card: every row's button says "Run" or "Restart", which tells a screen reader nothing -->
                <ui:Button Content="{Binding ActionText}" CommandParameter="{Binding}" MinWidth="96" AutomationProperties.Name="{Binding Title}"
                           Command="{Binding DataContext.Tools.RunQuickFixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           IsEnabled="{Binding DataContext.Tools.IsWorking, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}" />
            </ui:CardControl>
        </DataTemplate>
    </UserControl.Resources>
    <!-- Three separate tools, one tab each, instead of one long page (the storage analysis has its own page) -->
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Tools_Title}" />
            <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Tools_Hint}" />
        </StackPanel>
        <TabControl Grid.Row="1" ItemContainerStyle="{StaticResource SelectorTab}" SelectedIndex="{Binding ToolsTab}">
            <TabItem Header="{l:Tr Quick_TabFixes}">
                <ScrollViewer Style="{StaticResource EdgeTabScroll}">
                    <StackPanel Style="{StaticResource EdgeContent}">
                        <!-- Quick fixes in three groups; the last one repairs Windows (system files, updates, drive) -->
                        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Quick_GroupNetwork}" Margin="0,0,0,8" />
                        <v:ItemList ItemsSource="{Binding Tools.QuickNetworkRows}" ItemTemplate="{StaticResource QuickFixRow}" />

                        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Quick_GroupRestart}" />
                        <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Quick_Explorer}" />
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Quick_ExplorerHint}" Margin="0,4,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="{l:Tr Quick_ExplorerAction}" MinWidth="96" Command="{Binding Tools.RestartExplorerCommand}" IsEnabled="{Binding Tools.IsWorking, Converter={StaticResource InverseBool}}" />
                        </ui:CardControl>
                        <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Quick_IconCache}" />
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Quick_IconCacheHint}" Margin="0,4,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="{l:Tr Quick_IconCacheAction}" MinWidth="96" Command="{Binding Tools.ResetIconCacheCommand}" IsEnabled="{Binding Tools.IsWorking, Converter={StaticResource InverseBool}}" />
                        </ui:CardControl>
                        <v:ItemList ItemsSource="{Binding Tools.QuickRestartRows}" ItemTemplate="{StaticResource QuickFixRow}" />

                        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Quick_GroupRepair}" />
                        <!-- System files (sfc, DISM): commands of the Health view model -->
                        <ui:Card Padding="16,12" Margin="{StaticResource CardRowMargin}">
                            <StackPanel>
                                <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Health_SystemFiles}" />
                                <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Health_SystemFilesHint}" Margin="0,4,0,0" />
                                <!-- Microsoft: SFC and DISM RestoreHealth "may take several minutes", ScanHealth "will take several minutes"
                                     (learn.microsoft.com/troubleshoot/windows-server/installing-updates-features-roles/fix-windows-update-errors,
                                     learn.microsoft.com/windows-hardware/manufacture/desktop/repair-a-windows-image), and both wait
                                     while Windows installs updates (in PCO-Test ScanHealth waited over 25 minutes for TiWorker) -->
                                <ContentControl Style="{StaticResource DurationHint}" Content="{l:Tr Hint_TakesMinutesServicing}" Margin="0,8,0,0" />
                                <WrapPanel Margin="0,8,0,0">
                                    <ui:Button Content="{l:Tr Health_Sfc}" Command="{Binding Health.SfcCommand}" IsEnabled="{Binding Health.IsToolRunning, Converter={StaticResource InverseBool}}" Margin="0,0,8,0" />
                                    <ui:Button Content="{l:Tr Health_DismScan}" Command="{Binding Health.DismScanCommand}" IsEnabled="{Binding Health.IsToolRunning, Converter={StaticResource InverseBool}}" Margin="0,0,8,0" />
                                    <ui:Button Content="{l:Tr Health_DismRestore}" Command="{Binding Health.DismRestoreCommand}" IsEnabled="{Binding Health.IsToolRunning, Converter={StaticResource InverseBool}}" Margin="0,0,8,0" />
                                    <ui:Button Content="{l:Tr Common_Stop}" Command="{Binding Health.StopToolCommand}" Visibility="{Binding Health.IsToolRunning, Converter={StaticResource BoolToVisibility}}" />
                                </WrapPanel>
                                <TextBox Style="{StaticResource OutputBox}" AutomationProperties.Name="{l:Tr Health_SystemFiles}" Text="{Binding Health.ToolOutput, Mode=OneWay}" Visibility="{Binding Health.ToolOutput, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </ui:Card>
                        <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Repair_Title}" />
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Repair_Hint}" Margin="0,4,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="{l:Tr Repair_Run}" MinWidth="96" Command="{Binding Tools.RepairUpdateCommand}"
                                       IsEnabled="{Binding Tools.IsWorking, Converter={StaticResource InverseBool}}" />
                        </ui:CardControl>
                        <v:ItemList ItemsSource="{Binding Tools.RepairSteps}" Margin="0,4,0,8" Visibility="{Binding Tools.RepairSteps.Count, Converter={StaticResource CountToVisibility}}">
                            <v:ItemList.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <Grid Width="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="CheckmarkCircle16" Filled="True" FontSize="16" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                           Visibility="{Binding Ok, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:SymbolIcon Symbol="DismissCircle16" Filled="True" FontSize="16" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                           Visibility="{Binding Ok, Converter={StaticResource InverseBoolToVisibility}}" />
                                        </Grid>
                                        <ui:TextBlock FontTypography="Body" Text="{Binding Text}" />
                                        <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Detail}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </v:ItemList.ItemTemplate>
                        </v:ItemList>
                        <v:ItemList ItemsSource="{Binding Tools.QuickRepairRows}" ItemTemplate="{StaticResource QuickFixRow}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{l:Tr Feat_Title}">
                <ScrollViewer Style="{StaticResource EdgeTabScroll}">
                    <StackPanel Style="{StaticResource EdgeContent}">
                        <!-- Optional features -->
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Feat_Hint}" />
                        <!-- DISM installs or removes the feature; a capability is downloaded from Windows Update first -->
                        <ContentControl Style="{StaticResource DurationHint}" Content="{l:Tr Hint_TakesMinutesServicing}" Margin="0,8,0,8" />
                        <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="{Binding Tools.IsLoading, Converter={StaticResource BoolToVisibility}}" />
                        <ui:InfoBar Title="" Message="{Binding Tools.FeaturesNote}" Severity="Informational" IsClosable="False" Margin="0,0,0,8"
                                    IsOpen="{Binding Tools.FeaturesNote, Converter={StaticResource NullToBool}}" />
                        <v:ItemList ItemsSource="{Binding Tools.Features}">
                            <v:ItemList.ItemTemplate>
                                <DataTemplate>
                                    <ui:CardControl Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" />
                                                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Text}" Margin="0,4,0,0" />
                                                <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding Note}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                              Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:ToggleSwitch AutomationProperties.Name="{Binding Title}" IsChecked="{Binding SwitchState, Mode=TwoWay}" OnContent="{l:Tr Feature_On}" OffContent="{l:Tr Feature_Off}">
                                            <ui:ToggleSwitch.IsEnabled>
                                                <MultiBinding Converter="{StaticResource AllTrue}">
                                                    <Binding Path="CanToggle" />
                                                    <Binding Path="CanChange" Source="{x:Static s:ChangeGate.Instance}" />
                                                </MultiBinding>
                                            </ui:ToggleSwitch.IsEnabled>
                                        </ui:ToggleSwitch>
                                    </ui:CardControl>
                                </DataTemplate>
                            </v:ItemList.ItemTemplate>
                        </v:ItemList>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{l:Tr Prio_Title}">
                <ScrollViewer Style="{StaticResource EdgeTabScroll}">
                    <StackPanel Style="{StaticResource EdgeContent}">
                        <!-- Start priorities (Image File Execution Options) -->
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Prio_Hint}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <!-- The risk in its own bar, not as the last clause of the caption: the values are undocumented and anti-cheat checks them -->
                        <ui:InfoBar Title="" Message="{l:Tr Prio_Warning}" Severity="Warning" IsClosable="False" IsOpen="True" Margin="0,0,0,8" />
                        <!-- One field per line in a fixed order, so the layout is the same in every language -->
                        <ui:Card Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                            <StackPanel>
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Content="{l:Tr Prio_Browse}" Icon="{ui:SymbolIcon FolderOpen20}" Command="{Binding Tools.BrowsePriorityExeCommand}" Margin="8,0,0,0" />
                                    <ui:TextBox PlaceholderText="{l:Tr Prio_ExePlaceholder}" Text="{Binding Tools.NewPriorityExe, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr Prio_ExePlaceholder}" />
                                </DockPanel>
                                <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Prio_Priority}" Margin="0,12,0,4" />
                                <ComboBox ItemsSource="{Binding Tools.PriorityChoices}" SelectedItem="{Binding Tools.NewPriority}" DisplayMemberPath="Text" MinWidth="200" HorizontalAlignment="Left"
                                          AutomationProperties.Name="{l:Tr Prio_Priority}" />
                                <WrapPanel Margin="0,12,0,0">
                                    <CheckBox Content="{l:Tr Prio_LowIoOption}" IsChecked="{Binding Tools.NewPriorityLowIo}" Margin="0,0,24,0" />
                                    <CheckBox Content="{l:Tr Prio_LowMemoryOption}" IsChecked="{Binding Tools.NewPriorityLowMemory}" ToolTip="{l:Tr Prio_LowMemoryHint}" />
                                </WrapPanel>
                                <ui:TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding Tools.PriorityNote}" Margin="0,12,0,0"
                                              Visibility="{Binding Tools.PriorityNote, Converter={StaticResource NullToVisibility}}" />
                                <ui:Button Content="{l:Tr Prio_Add}" Icon="{ui:SymbolIcon Add20}" Appearance="Primary" Command="{Binding Tools.AddPriorityRuleCommand}" HorizontalAlignment="Right" Margin="0,12,0,0" />
                            </StackPanel>
                        </ui:Card>
                        <!-- No rules yet: said in words, so an empty area does not look like a list that failed to load -->
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Prio_None}" Margin="0,8,0,0"
                                      Visibility="{Binding Tools.NoPriorityRules, Converter={StaticResource BoolToVisibility}}" />
                        <v:ItemList ItemsSource="{Binding Tools.PriorityRules}">
                            <v:ItemList.ItemTemplate>
                                <DataTemplate>
                                    <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Exe}" />
                                                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Details}" Margin="0,4,0,0" />
                                                <v:ItemList ItemsSource="{Binding Badges}" ItemTemplate="{StaticResource BadgeTag}" Focusable="False" Margin="0,4,0,0">
                                                    <v:ItemList.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </v:ItemList.ItemsPanel>
                                                </v:ItemList>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:Button Content="{l:Tr Prio_Remove}" Icon="{ui:SymbolIcon Delete20}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding RemoveLabel}"
                                                   Command="{Binding DataContext.Tools.RemovePriorityRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    </ui:CardControl>
                                </DataTemplate>
                            </v:ItemList.ItemTemplate>
                        </v:ItemList>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
