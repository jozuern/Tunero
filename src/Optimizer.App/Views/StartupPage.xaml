<UserControl x:Class="Optimizer.App.Views.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:s="clr-namespace:Optimizer.App.Services"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             xmlns:v="clr-namespace:Optimizer.App.Views"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <ui:Button DockPanel.Dock="Right" Content="{l:Tr Common_Refresh}" Icon="{ui:SymbolIcon ArrowClockwise20}" Command="{Binding Startup.ReloadCommand}" ToolTip="F5" VerticalAlignment="Top" />
            <StackPanel>
                <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Startup_Title}" />
                <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Startup_Hint}" />
            </StackPanel>
        </DockPanel>

        <!-- The selector bar of the other pages with tabs, headers only: every tab shows the card and the list below,
             filtered to its entries. Each header counts what it shows under the search and filters. -->
        <TabControl Grid.Row="1" ItemsSource="{Binding Startup.Tabs}" SelectedIndex="{Binding Startup.SelectedTab}" ItemContainerStyle="{StaticResource SelectorTab}"
                    Margin="0,0,0,8" AutomationProperties.Name="{l:Tr Startup_Groups}">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <TabPanel IsItemsHost="True" Background="Transparent" />
                </ControlTemplate>
            </TabControl.Template>
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Header}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>

        <!-- One card above the list, laid out like the Tweaks page: what to look for (search, and on Advanced the kind), the
             filters, then below a line the counts on the left and the actions on the right. -->
        <ui:Card Grid.Row="2" Padding="16,12" Margin="0,0,0,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox PlaceholderText="{l:Tr Startup_Search}" AutomationProperties.Name="{l:Tr Startup_Search}" Icon="{ui:SymbolIcon Search20}" Text="{Binding Startup.Search, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                ClearButtonEnabled="True" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Startup.AdvancedKinds}" SelectedItem="{Binding Startup.SelectedAdvancedKind}" DisplayMemberPath="Text" MinWidth="220"
                              Margin="16,0,0,0" AutomationProperties.Name="{l:Tr Startup_KindFilter}"
                              Visibility="{Binding Startup.IsAdvancedTab, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <WrapPanel Margin="0,8,0,0">
                    <ui:ToggleSwitch Content="{l:Tr Startup_HideMicrosoft}" IsChecked="{Binding Startup.HideMicrosoft}" Margin="0,4,24,4" />
                    <ui:ToggleSwitch Content="{l:Tr Startup_OnlyAttention}" IsChecked="{Binding Startup.OnlyAttention}" Margin="0,4,24,4" />
                    <ui:ToggleSwitch Content="{l:Tr Startup_OnlyNew}" IsChecked="{Binding Startup.OnlyNew}" Margin="0,4,24,4"
                                     Visibility="{Binding Startup.HasComparison, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
                <Border Style="{StaticResource Divider}" />
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                        <!-- With a key: the check (its tooltip says what is sent). Without one: the way to Settings below, not a button that fails. -->
                        <ui:Button Content="{l:Tr Vt_Check}" Icon="{ui:SymbolIcon ShieldCheckmark24}" Command="{Binding Startup.CheckVirusTotalCommand}"
                                   IsEnabled="{Binding Startup.IsCheckingVirusTotal, Converter={StaticResource InverseBool}}" Margin="0,0,8,0" ToolTip="{l:Tr Vt_Hint}"
                                   Visibility="{Binding VirusTotalConfigured, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="{l:Tr Common_Stop}" Command="{Binding Startup.StopVirusTotalCommand}"
                                   Visibility="{Binding Startup.IsCheckingVirusTotal, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0" />
                        <ui:Button Content="{l:Tr Startup_SaveSnapshot}" Icon="{ui:SymbolIcon Save20}" Command="{Binding Startup.SaveSnapshotCommand}" Margin="0,0,4,0" Appearance="Transparent" />
                        <ui:Button Content="{l:Tr Startup_CompareSnapshot}" Icon="{ui:SymbolIcon BranchCompare20}" Command="{Binding Startup.CompareSnapshotCommand}" Margin="0,0,4,0" Appearance="Transparent" />
                        <ui:Button Content="{l:Tr Startup_Export}" Icon="{ui:SymbolIcon ArrowExportUp20}" Command="{Binding Startup.ExportListCommand}" Appearance="Transparent"
                                   ToolTip="{l:Tr Startup_ExportHint}" />
                    </WrapPanel>
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="Body" Text="{Binding Startup.SummaryText}" TextWrapping="Wrap" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Startup.SnapshotText}" Margin="0,4,0,0"
                                      Visibility="{Binding Startup.SnapshotText, Converter={StaticResource NullToVisibility}}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Startup.VirusTotalStatus}" Margin="0,4,0,0"
                                      Visibility="{Binding Startup.VirusTotalStatus, Converter={StaticResource NullToVisibility}}" />
                        <!-- The free key allows 4 lookups a minute: a long list takes minutes -->
                        <ContentControl Style="{StaticResource DurationHint}" Margin="0,4,0,0"
                                        Visibility="{Binding Startup.VirusTotalTakesMinutes, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>
                <!-- Below, across the card: a link does not wrap, so next to the buttons a narrow window cut it off -->
                <ui:HyperlinkButton Content="{l:Tr Vt_AddKey}" Command="{Binding OpenSettingsCommand}" Padding="0" Margin="0,4,0,0" HorizontalAlignment="Left"
                                    ToolTip="{l:Tr Vt_Hint}" Visibility="{Binding VirusTotalConfigured, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
        </ui:Card>

        <StackPanel Grid.Row="3">
            <!-- Labeled as on Install & update: the list is read, then the signatures are checked and the rows sorted again -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding Startup.IsLoading, Converter={StaticResource BoolToVisibility}}">
                <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" />
                <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Startup_Loading}" VerticalAlignment="Center" />
            </StackPanel>
            <ui:TextBlock FontTypography="Body" Text="{l:Tr List_NoMatch}" Margin="0,0,0,8"
                          Visibility="{Binding Startup.NoMatch, Converter={StaticResource BoolToVisibility}}" />
            <!-- Services and tasks also start with Windows, so they are listed here; their own page explains them -->
            <WrapPanel Margin="0,0,0,8" Visibility="{Binding Startup.ShowServicesHint, Converter={StaticResource BoolToVisibility}}">
                <ui:SymbolIcon Symbol="Info16" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <ui:TextBlock FontTypography="Body" Text="{l:Tr Startup_ServicesHint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ui:HyperlinkButton Content="{l:Tr Startup_ServicesLink}" Padding="0" VerticalAlignment="Center"
                                    Command="{Binding OpenServicesTabCommand}" CommandParameter="{Binding Startup.ServicesHintTab}" />
            </WrapPanel>
            <!-- Advanced: what these places are, and that most are only listed -->
            <DockPanel Margin="0,0,0,8" Visibility="{Binding Startup.IsAdvancedTab, Converter={StaticResource BoolToVisibility}}">
                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info16" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,2,8,0" VerticalAlignment="Top" />
                <ui:TextBlock FontTypography="Body" Text="{l:Tr Startup_AdvancedHint}" TextWrapping="Wrap" />
            </DockPanel>
        </StackPanel>

        <v:ItemList Grid.Row="4" ItemsSource="{Binding Startup.Rows}" Style="{StaticResource VirtualCardList}">
            <v:ItemList.ItemTemplate>
                <DataTemplate>
                    <ui:Card Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                        <DockPanel>
                            <!-- The switch, then More options: the rarer actions, with the destructive one last -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <StackPanel VerticalAlignment="Center">
                                    <ui:ToggleSwitch AutomationProperties.Name="{Binding Name}" IsChecked="{Binding SwitchState, Mode=TwoWay}"
                                                     OnContent="{l:Tr Startup_Enabled}" OffContent="{l:Tr Startup_Disabled}"
                                                     Visibility="{Binding CanToggle, Converter={StaticResource BoolToVisibility}}" >
                                        <ui:ToggleSwitch.IsEnabled>
                                            <MultiBinding Converter="{StaticResource AllTrue}">
                                                <Binding Path="CanToggle" />
                                                <Binding Path="CanChange" Source="{x:Static s:ChangeGate.Instance}" />
                                            </MultiBinding>
                                        </ui:ToggleSwitch.IsEnabled>
                                    </ui:ToggleSwitch>
                                    <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ReadOnlyNote}" MaxWidth="160" TextWrapping="Wrap"
                                                  Visibility="{Binding ReadOnlyNote, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                                <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon MoreHorizontal20}" Width="32" Height="32" Padding="0" BorderThickness="0" Margin="8,0,0,0" VerticalAlignment="Center"
                                           ToolTip="{l:Tr Startup_MoreOptions}" AutomationProperties.Name="{Binding MoreOptionsLabel}" Click="OnMoreOptions"
                                           Tag="{Binding DataContext.Startup, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <ui:Button.ContextMenu>
                                        <!-- Outside the page's tree: the commands come from the button's Tag (the page's view model) -->
                                        <ContextMenu>
                                            <MenuItem Header="{l:Tr Startup_ShowFile}" Icon="{ui:SymbolIcon FolderOpen20}" CommandParameter="{Binding}"
                                                      Command="{Binding PlacementTarget.Tag.ShowFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Visibility="{Binding Entry.ImagePath, Converter={StaticResource NullToVisibility}}" />
                                            <MenuItem Header="{l:Tr Startup_CopyLocation}" Icon="{ui:SymbolIcon Copy20}" CommandParameter="{Binding}"
                                                      Command="{Binding PlacementTarget.Tag.CopyLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" />
                                            <MenuItem Header="{l:Tr Startup_Delete}" Icon="{ui:SymbolIcon Delete20}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding DeleteLabel}"
                                                      ToolTip="{l:Tr Startup_DeleteHint}" Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"
                                                      IsEnabled="{Binding CanChange, Source={x:Static s:ChangeGate.Instance}}"
                                                      Command="{Binding PlacementTarget.Tag.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </ui:Button.ContextMenu>
                                </ui:Button>
                            </StackPanel>
                            <StackPanel>
                                <!-- As on the Tweaks page: the warning in front of the name, no icon column that is empty on most rows -->
                                <DockPanel>
                                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Warning16" Filled="True" FontSize="16" Margin="0,2,8,0" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextWrapping="Wrap" />
                                </DockPanel>
                                <!-- Why it needs attention, in the caution color: not signed, runs a script, unusual place -->
                                <v:ItemList ItemsSource="{Binding AttentionTags}" Focusable="False" Margin="0,2,0,0"
                                              Visibility="{Binding AttentionTags.Count, Converter={StaticResource CountToVisibility}}">
                                    <v:ItemList.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </v:ItemList.ItemsPanel>
                                    <v:ItemList.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TagBorder}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </v:ItemList.ItemTemplate>
                                </v:ItemList>
                                <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{l:Tr Startup_New}" Margin="0,2,0,0"
                                              Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}" />
                                <!-- Publisher and signature; the kind in plain words in the simple view, by its technical name in the other -->
                                <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding SimpleMetaText}"
                                              Visibility="{Binding DataContext.ShowTechnical, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding MetaText}"
                                              Visibility="{Binding DataContext.ShowTechnical, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Style="{StaticResource Mono}" Text="{Binding Command}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Command}" Visibility="{Binding DataContext.ShowTechnical, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding ScriptHostNote}" TextWrapping="Wrap"
                                              Margin="0,4,0,0" Visibility="{Binding ScriptHostNote, Converter={StaticResource NullToVisibility}}" />
                                <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Location}" TextWrapping="Wrap" Margin="0,4,0,0"
                                              Visibility="{Binding DataContext.ShowTechnical, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                <ui:HyperlinkButton Content="{Binding VirusTotalText}" Padding="0" Margin="0,4,0,0"
                                                    Visibility="{Binding VirusTotalText, Converter={StaticResource NullToVisibility}}"
                                                    Command="{Binding DataContext.Startup.OpenReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding VirusTotalUrl}" />
                            </StackPanel>
                        </DockPanel>
                    </ui:Card>
                </DataTemplate>
            </v:ItemList.ItemTemplate>
        </v:ItemList>
    </Grid>
</UserControl>
