<Application x:Class="Optimizer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:s="clr-namespace:Optimizer.App.Services"
             xmlns:v="clr-namespace:Optimizer.App.Views"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Windows 11 Fluent theme (WPF-UI): light/dark brushes, controls, system accent. -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <v:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <v:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <v:BoolToVisibilityConverter x:Key="BoolToHidden" Off="Hidden" />
            <v:NullToVisibilityConverter x:Key="NullToVisibility" />
            <v:NullToVisibilityConverter x:Key="VisibleWhenNull" Invert="True" />
            <v:InverseBoolConverter x:Key="InverseBool" />
            <v:StatusToSymbolConverter x:Key="StatusToSymbol" />
            <v:CountToVisibilityConverter x:Key="CountToVisibility" />
            <v:NullToBoolConverter x:Key="NullToBool" />
            <v:AllTrueConverter x:Key="AllTrue" />
            <v:CountToVisibilityConverter x:Key="EmptyToVisibility" Invert="True" />
            <v:PageWidthConverter x:Key="PageWidth" />
            <v:EdgeMarginConverter x:Key="EdgeMargin" />
            <v:SameItemConverter x:Key="SameItem" />

            <!-- Navigation badges as in Windows 11: a 16 px circle for one digit, a pill for more. WPF-UI's template lets the
                 line height of the number stretch it to an upright oval. -->
            <Style TargetType="{x:Type ui:InfoBadge}" BasedOn="{StaticResource {x:Type ui:InfoBadge}}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:InfoBadge}">
                            <Border x:Name="ContentBorder" Height="16" MinWidth="16" Padding="4,0" CornerRadius="8" Margin="2"
                                    Background="{TemplateBinding Background}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Value}" FontSize="11" LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                           Foreground="{DynamicResource InfoBadgeValueForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Severity" Value="Attention">
                                    <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource InfoBadgeAttentionSeverityBackgroundBrush}" />
                                </Trigger>
                                <Trigger Property="Severity" Value="Caution">
                                    <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource InfoBadgeCautionSeverityBackgroundBrush}" />
                                </Trigger>
                                <Trigger Property="Severity" Value="Critical">
                                    <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource InfoBadgeCriticalSeverityBackgroundBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <v:AtLeastConverter x:Key="AtLeast" />
            <v:WidthBelowConverter x:Key="WidthBelow" />

            <!--
                Fluent rules for every page: Segoe UI Variable type ramp (ui:TextBlock FontTypography), spacing only
                4/8/12/16/24, cards with 4 px between rows, theme brushes and the Windows accent only.
            -->
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

            <Thickness x:Key="PagePadding">24,16,24,24</Thickness>
            <!-- The root of every page: padding, and a maximum width as in Windows Settings, so lines stay readable on wide
                 windows (about 1000 px of content, left-aligned). -->
            <Style x:Key="PageRoot" TargetType="FrameworkElement">
                <Setter Property="Margin" Value="{StaticResource PagePadding}" />
                <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource PageWidth}}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Thickness x:Key="CardRowMargin">0,0,0,4</Thickness>
            <Thickness x:Key="CardPadding">16,12,16,12</Thickness>
            <!-- The rating mark's column in a row: one width on every row, so the marks of a list stand under each other -->
            <Style x:Key="RowRating" TargetType="v:RatingMark">
                <Setter Property="Width" Value="60" />
                <Setter Property="Margin" Value="12,0,12,0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <!-- Storage treemap: one color per file group, from the Okabe-Ito palette plus a gray for Other. Any two groups can
                 touch on the map, so all 28 pairs stay apart (CIEDE2000 at least 8.9) for normal vision, protanopia,
                 deuteranopia and tritanopia; the dark set has a lighter blue and gray for the dark card. The legend and the
                 tooltip name the group too. App.ApplyTheme sets the Treemap*Brush resources from these for the theme in use,
                 so the map follows a theme switch. -->
            <Color x:Key="TreemapVideoLight">#0072B2</Color>
            <Color x:Key="TreemapAudioLight">#D55E00</Color>
            <Color x:Key="TreemapImagesLight">#56B4E9</Color>
            <Color x:Key="TreemapArchivesLight">#E69F00</Color>
            <Color x:Key="TreemapProgramsLight">#CC79A7</Color>
            <Color x:Key="TreemapDocumentsLight">#009E73</Color>
            <Color x:Key="TreemapSystemLight">#F0E442</Color>
            <Color x:Key="TreemapOtherLight">#727272</Color>
            <Color x:Key="TreemapVideoDark">#1580C2</Color>
            <Color x:Key="TreemapAudioDark">#D55E00</Color>
            <Color x:Key="TreemapImagesDark">#56B4E9</Color>
            <Color x:Key="TreemapArchivesDark">#E69F00</Color>
            <Color x:Key="TreemapProgramsDark">#CC79A7</Color>
            <Color x:Key="TreemapDocumentsDark">#009E73</Color>
            <Color x:Key="TreemapSystemDark">#F0E442</Color>
            <Color x:Key="TreemapOtherDark">#7A7A7A</Color>
            <SolidColorBrush x:Key="TreemapVideoBrush" Color="{StaticResource TreemapVideoDark}" />
            <SolidColorBrush x:Key="TreemapAudioBrush" Color="{StaticResource TreemapAudioDark}" />
            <SolidColorBrush x:Key="TreemapImagesBrush" Color="{StaticResource TreemapImagesDark}" />
            <SolidColorBrush x:Key="TreemapArchivesBrush" Color="{StaticResource TreemapArchivesDark}" />
            <SolidColorBrush x:Key="TreemapProgramsBrush" Color="{StaticResource TreemapProgramsDark}" />
            <SolidColorBrush x:Key="TreemapDocumentsBrush" Color="{StaticResource TreemapDocumentsDark}" />
            <SolidColorBrush x:Key="TreemapSystemBrush" Color="{StaticResource TreemapSystemDark}" />
            <SolidColorBrush x:Key="TreemapOtherBrush" Color="{StaticResource TreemapOtherDark}" />

            <!-- The right-hand column of rows with a switch: wide enough for the longest label ("Nicht angewendet") -->
            <sys:Double x:Key="SwitchColumnWidth">168</sys:Double>

            <!-- A thin line between the parts of a card (filters above, counts and actions below) -->
            <Style x:Key="Divider" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="0,12" />
                <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            </Style>

            <!-- Section heading inside a page -->
            <Style x:Key="SectionHeader" TargetType="ui:TextBlock">
                <Setter Property="FontTypography" Value="BodyStrong" />
                <Setter Property="Margin" Value="0,24,0,8" />
            </Style>

            <Style x:Key="PageTitle" TargetType="ui:TextBlock">
                <Setter Property="FontTypography" Value="Title" />
            </Style>

            <Style x:Key="PageIntro" TargetType="ui:TextBlock">
                <Setter Property="FontTypography" Value="Body" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4,0,16" />
            </Style>

            <Style x:Key="Caption" TargetType="ui:TextBlock">
                <Setter Property="FontTypography" Value="Caption" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- The line a list shows when it is empty or nothing matches its search ("No changes yet", "Nothing matches"): in
                 the size of the rows it stands in for and in the secondary color, quieter than a row and not a hint caption.
                 It sits where the list's first row would sit, so its margin is the list's. Its text key or the property that
                 shows it ends in Empty, NoMatch or _None (XamlRulesTests.EmptyStatesUseTheSharedStyle). -->
            <Style x:Key="EmptyState" TargetType="ui:TextBlock">
                <Setter Property="FontTypography" Value="Body" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Switches, three kinds (XamlRulesTests.SwitchesSayWhatTheyShow):
                 - A setting in a card: its name in the card's header, the switch on the right with On or Off next to it, as in
                   Windows Settings. Style SettingSwitch.
                 - A filter over a list ("Show passed checks", "Show Windows services"): the label is the switch's Content, no
                   state text; the label says what turning it on shows.
                 - The state of a row (a tweak, a service, a startup entry): the row's own words ("Applied", "Enabled") as
                   OnContent and OffContent, in one column (TweakSwitch). -->
            <Style x:Key="SettingSwitch" TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
                <Setter Property="OnContent" Value="{s:Tr Feature_On}" />
                <Setter Property="OffContent" Value="{s:Tr Feature_Off}" />
            </Style>

            <!-- Work that can take several minutes (SFC, DISM, Windows features, Update all): a clock and a caption next to
                 the button or card that starts it and in the progress banner, one wording everywhere. Content replaces the
                 text where a measurement supports a longer time (the install media). -->
            <Style x:Key="DurationHint" TargetType="ContentControl">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Content" Value="{s:Tr Hint_TakesMinutes}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <DockPanel>
                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Clock16" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                                              Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                            </DockPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Mono" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- Output box for tools (sfc, dism, winget) -->
            <!-- Based on the WPF-UI style: without it the box keeps the classic white template in dark mode. -->
            <Style x:Key="OutputBox" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="MaxHeight" Value="240" />
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>

            <!-- Long lists (startup entries, services, tasks): virtualized, pixel scrolling, no selection -->
            <ControlTemplate x:Key="VirtualList" TargetType="ItemsControl">
                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsPresenter />
                </ScrollViewer>
            </ControlTemplate>

            <!--
                Long card lists: only the cards in view are built (virtualizing panel with its own scroll viewer, pixel
                scrolling so it moves like the rest of the app). Rebuilding a list of 75 cards then costs a few cards.
            -->
            <Style x:Key="VirtualCardList" TargetType="ItemsControl">
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
                <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template" Value="{StaticResource VirtualList}" />
                <!-- The list reaches the page's right edge: its scroll bar sits at the window edge, as on pages that scroll as a
                     whole, and the wheel works beside the cards too -->
                <Setter Property="Margin" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EdgeMargin}}" />
                <!-- The panel lays every card out as wide as the widest one it ever measured, also cards realized off
                     screen that kept a width from before the details pane opened (the switches were cut off): give each
                     card exactly the page's content width. -->
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource PageWidth}}" />
                            <!-- Left, so the cards line up with the page and the room on the right stays for the scroll bar -->
                            <Setter Property="HorizontalAlignment" Value="Left" />
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>



            <!-- A page part that scrolls on its own (a tab, the Cleanup categories): out to the page's right edge like the
                 lists above, with its content as wide as the page's -->
            <Style x:Key="EdgeScroll" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Margin" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EdgeMargin}}" />
            </Style>
            <Style x:Key="EdgeContent" TargetType="StackPanel">
                <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource PageWidth}}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <!-- The same under a tab bar: 8 px from the tabs -->
            <Style x:Key="EdgeTabScroll" TargetType="ScrollViewer" BasedOn="{StaticResource EdgeScroll}">
                <Setter Property="Margin" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EdgeMargin}, ConverterParameter=8}" />
            </Style>

            <!-- Tabs drawn like the Windows 11 selector bar: the selected tab gets an accent line under its text (pages with
                 several parts: Services, Remove apps, Apps, Tools). -->
            <Style x:Key="SelectorTab" TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <!-- The hand only on the header: set on the TabItem, it reached the whole tab's content too (a tab's
                                 content routes its mouse events through the TabItem), so every text and card showed as clickable -->
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="12,6,12,4" Margin="0,0,4,0" Cursor="Hand">
                                <StackPanel>
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <Border x:Name="Pill" Height="3" Width="16" CornerRadius="1.5" Margin="0,4,0,0" HorizontalAlignment="Center"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A card that opens the details pane: an accent border marks the one the pane shows. -->
            <Style x:Key="SelectableCard" TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
                <!-- Cards are no Tab stops by default (App.xaml.cs); this one opens something -->
                <Setter Property="Focusable" Value="True" />
                <Style.Triggers>
                    <DataTrigger Value="True">
                        <DataTrigger.Binding>
                            <MultiBinding Converter="{StaticResource SameItem}">
                                <Binding />
                                <Binding Path="DataContext.SelectedItem" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Finding / advisor row: status icon, title, summary, impact line; Fix button when there is one -->
            <DataTemplate x:Key="FindingRow">
                <!-- The card opens the details: screen readers announce it by its title and state -->
                <v:ClickCard Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}" Style="{StaticResource SelectableCard}"
                                AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding MetaText}"
                                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="{Binding StatusSymbol}" Filled="True" v:ThemeBrush.Key="{Binding StatusBrushKey}" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" TextWrapping="Wrap" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Summary}" Margin="0,4,0,0" Visibility="{Binding Summary, Converter={StaticResource NullToVisibility}}" />
                            <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding MetaText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <!-- The button has a place of its own on every row, so the rating marks of a list stand in one column -->
                    <StackPanel Orientation="Horizontal">
                        <v:RatingMark Style="{StaticResource RowRating}" Value="{Binding Rating}" Disputed="{Binding IsDisputed}"
                                      ToolTip="{Binding ImpactTooltip}" AutomationProperties.Name="{Binding ImpactText}" />
                        <Grid Width="112">
                            <ui:Button Content="{Binding ActionText}" Appearance="Primary" MinWidth="88" HorizontalAlignment="Right"
                                       Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}"
                                       Command="{Binding DataContext.RunActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        </Grid>
                    </StackPanel>
                </v:ClickCard>
            </DataTemplate>

            <!-- Tweak row: switch on the right (on = confirm and apply, off = undo) -->
            <!-- Profile picker entry (Overview and Tweaks) -->
            <DataTemplate x:Key="ProfileItem">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="{Binding Icon}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>

            <!-- A tag: a short fact in a subtle frame (rows, the details pane, Tools) -->
            <Style x:Key="TagBorder" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="6,1,6,2" />
                <Setter Property="Margin" Value="0,2,4,2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            </Style>

            <!-- Badge on a tweak row: neutral facts (Preview, Restart) in a subtle tag, risks in the caution color -->
            <DataTemplate x:Key="BadgeTag">
                <Border x:Name="Tag" Style="{StaticResource TagBorder}" ToolTip="{Binding Tip}">
                    <TextBlock x:Name="TagText" Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Caution}" Value="True">
                        <Setter TargetName="Tag" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                        <Setter TargetName="TagText" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- The switch of a tweak row. A setting that was already on before this app (Windows, a policy or another
                 tool) has no original value to restore, so it could never be switched off: say so in words instead. -->
            <DataTemplate x:Key="TweakSwitch">
                <!-- One width for the column, left-aligned inside it: the switches of a list stay in one line whatever their
                     label ("Applied", "Nicht angewendet"), and "Already on" starts where they start. On a narrow page (the
                     details pane open in a small window) the switch goes without its label, as in Windows Settings: the
                     row's text keeps its room, and the details pane and screen readers still name the state. -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Width" Value="{StaticResource SwitchColumnWidth}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource WidthBelow}, ConverterParameter=760}" Value="True">
                                    <Setter Property="Width" Value="72" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <!-- "Applied" and "Not applied" next to the switch: a title like "Power Throttling off" with a switch that is
                         off would otherwise read as a double negative. -->
                    <ui:ToggleSwitch AutomationProperties.Name="{Binding Title}" IsChecked="{Binding SwitchState, Mode=TwoWay}" HorizontalAlignment="Left"
                                     Visibility="{Binding ShowSwitch, Converter={StaticResource BoolToVisibility}}">
                        <ui:ToggleSwitch.Style>
                            <Style TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
                                <Setter Property="OnContent" Value="{s:Tr Tweak_SwitchOn}" />
                                <Setter Property="OffContent" Value="{s:Tr Tweak_SwitchOff}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource WidthBelow}, ConverterParameter=760}" Value="True">
                                        <Setter Property="OnContent" Value="{x:Null}" />
                                        <Setter Property="OffContent" Value="{x:Null}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:ToggleSwitch.Style>
                        <ui:ToggleSwitch.IsEnabled>
                            <MultiBinding Converter="{StaticResource AllTrue}">
                                <Binding Path="CanToggle" />
                                <Binding Path="CanChange" Source="{x:Static s:ChangeGate.Instance}" />
                            </MultiBinding>
                        </ui:ToggleSwitch.IsEnabled>
                    </ui:ToggleSwitch>
                    <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{s:Tr Tweak_AlreadyOnShort}"
                                  ToolTip="{s:Tr Tweak_AlreadyOnTip}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                  Visibility="{Binding IsSetOutside, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="TweakRow">
                <v:ClickCard Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}" Style="{StaticResource SelectableCard}"
                                AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding MetaText}"
                                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <ui:CardControl.Header>
                        <!-- Select mode of the Tweaks page: a check box in front (off where the batch cannot take the row) -->
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsPicked}" IsEnabled="{Binding CanPick}" MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Top"
                                      AutomationProperties.Name="{Binding PickLabel}" ToolTip="{Binding PickNote}" ToolTipService.ShowOnDisabled="True"
                                      Visibility="{Binding ShowPick, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel>
                                <!-- The switch shows on and off; an icon in front of the title marks only rows that need attention
                                     (reset by Windows, partly applied). No icon column: an empty one looked like a missing icon. -->
                                <DockPanel>
                                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="{Binding StatusSymbol}" Filled="True" FontSize="16" Margin="0,2,8,0" VerticalAlignment="Top"
                                                   v:ThemeBrush.Key="{Binding StatusBrushKey}" Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" TextWrapping="Wrap" />
                                </DockPanel>
                                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Summary}" Margin="0,4,0,0" Visibility="{Binding Summary, Converter={StaticResource NullToVisibility}}" />
                                <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="{Binding RecommendedText}" TextWrapping="Wrap"
                                              Margin="0,4,0,0" Visibility="{Binding RecommendedText, Converter={StaticResource NullToVisibility}}" />
                                <!-- State, impact and effects, then the badges as tags; both wrap inside the card -->
                                <WrapPanel Margin="0,4,0,0">
                                    <!-- Collapsed when empty: its margin would move the tags off the title's left edge -->
                                    <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding MetaText}" TextWrapping="Wrap"
                                                  VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{Binding MetaText, Converter={StaticResource NullToVisibility}}" />
                                    <v:ItemList ItemsSource="{Binding Badges}" ItemTemplate="{StaticResource BadgeTag}" Focusable="False">
                                        <v:ItemList.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </v:ItemList.ItemsPanel>
                                    </v:ItemList>
                                </WrapPanel>
                                <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding ToggleNote}" TextWrapping="Wrap"
                                              Margin="0,4,0,0" Visibility="{Binding ToggleNote, Converter={StaticResource NullToVisibility}}" />
                                <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding AgainstNote}" TextWrapping="Wrap"
                                              Margin="0,4,0,0" Visibility="{Binding AgainstNote, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </DockPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <v:RatingMark Style="{StaticResource RowRating}" Value="{Binding Rating}" Disputed="{Binding IsDisputed}"
                                      ToolTip="{Binding ImpactTooltip}" AutomationProperties.Name="{Binding ImpactText}" />
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TweakSwitch}" />
                    </StackPanel>
                </v:ClickCard>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
