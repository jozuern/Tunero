<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Tunero</AssemblyName>
    <RootNamespace>Optimizer.App</RootNamespace>
    <!-- Program.Main secures the data folder and native library loading before WPF starts. -->
    <StartupObject>Optimizer.App.Program</StartupObject>
    <!-- DOTNET_STARTUP_HOOKS from the user's environment would run code in the elevated app before Main. -->
    <StartupHookSupport>false</StartupHookSupport>
    <Version>1.4.55</Version>
    <Product>Tunero</Product>
    <Authors>Joshua Zürn</Authors>
    <Company>Joshua Zürn</Company>
    <Copyright>Copyright (c) 2026 Joshua Zürn</Copyright>
    <!-- Product version "0.7.1" instead of "0.7.1+<commit>": the version Windows shows in the file's properties is the
         release version. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en;de</SatelliteResourceLanguages>
    <!-- Release: always elevated. Debug: asInvoker so the scanner can be run without UAC during development. -->
    <ApplicationManifest Condition="'$(Configuration)' == 'Release'">app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(Configuration)' != 'Release'">app.debug.manifest</ApplicationManifest>
    <!-- Exe, taskbar and Alt+Tab icon (16 to 256 px; sources in docs/brand) -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\icon-16.png;Assets\icon-24.png;Assets\icon-32.png" />
  </ItemGroup>

  <!-- License texts shown under Settings > About (MIT, BSD, MPL and Apache require them to ship with the exe). -->
  <ItemGroup>
    <EmbeddedResource Include="Licenses\*.txt;Licenses\licenses.json" LogicalName="Licenses.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="Licenses.Tunero.txt" />
  </ItemGroup>

  <!-- A trimmed copy of Microsoft's media catalog for the developer switch media-demo (no network). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\media-demo-products.xml" LogicalName="MediaDemo.products.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Optimizer.Core\Optimizer.Core.csproj" />
  </ItemGroup>

  <!-- View model tests set a page's data directly (internal entry points) instead of reading this PC. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Optimizer.App.Tests" />
  </ItemGroup>

  <!-- UI Automation: a plain ItemsControl (WPF-UI's navigation rail) wraps each item in a generic data item that hides
       the item's own patterns, so screen readers could not open a page. Without that wrapper, items report themselves
       (Views/NavItem.cs), as ItemList already does for the app's lists. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Controls.ItemsControlDoesNotSupportAutomation" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
